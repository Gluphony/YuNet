@using System.Data
@using Entidades
@model List<Permisos>
@{
    ViewData["Title"] = "Gestión de Permisos";

    DataTable roles = ViewBag.Roles as DataTable;
    List<Permisos> catalogo = ViewBag.TodosLosPermisos as List<Permisos>;
    int? idRolActual = ViewBag.IdRolActual as int?;

    // IDs que ya tiene el rol para marcar los switches
    var idsAsignados = Model?.Select(p => p.ID_PERMISO).ToList() ?? new List<int>();
}

<div class="container py-4">
    <h2 class="mb-4">Configuración de Accesos</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <form method="get" action="@Url.Action("Index")">
                    <label class="form-label fw-bold">Seleccionar Rol:</label>
                    <select name="idRolSeleccionado" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Seleccione --</option>
                        @if (roles != null)
                        {
                            foreach (DataRow row in roles.Rows)
                            {
                                <option value="@row["Id_Rol"]" selected="@(idRolActual == Convert.ToInt32(row["Id_Rol"]))">
                                    @row["Nombre_Rol"]
                                </option>
                            }
                        }
                    </select>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm p-4">
                @if (idRolActual > 0)
                {
                    <form method="post" action="@Url.Action("Guardar")">
                        <input type="hidden" name="idRol" value="@idRolActual" />

                        <div class="row">
                            @foreach (var p in catalogo)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex justify-content-between align-items-center border p-2 rounded bg-light">
                                        <div>
                                            <span class="fw-bold d-block">@p.DESCRIPCION</span>
                                            <small class="text-muted">@p.CLAVE_PERMISO</small>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="permisosSeleccionados"
                                                   value="@p.ID_PERMISO" @(idsAsignados.Contains(p.ID_PERMISO) ? "checked" : "")>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn btn-primary mt-3 w-100">Guardar Cambios</button>
                    </form>
                }
                else
                {
                    <p class="text-center text-muted">Seleccione un rol para ver sus permisos.</p>
                }
            </div>
        </div>
    </div>
</div>