@using System.Data
@using Entidades
@model List<Permisos>
@{
    ViewData["Title"] = "Gestión de Permisos";

    DataTable roles = ViewBag.Roles as DataTable;
    List<Permisos> catalogo = ViewBag.TodosLosPermisos as List<Permisos> ?? new List<Permisos>();
    int? idRolActual = ViewBag.IdRolActual as int?;

    // IDs que ya tiene el rol para marcar los switches
    var idsAsignados = Model?.Select(p => p.ID_PERMISO).ToList() ?? new List<int>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Configuración de Accesos</h2>
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalNuevoPermiso">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Permiso
        </button>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm p-3 border-0">
                <form method="get" action="@Url.Action("Index")">
                    <label class="form-label fw-bold">Seleccionar Rol:</label>
                    <select name="idRolSeleccionado" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Seleccione --</option>
                        @if (roles != null)
                        {
                            foreach (DataRow row in roles.Rows)
                            {
                                <option value="@row["Id_Rol"]" selected="@(idRolActual == Convert.ToInt32(row["Id_Rol"]))">
                                    @row["Nombre_Rol"]
                                </option>
                            }
                        }
                    </select>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm p-4 border-0">
                @if (idRolActual > 0)
                {
                    <form id="formPermisos" method="post" action="@Url.Action("Guardar")">
                        <input type="hidden" name="idRol" value="@idRolActual" />

                        <div class="row">
                            @foreach (var p in catalogo)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex justify-content-between align-items-center border p-2 rounded bg-light border-hover">
                                        <div>
                                            <span class="fw-bold d-block">@p.DESCRIPCION</span>
                                            <small class="text-muted">@p.CLAVE_PERMISO</small>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="permisosSeleccionados"
                                                   value="@p.ID_PERMISO" @(idsAsignados.Contains(p.ID_PERMISO) ? "checked" : "")>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <button type="button" class="btn btn-primary mt-3 w-100 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalConfirmar">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </form>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-shield-lock display-4"></i>
                        <p class="mt-2">Seleccione un rol para ver sus permisos.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Confirmar Cambios</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-0">¿Estás seguro de que deseas actualizar los accesos para este rol?</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary px-4" onclick="document.getElementById('formPermisos').submit();">Sí, Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNuevoPermiso" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("CrearPermisoBase", "RolPermisos")">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Registrar Nuevo Permiso</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Clave del Permiso (Ej: PRODUCTOS_VER)</label>
                        <input type="text" name="CLAVE_PERMISO" class="form-control" required placeholder="CLAVE_UNICA" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <input type="text" name="DESCRIPCION" class="form-control" required placeholder="Ej: Puede ver productos" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-success">Guardar Permiso</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .border-hover:hover {
        border-color: #0d6efd !important;
        background-color: #f0f7ff !important;
        transition: 0.3s ease;
    }
</style>