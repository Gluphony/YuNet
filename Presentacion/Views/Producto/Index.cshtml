@model IEnumerable<Entidades.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<style>
    :root {
        --bg-main: #13131A; /* Fondo profundo de la aplicación */
        --bg-card: #1C1C24; /* Fondo de tarjetas y tablas */
        --text-main: #FFFFFF; /* Texto principal */
        --text-muted: #8A8A98; /* Texto secundario */
        --accent-purple: #C6C3F2; /* Color de acento morado YuNet */
        --border-color: #2D2D3A; /* Color de bordes sutiles */
        --success-color: #20C997; /* Verde para éxitos/activo */
        --danger-color: #E83E8C; /* Rosa/rojo para errores/inactivo */
    }

    /* Estilos base para la vista */
    .yunet-container {
        color: var(--text-main);
        font-family: system-ui, -apple-system, sans-serif;
    }

    /* Estilos para la tabla moderna YuNet */
    .yunet-table-container {
        background-color: var(--bg-card);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    .yunet-table {
        color: var(--text-muted);
        border-collapse: collapse;
        width: 100%;
    }

        .yunet-table thead tr {
            background-color: transparent;
            border-bottom: 1px solid var(--border-color);
        }

        .yunet-table th {
            color: var(--text-main);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            padding: 1rem 1.5rem;
            text-align: left;
        }

        .yunet-table tbody tr {
            border-bottom: 1px solid var(--border-color);
            transition: background-color 0.2s;
        }

            .yunet-table tbody tr:last-child {
                border-bottom: none;
            }

            .yunet-table tbody tr:hover {
                background-color: rgba(255, 255, 255, 0.02);
            }

        .yunet-table td {
            padding: 1rem 1.5rem;
            vertical-align: middle;
        }

    /* Elementos visuales específicos */
    .product-img {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        background-color: var(--bg-main);
    }

    .product-model {
        color: var(--text-main);
        font-weight: 600;
        margin-bottom: 2px;
        display: block;
    }

    .product-desc {
        color: var(--text-muted);
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 250px;
        display: block;
    }

    /* Badges minimalistas estilo YuNet */
    .yunet-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-success {
        background-color: rgba(32, 201, 151, 0.1);
        color: var(--success-color);
    }

    .badge-danger {
        background-color: rgba(232, 62, 140, 0.1);
        color: var(--danger-color);
    }

    /* Botones de acción minimalistas */
    .action-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        padding: 6px;
        border-radius: 6px;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .action-btn:hover {
            background-color: rgba(198, 195, 242, 0.1);
            color: var(--accent-purple);
        }

    .action-btn-danger:hover {
        background-color: rgba(232, 62, 140, 0.1);
        color: var(--danger-color);
    }

    /* Botón principal Crear */
    .btn-create {
        background-color: var(--accent-purple);
        color: #13131A;
        font-weight: 700;
        border-radius: 8px;
        padding: 10px 20px;
        border: none;
        transition: opacity 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-create:hover {
            opacity: 0.9;
            color: #13131A;
        }

    /* Alertas estilo YuNet */
    .yunet-alert {
        border-radius: 8px;
        border: none;
        color: white;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        font-weight: 500;
    }
</style>

<div class="container-fluid yunet-container mt-4 px-4">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2">
        <h2 class="h3 fw-bold mb-0">Catálogo de Productos</h2>
        <a asp-action="Create" class="btn-create shadow-sm">
            <i class="bi bi-plus-lg"></i> Nuevo Producto
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="yunet-alert shadow" style="background-color: var(--success-color);">
            <span><i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]</span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(1); opacity: 0.7;"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="yunet-alert shadow" style="background-color: var(--danger-color);">
            <span><i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]</span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(1); opacity: 0.7;"></button>
        </div>
    }

    <div class="yunet-table-container shadow-lg">
        <div class="table-responsive">
            <table class="yunet-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px;">Imagen</th>
                        <th>Modelo / Nombre</th>
                        <th>Precio</th>
                        <th style="width: 100px;">Stock</th>
                        <th>Estado</th>
                        <th style="width: 120px; text-align: center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@Url.Action("VerImagen", "Producto", new { id = item.ID_PRODUCTO })"
                                         alt="Producto"
                                         class="product-img" onerror="this.src='/images/no-image.png'" />
                                </td>
                                <td>
                                    <span class="product-model">@item.MODELO</span>
                                    <span class="product-desc" title="@item.DESCRIPCION">@item.DESCRIPCION</span>
                                </td>
                                <td class="fw-bold" style="color: var(--accent-purple); font-size: 1.1rem;">
                                    $@item.PRECIO.ToString("N2")
                                </td>
                                <td class="fw-semibold">
                                    @item.EXISTENCIAS
                                </td>
                                <td>
                                    @if (item.ESTADO)
                                    {
                                        <span class="yunet-badge badge-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="yunet-badge badge-danger">Inactivo</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <a href="#" class="action-btn" title="Editar">
                                        <i class="bi bi-pencil-square" style="font-size: 1.1rem;"></i>
                                    </a>
                                    <button class="action-btn action-btn-dangerms-1" title="Desactivar" onclick="return confirm('¿Seguro que desea desactivar este producto?');">
                                        <i class="bi bi-trash3" style="font-size: 1.1rem;"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-box-seam display-6 mb-3 d-block" style="opacity: 0.3;"></i>
                                No hay productos registrados en el sistema.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>