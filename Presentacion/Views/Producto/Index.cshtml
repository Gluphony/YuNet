@model IEnumerable<Entidades.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<style>
    :root {
        --bg-main: #13131A;
        --bg-card: #1C1C24;
        --text-main: #FFFFFF;
        --text-muted: #8A8A98;
        --accent-purple: #C6C3F2;
        --border-color: #2D2D3A;
        --success-color: #20C997;
        --danger-color: #E83E8C;
    }

    .yunet-container {
        color: var(--text-main);
        font-family: system-ui, -apple-system, sans-serif;
    }

    .yunet-table-container {
        background-color: var(--bg-card);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    .yunet-table {
        color: var(--text-muted);
        border-collapse: collapse;
        width: 100%;
    }

        .yunet-table thead tr {
            background-color: transparent;
            border-bottom: 1px solid var(--border-color);
        }

        .yunet-table th {
            color: var(--text-main);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            padding: 1rem 1.5rem;
            text-align: left;
        }

        .yunet-table tbody tr {
            border-bottom: 1px solid var(--border-color);
            transition: background-color 0.2s;
        }

            .yunet-table tbody tr:hover {
                background-color: rgba(255, 255, 255, 0.02);
            }

        .yunet-table td {
            padding: 1rem 1.5rem;
            vertical-align: middle;
        }

    .product-img {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        background-color: var(--bg-main);
    }

    .product-model {
        color: var(--text-main);
        font-weight: 600;
        margin-bottom: 2px;
        display: block;
    }

    .product-desc {
        color: var(--text-muted);
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 250px;
        display: block;
    }

    .yunet-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-success {
        background-color: rgba(32, 201, 151, 0.1);
        color: var(--success-color);
    }

    .badge-danger {
        background-color: rgba(232, 62, 140, 0.1);
        color: var(--danger-color);
    }

    .action-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        padding: 6px;
        border-radius: 6px;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .action-btn:hover {
            background-color: rgba(198, 195, 242, 0.1);
            color: var(--accent-purple);
        }

    .action-btn-danger:hover {
        background-color: rgba(232, 62, 140, 0.1);
        color: var(--danger-color);
    }

    .btn-create {
        background-color: var(--accent-purple);
        color: #13131A;
        font-weight: 700;
        border-radius: 8px;
        padding: 10px 20px;
        border: none;
        transition: opacity 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-create:hover {
            opacity: 0.9;
            color: #13131A;
        }

    .yunet-alert {
        border-radius: 8px;
        border: none;
        color: white;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        font-weight: 500;
    }
</style>

<div class="container-fluid yunet-container mt-4 px-4">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2">
        <h2 class="h3 fw-bold mb-0">Catálogo de Productos</h2>
        <a asp-action="Create" class="btn-create shadow-sm">
            <i class="bi bi-plus-lg"></i> Nuevo Producto
        </a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="yunet-alert shadow" style="background-color: var(--success-color);">
            <span><i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]</span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(1); opacity: 0.7;"></button>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="yunet-alert shadow" style="background-color: var(--danger-color);">
            <span><i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]</span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(1); opacity: 0.7;"></button>
        </div>
    }

    <div class="yunet-table-container shadow-lg">
        <div class="table-responsive">
            <table class="yunet-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px;">Imagen</th>
                        <th>Modelo / Nombre</th>
                        <th>Precio</th>
                        <th style="width: 100px;">Stock</th>
                        <th>Estado</th>
                        <th style="width: 120px; text-align: center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@Url.Action("VerImagen", "Producto", new { id = item.ID_PRODUCTO })"
                                         alt="Producto"
                                         class="product-img" onerror="this.src='/images/no-image.png'" />
                                </td>
                                <td>
                                    <span class="product-model">@item.MODELO</span>
                                    <span class="product-desc" title="@item.DESCRIPCION">@item.DESCRIPCION</span>
                                </td>
                                <td class="fw-bold" style="color: var(--accent-purple); font-size: 1.1rem;">
                                    $@item.PRECIO.ToString("N2")
                                </td>
                                <td class="fw-semibold">
                                    @item.EXISTENCIAS
                                </td>
                                <td>
                                    @if (item.ESTADO)
                                    {
                                        <span class="yunet-badge badge-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="yunet-badge badge-danger">Inactivo</span>
                                    }
                                </td>
                                <td style="text-align: center;">

                                    <button type="button" class="action-btn" title="Editar"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditar"
                                            data-id="@item.ID_PRODUCTO"
                                            data-marca="@item.ID_MARCA"
                                            data-categoria="@item.ID_CATEGORIA"
                                            data-modelo="@item.MODELO"
                                            data-desc="@item.DESCRIPCION"
                                            data-caracteristicas="@item.CARACTERISTICAS"
                                            data-precio="@item.PRECIO"
                                            data-existencias="@item.EXISTENCIAS"
                                            data-estado="@(item.ESTADO ? "true" : "false")">
                                        <i class="bi bi-pencil-square" style="font-size: 1.1rem;"></i>
                                    </button>

                                    @if (item.ESTADO)
                                    {
                                        <form asp-action="Desactivar" asp-route-id="@item.ID_PRODUCTO" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que desea desactivar este producto?');">
                                            <button type="submit" class="action-btn action-btn-danger ms-1" title="Desactivar">
                                                <i class="bi bi-trash3" style="font-size: 1.1rem;"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-box-seam display-6 mb-3 d-block" style="opacity: 0.3;"></i>
                                No hay productos registrados en el sistema.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade yunet-container" id="modalEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background-color: var(--bg-card); color: var(--text-main); border: 1px solid var(--border-color);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title fw-bold">Editar Producto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
            </div>

            <form asp-action="Editar" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <input type="hidden" id="edit_IdProducto" name="ID_PRODUCTO" />

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted fw-semibold">Modelo / Nombre</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" id="edit_Modelo" name="MODELO" maxlength="100" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted fw-semibold">Nueva Imagen</label>
                            <input type="file" class="form-control bg-dark text-white border-secondary" name="archivoImagen" accept="image/*" />
                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Opcional: Deja vacío para conservar la actual.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted fw-semibold">Marca</label>
                            <select class="form-select bg-dark text-white border-secondary" id="edit_Marca" name="ID_MARCA" asp-items="ViewBag.Marcas" required>
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted fw-semibold">Categoría</label>
                            <select class="form-select bg-dark text-white border-secondary" id="edit_Categoria" name="ID_CATEGORIA" asp-items="ViewBag.Categorias" required>
                                <option value="">Seleccione...</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label text-muted fw-semibold">Precio ($)</label>
                            <input type="number" step="0.01" min="0.01" class="form-control bg-dark text-white border-secondary fw-bold text-success" id="edit_Precio" name="PRECIO" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted fw-semibold">Existencias</label>
                            <input type="number" min="0" step="1" class="form-control bg-dark text-white border-secondary" id="edit_Existencias" name="EXISTENCIAS" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted fw-semibold">Estado</label>
                            <select class="form-select bg-dark text-white border-secondary" id="edit_Estado" name="ESTADO" required>
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-muted fw-semibold">Características Breves</label>
                            <textarea class="form-control bg-dark text-white border-secondary" id="edit_Caracteristicas" name="CARACTERISTICAS" rows="2" maxlength="200" required></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-muted fw-semibold">Descripción Detallada</label>
                            <textarea class="form-control bg-dark text-white border-secondary" id="edit_Descripcion" name="DESCRIPCION" rows="3" maxlength="500"></textarea>
                            <div class="text-end mt-1">
                                <small class="text-muted" style="font-size: 0.75rem;">Máximo 500 caracteres.</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-dark" style="border-top: 1px solid var(--border-color);">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-create" style="border:none;">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEditar = document.getElementById('modalEditar');
            if (modalEditar) {
                modalEditar.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;

                    var id = button.getAttribute('data-id');
                    var estado = button.getAttribute('data-estado');

                    console.log("Editando ID: " + id);
                    console.log("Estado que llega: " + estado);

                    document.getElementById('edit_IdProducto').value = id;
                    document.getElementById('edit_Marca').value = button.getAttribute('data-marca');
                    document.getElementById('edit_Categoria').value = button.getAttribute('data-categoria');
                    document.getElementById('edit_Modelo').value = button.getAttribute('data-modelo');
                    document.getElementById('edit_Descripcion').value = button.getAttribute('data-desc');
                    document.getElementById('edit_Caracteristicas').value = button.getAttribute('data-caracteristicas');

                    // Aseguramos que el estado se marque correctamente en el select
                    if (estado) {
                        document.getElementById('edit_Estado').value = estado.toLowerCase();
                    }

                    var precioFormateado = button.getAttribute('data-precio').replace(',', '.');
                    document.getElementById('edit_Precio').value = precioFormateado;
                    document.getElementById('edit_Existencias').value = button.getAttribute('data-existencias');
                });
            }
        });
    </script>
}