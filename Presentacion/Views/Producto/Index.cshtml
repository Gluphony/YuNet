@model IEnumerable<Entidades.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<style>
    /* ADN visual YuNet */
    .stat-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
    }

    .border-left-success {
        border-left: 0.25rem solid #198754 !important;
    }

    /* Estilo para las miniaturas de productos */
    .img-thumbnail-catalog {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #eaecf4;
    }

    .stock-badge {
        font-size: 0.85rem;
        padding: 0.5em 0.8em;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark">Inventario de Productos</h3>
        <p class="text-muted mb-0">Gestión de stock, precios y modelos de YuNet</p>
    </div>

    @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
    {
        <button type="button" class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCrearProducto">
            <i class="bi bi-box-seam me-1"></i> Registrar Producto
        </button>
    }
</div>

<div class="row">
    <div class="col-12">
        <div class="card stat-card border-left-success">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-success">Lista de Artículos</h6>
                <div class="input-group input-group-sm" style="width: 250px;">
                    <input type="text" class="form-control" placeholder="Buscar modelo...">
                    <button class="btn btn-outline-secondary" type="button"><i class="bi bi-search"></i></button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Imagen</th>
                                <th>Modelo / Marca</th>
                                <th>Descripción</th>
                                <th>Precio</th>
                                <th>Existencias</th>
                                <th>Estado</th>
                                @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                                {
                                    <th class="text-center">Acciones</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@Url.Action("VerImagen", "Producto", new { id = item.ID_PRODUCTO })"
                                             alt="Producto" class="img-thumbnail-catalog shadow-sm" />
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.MODELO</div>
                                        <small class="text-muted text-uppercase">Marca ID: @item.ID_MARCA</small>
                                    </td>
                                    <td><small class="text-truncate d-inline-block" style="max-width: 200px;">@item.DESCRIPCION</small></td>
                                    <td class="fw-bold text-primary">$@item.PRECIO.ToString("N2")</td>
                                    <td>
                                        @{
                                            var stockClass = item.EXISTENCIAS <= 5 ? "bg-danger" :
                                            item.EXISTENCIAS <= 15 ? "bg-warning text-dark" : "bg-light text-dark border";
                                        }
                                        <span class="badge stock-badge @stockClass">
                                            @item.EXISTENCIAS unidades
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.ESTADO)
                                        {
                                            <span class="text-success"><i class="bi bi-check-circle-fill"></i></span>
                                        }
                                        else
                                        {
                                            <span class="text-danger"><i class="bi bi-dash-circle-fill"></i></span>
                                        }
                                    </td>

                                    @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                                    {
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a href="@Url.Action("Edit", "Producto", new { id = item.ID_PRODUCTO })" class="btn btn-sm btn-outline-primary" title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                @if (User.IsInRole("Administrador"))
                                                {
                                                    <button onclick="eliminarProducto(@item.ID_PRODUCTO)" class="btn btn-sm btn-outline-danger" title="Desactivar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCrearProducto" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form action="@Url.Action("Create", "Producto")" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="modalCrearLabel">
                        <i class="bi bi-box-seam me-2"></i>Registrar Nuevo Producto
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body bg-light">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Modelo</label>
                            <input type="text" name="Modelo" class="form-control shadow-sm" required maxlength="150" placeholder="Ej. Router TP-Link Archer">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">ID Marca</label>
                            <input type="number" name="Id_Marca" class="form-control shadow-sm" required placeholder="Ej. 1">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">ID Categoría</label>
                            <input type="number" name="Id_Categoria" class="form-control shadow-sm" required placeholder="Ej. 2">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Descripción</label>
                            <textarea name="Descripcion" class="form-control shadow-sm" rows="3" required placeholder="Breve descripción..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Características</label>
                            <textarea name="Caracteristicas" class="form-control shadow-sm" rows="3" required placeholder="Especificaciones técnicas..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Precio ($)</label>
                            <input type="number" step="0.01" name="Precio" class="form-control shadow-sm" required placeholder="0.00">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Existencias (Stock Inicial)</label>
                            <input type="number" name="Existencias" class="form-control shadow-sm" required placeholder="0">
                        </div>

                        <div class="col-12 mt-4">
                            <label class="form-label fw-bold">Imagen del Producto (Opcional)</label>
                            <input type="file" name="Imagen" class="form-control shadow-sm" accept="image/*">
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success shadow-sm"><i class="bi bi-save me-1"></i> Guardar Producto</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        function eliminarProducto(id) {
            if (confirm("¿Seguro que desea desactivar este producto?")) {
                $.post('@Url.Action("Desactivar", "Producto")', { id: id }, function (data) {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert("Error al intentar desactivar: " + data.message);
                    }
                }).fail(function() {
                    alert("Ocurrió un error al intentar comunicarse con el servidor.");
                });
            }
        }
    </script>
}