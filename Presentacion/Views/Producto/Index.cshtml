@model IEnumerable<Entidades.Producto>

@{
    ViewData["Title"] = "YuNet Store - Catálogo";
}

<style>
    /* ==========================================
                   1. VARIABLES GLOBALES (MODO CLARO)
                   ========================================== */
    :root {
        --bg-main: #F4F7FE;
        --bg-card: #FFFFFF;
        --text-main: #2B3674;
        --text-muted: #707EAE;
        --border-color: #E2E8F0;
        /* Variables Neón Oficiales */
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.05);
        --success-color: #05CD99;
        --success-glow: rgba(5, 205, 153, 0.2);
        --danger-color: #EE5D50;
        --danger-glow: rgba(238, 93, 80, 0.2);
    }

    /* ==========================================
                   1.5 VARIABLES MODO OSCURO
                   ========================================== */
    [data-bs-theme="dark"], body.dark-theme, [data-theme="dark"] {
        --bg-main: #13131A;
        --bg-card: #1C1C24;
        --text-main: #FFFFFF;
        --text-muted: #8A8A98;
        --border-color: #2D2D3A;
        /* Variables Neón Brillantes */
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.5);
        --neon-blue-tint: rgba(0, 212, 255, 0.15);
        --success-color: #20C997;
        --success-glow: rgba(32, 201, 151, 0.3);
        --danger-color: #E83E8C;
        --danger-glow: rgba(232, 62, 140, 0.3);
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-main);
    }

    /* ==========================================
                   2. BOTONES ESTILO NEÓN
                   ========================================== */
    .btn-neon {
        background: transparent;
        color: var(--neon-blue-base) !important;
        border: 1px solid var(--neon-blue-base);
        font-weight: 600;
        border-radius: 8px;
        padding: 10px 20px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
    }

        .btn-neon:hover {
            background: var(--neon-blue-base);
            color: #FFF !important;
            box-shadow: 0 0 20px var(--neon-blue-glow);
            transform: translateY(-2px);
        }

    [data-bs-theme="dark"] .btn-neon:hover {
        color: #000 !important;
    }

    /* ==========================================
                   3. TABLA CON EFECTOS NEÓN
                   ========================================== */
    .yunet-table-container {
        background-color: var(--bg-card);
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        transition: border-color 0.4s ease, box-shadow 0.4s ease, background-color 0.3s ease;
    }

    [data-bs-theme="dark"] .yunet-table-container {
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .yunet-table-container:hover {
        border-color: rgba(0, 212, 255, 0.3);
        box-shadow: 0 10px 30px rgba(0, 212, 255, 0.1);
    }

    .yunet-table {
        width: 100%;
        border-collapse: collapse;
        color: var(--text-muted);
    }

        .yunet-table thead tr {
            background-color: var(--bg-main);
            border-bottom: 1px solid var(--border-color);
        }

        .yunet-table th {
            color: var(--text-main);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1px;
            padding: 1rem 1.5rem;
        }

        .yunet-table tbody tr {
            border-bottom: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }

            .yunet-table tbody tr:hover {
                background-color: var(--neon-blue-tint);
                box-shadow: inset 3px 0 0 var(--neon-blue-base);
            }

        .yunet-table td {
            padding: 1rem 1.5rem;
            vertical-align: middle;
        }

    /* ==========================================
                   4. ELEMENTOS INTERNOS (Imágenes, Badges, Botones)
                   ========================================== */
    .product-img {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        background-color: var(--bg-main);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .yunet-table tbody tr:hover .product-img {
        border-color: var(--neon-blue-base);
        transform: scale(1.05);
    }

    .badge-status {
        padding: 0.4em 0.8em;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        background: transparent;
        border: 1px solid;
    }

    .badge-active {
        color: var(--success-color);
        border-color: var(--success-color);
        box-shadow: 0 0 10px var(--success-glow);
    }

    .badge-inactive {
        color: var(--danger-color);
        border-color: var(--danger-color);
        box-shadow: 0 0 10px var(--danger-glow);
    }

    .action-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        padding: 8px;
        border-radius: 8px;
        transition: all 0.2s;
    }

        .action-btn:hover {
            background-color: var(--neon-blue-tint);
            color: var(--neon-blue-base);
            box-shadow: 0 0 15px var(--neon-blue-glow);
        }

    /* ==========================================
                   5. INPUTS DEL MODAL (Estilo Dinámico)
                   ========================================== */
    .custom-input {
        background-color: var(--bg-main) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-main) !important;
        border-radius: 8px !important;
        padding: 10px 15px;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            border-color: var(--neon-blue-base) !important;
            box-shadow: 0 0 15px var(--neon-blue-glow) !important;
            outline: none;
        }

        .custom-input::placeholder {
            color: var(--text-muted) !important;
            opacity: 0.6;
        }

    .btn-close-dynamic {
        filter: none;
    }

    [data-bs-theme="dark"] .btn-close-dynamic {
        filter: invert(1) grayscale(100%) brightness(200%);
    }

    /* ==========================================
                   6. ESTILOS PARA LA VISTA PREVIA DE TIENDA
                   ========================================== */
    .preview-tech-card {
        background: #1C1C24; /* Forzamos el modo oscuro de la tienda */
        border: 1px solid rgba(198, 195, 242, 0.1);
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        width: 320px; /* Tamaño fijo para la previsualización */
        position: relative;
        text-align: left;
    }

    .preview-tech-img-box {
        height: 220px;
        background: radial-gradient(circle at center, rgba(255,255,255,0.05) 0%, rgba(0,0,0,0.2) 100%);
        padding: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .preview-tech-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 15px 15px rgba(0,0,0,0.4));
    }

    .preview-badge-premium {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(255, 193, 7, 0.15);
        color: #ffc107;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: bold;
        backdrop-filter: blur(5px);
        border: 1px solid rgba(255, 193, 7, 0.3);
        z-index: 10;
        white-space: nowrap;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }

    .preview-btn-tech {
        background: linear-gradient(135deg, #20C997 0%, #16a085 100%);
        color: #13131A;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        width: 100%;
        padding: 10px;
        text-transform: uppercase;
        font-size: 0.9rem;
    }
</style>

<div class="container-fluid container-xl mt-4 px-4 pb-5">

 <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1" style="color: var(--text-main);">
            <i class="bi bi-box-seam me-2" style="color: var(--neon-blue-base); text-shadow: 0 0 10px var(--neon-blue-glow);"></i>
            Gestión de Inventario
        </h2>
        <p class="mb-0 small" style="color: var(--text-muted);">Administra tu catálogo de <span style="color: var(--neon-blue-base);">YuNet Store</span></p>
    </div>

    @* Agrupamos los botones a la derecha *@
    <div class="d-flex gap-3 align-items-center">
        @* Botón Exportar a PDF (Estilo Outline para jerarquía) *@
        <a asp-action="DescargarPdf" 
           target="_blank" 
           class="btn btn-outline-info px-4 py-2 d-flex align-items-center gap-2"
           style="border-radius: 8px; font-weight: 600; border-width: 2px; transition: all 0.3s ease;">
            <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
        </a>

        @* Botón Agregar Producto (Estilo Neón Principal) *@
        <a asp-action="Create" class="btn-neon px-4 py-2 d-flex align-items-center gap-2" style="text-decoration: none;">
            <i class="bi bi-plus-lg"></i> Agregar Producto
        </a>
    </div>
</div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-dismissible fade show shadow-sm d-flex align-items-center mb-4" role="alert" style="background-color: var(--bg-card); border: 1px solid var(--success-color); color: var(--success-color); border-radius: 12px; border-left: 5px solid var(--success-color);">
            <i class="bi bi-check-circle-fill me-3 fs-5" style="text-shadow: 0 0 10px var(--success-glow);"></i>
            <div>@TempData["MensajeExito"]</div>
            <button type="button" class="btn-close btn-close-dynamic ms-auto opacity-50" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Cambia "Filtrar" por "FiltrarPorNombre" *@
    <form asp-action="FiltrarPorNombre" method="get" class="d-flex gap-2">
       @*  <div class="input-group">
            <span class="input-group-text border-0" ...>
                <i class="bi bi-search"></i>
            </span> *@
            @* El atributo 'name' debe ser "nombre" para que coincida con el parámetro del controlador *@
           @*  <input type="text" id="txtBuscar" name="nombre" value="@ViewBag.BusquedaActual"
                   class="form-control custom-input border-start-0" placeholder="Buscar marca..." ...>
        </div> *@
      @*   <button type="submit" class="btn btn-neon px-3">Buscar</button> *@
    </form>

    <div class="yunet-table-container">
        <div class="table-responsive">
            <table class="yunet-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px;">Img</th>
                        <th>Producto</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th style="width: 120px; text-align: center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@Url.Action("VerImagen", "Producto", new { id = item.ID_PRODUCTO })"
                                         class="product-img" onerror="this.src='/images/no-image.png'" alt="Imagen Producto" />
                                </td>
                                <td>
                                    <span class="d-block fw-bold" style="font-size: 0.95rem; color: var(--text-main);">@item.MODELO</span>
                                    <span class="small" style="color: var(--text-muted);">
                                        ID Marca: <span style="color: var(--neon-blue-base);">@item.ID_MARCA</span>
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold fs-5" style="color: var(--neon-blue-base); text-shadow: 0 0 8px var(--neon-blue-glow);">
                                        $@item.PRECIO.ToString("N2")
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-medium" style="color: var(--text-main);">@item.EXISTENCIAS</span> <span class="small" style="color: var(--text-muted);">uds</span>
                                </td>
                                <td>
                                    <span class="badge badge-status @(item.ESTADO ? "badge-active" : "badge-inactive")">
                                        <i class="bi @(item.ESTADO ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                                        @(item.ESTADO ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center d-flex justify-content-center gap-1">
                                    <button type="button" class="action-btn" title="Vista Previa Tienda" style="color: var(--success-color);"
                                            data-bs-toggle="modal" data-bs-target="#modalVistaPrevia"
                                            data-id="@item.ID_PRODUCTO" data-modelo="@item.MODELO"
                                            data-precio="@item.PRECIO" data-existencias="@item.EXISTENCIAS">
                                        <i class="bi bi-eye fs-5"></i>
                                    </button>

                                    <button type="button" class="action-btn" title="Editar Producto"
                                            data-bs-toggle="modal" data-bs-target="#modalEditar"
                                            data-id="@item.ID_PRODUCTO" data-marca="@item.ID_MARCA"
                                            data-categoria="@item.ID_CATEGORIA" data-modelo="@item.MODELO"
                                            data-caracteristicas="@item.CARACTERISTICAS" data-desc="@item.DESCRIPCION"
                                            data-precio="@item.PRECIO" data-existencias="@item.EXISTENCIAS"
                                            data-estado="@(item.ESTADO ? "true" : "false")">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-cpu fs-1 d-block mb-3" style="color: var(--neon-blue-base); opacity: 0.5;"></i>
                                Aún no hay productos en el ecosistema.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* MODAL CONFIGURAR PRODUCTO *@
<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; box-shadow: 0 15px 50px rgba(0,0,0,0.2);">

            <div class="modal-header px-4 py-3 relative overflow-hidden" style="border-bottom: 1px solid var(--border-color);">
                <div style="position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: linear-gradient(90deg, transparent, var(--neon-blue-base), transparent);"></div>

                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" style="color: var(--text-main);">
                    <i class="bi bi-gear" style="color: var(--neon-blue-base);"></i> Configurar Producto
                </h5>
                <button type="button" class="btn-close btn-close-dynamic opacity-50" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Editar" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <input type="hidden" id="edit_IdProducto" name="ID_PRODUCTO" />

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--neon-blue-base); letter-spacing: 1px;">Modelo</label>
                            <input type="text" class="form-control custom-input" id="edit_Modelo" name="MODELO" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--neon-blue-base); letter-spacing: 1px;">Imagen</label>
                            <input type="file" class="form-control custom-input" name="archivoImagen" accept="image/*" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Marca</label>
                            <select class="form-select custom-input" id="edit_Marca" name="ID_MARCA" asp-items="ViewBag.Marcas" required>
                                <option value="">Seleccione...</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Categoría</label>
                            <select class="form-select custom-input" id="edit_Categoria" name="ID_CATEGORIA" asp-items="ViewBag.Categorias">
                                <option value="">Seleccione...</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Precio</label>
                            <div class="input-group">
                                <span class="input-group-text border-0" style="background-color: var(--neon-blue-tint); border: 1px solid var(--border-color) !important; border-right: none !important; color: var(--neon-blue-base); border-radius: 8px 0 0 8px;">$</span>
                                <input type="number" step="0.01" class="form-control custom-input fw-bold" id="edit_Precio" name="PRECIO" style="border-radius: 0 8px 8px 0 !important; border-left: none !important; color: var(--neon-blue-base) !important;" required />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Stock</label>
                            <input type="number" class="form-control custom-input" id="edit_Existencias" name="EXISTENCIAS" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Estado</label>
                            <select class="form-select custom-input" id="edit_Estado" name="ESTADO">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Características</label>
                            <textarea class="form-control custom-input" id="edit_Caracteristicas" name="CARACTERISTICAS" rows="2"></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Descripción</label>
                            <textarea class="form-control custom-input" id="edit_Descripcion" name="DESCRIPCION" rows="3"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer px-4 py-3" style="border-top: 1px solid var(--border-color);">
                    <button type="button" class="btn fw-bold me-2" style="color: var(--text-muted);" data-bs-dismiss="modal">CANCELAR</button>
                    <button type="submit" class="btn-neon"><i class="bi bi-save"></i> GUARDAR</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* MODAL VISTA PREVIA DE TIENDA *@
<div class="modal fade" id="modalVistaPrevia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 350px;">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <div class="modal-header border-0 pb-0 justify-content-end">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1) grayscale(100%) brightness(200%);"></button>
            </div>
            <div class="modal-body d-flex justify-content-center pt-0">
                <div class="preview-tech-card shadow-lg">
                    @* Este badge lo llenaremos dinámicamente con JS (Agotado o Últimas unidades) *@
                    <span id="preview_Badge" class="preview-badge-premium" style="display: none;"></span>

                    <div class="preview-tech-img-box">
                        <img id="preview_Img" src="" alt="Producto" class="preview-tech-img" onerror="this.src='/images/no-image.png'" />
                    </div>

                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <h5 id="preview_Modelo" class="fw-bold mb-1 text-white text-truncate"></h5>
                        <small class="mb-3" style="color: #adb5bd;">Envío gratis disponible</small>

                        <div class="mt-auto d-flex flex-column gap-3">
                            <span id="preview_Precio" class="fw-bold fs-4" style="color: #20C997;"></span>

                            @* Botón dinámico controlado por JS *@
                            <button id="preview_Btn" class="btn preview-btn-tech" disabled style="opacity: 0.8; cursor: default;">
                                <i class="bi bi-cart-plus me-2"></i> Añadir al Carrito
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Script Modal Editar
            var modalEditar = document.getElementById('modalEditar');
            if (modalEditar) {
                modalEditar.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;

                    document.getElementById('edit_IdProducto').value = button.getAttribute('data-id');
                    document.getElementById('edit_Modelo').value = button.getAttribute('data-modelo');
                    document.getElementById('edit_Marca').value = button.getAttribute('data-marca');
                    document.getElementById('edit_Categoria').value = button.getAttribute('data-categoria');
                    document.getElementById('edit_Existencias').value = button.getAttribute('data-existencias');
                    document.getElementById('edit_Caracteristicas').value = button.getAttribute('data-caracteristicas');
                    document.getElementById('edit_Descripcion').value = button.getAttribute('data-desc');
                    document.getElementById('edit_Estado').value = button.getAttribute('data-estado');

                    var precioStr = button.getAttribute('data-precio');
                    if (precioStr) {
                        document.getElementById('edit_Precio').value = precioStr.replace(',', '.');
                    }
                });
            }

           // Script Modal Vista Previa Tienda
            var modalVistaPrevia = document.getElementById('modalVistaPrevia');
            if (modalVistaPrevia) {
                modalVistaPrevia.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;

                    // Extraer datos
                    var id = button.getAttribute('data-id');
                    var modelo = button.getAttribute('data-modelo');
                    var precio = parseFloat(button.getAttribute('data-precio').replace(',', '.'));
                    var existencias = parseInt(button.getAttribute('data-existencias'));

                    // Poblar la tarjeta
                    document.getElementById('preview_Modelo').textContent = modelo;
                    document.getElementById('preview_Modelo').title = modelo;

                    // Formatear el precio a moneda
                    document.getElementById('preview_Precio').textContent = "$" + precio.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});

                    // Actualizar la imagen y quitar opacidad si antes estaba agotado
                    var imgElement = document.getElementById('preview_Img');
                    imgElement.src = "/Producto/VerImagen/" + id;
                    imgElement.classList.remove('opacity-50');

                    // Referencias a los elementos dinámicos
                    var badge = document.getElementById('preview_Badge');
                    var btnPreview = document.getElementById('preview_Btn');

                    // LÓGICA ESTILO AMAZON: Agotado vs Últimas unidades vs Normal
                    if (existencias <= 0) {
                        // AGOTADO
                        badge.textContent = "¡Agotado!";
                        badge.style.display = "block";
                        badge.style.background = "rgba(220, 53, 69, 0.15)";
                        badge.style.color = "#dc3545";
                        badge.style.borderColor = "rgba(220, 53, 69, 0.3)";

                        imgElement.classList.add('opacity-50'); // Apagamos la imagen

                        btnPreview.innerHTML = '<i class="bi bi-x-circle me-2"></i> Sin Inventario';
                        btnPreview.style.background = "rgba(255, 255, 255, 0.05)";
                        btnPreview.style.color = "#6c757d";
                    }
                    else if (existencias <= 5) {
                        // ÚLTIMAS UNIDADES
                        badge.textContent = "¡Últimas " + existencias + " unidades!";
                        badge.style.display = "block";
                        badge.style.background = "rgba(255, 193, 7, 0.15)";
                        badge.style.color = "#ffc107";
                        badge.style.borderColor = "rgba(255, 193, 7, 0.3)";

                        btnPreview.innerHTML = '<i class="bi bi-cart-plus me-2"></i> Añadir al Carrito';
                        btnPreview.style.background = "linear-gradient(135deg, #20C997 0%, #16a085 100%)";
                        btnPreview.style.color = "#13131A";
                    }
                    else {
                        // NORMAL (Ocultamos el badge)
                        badge.style.display = "none";

                        btnPreview.innerHTML = '<i class="bi bi-cart-plus me-2"></i> Añadir al Carrito';
                        btnPreview.style.background = "linear-gradient(135deg, #20C997 0%, #16a085 100%)";
                        btnPreview.style.color = "#13131A";
                    }
                });
            }
        });


    </script>
}