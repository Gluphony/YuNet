@model Entidades.Producto

@{
    ViewData["Title"] = "Nuevo Producto - YuNet Store";
}

<style>
    /* ==========================================
           1. VARIABLES GLOBALES Y NEÓN
           ========================================== */
    :root {
        --bg-main: #13131A;
        --bg-card: #1C1C24;
        --text-main: #FFFFFF;
        --text-muted: #8A8A98;
        --border-color: #2D2D3A;
        /* Tema Neón */
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
        --danger-color: #E83E8C;
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-main);
        font-family: system-ui, -apple-system, sans-serif;
    }

    /* ==========================================
           2. INPUTS Y CONTROLES DEL FORMULARIO
           ========================================== */
    .custom-input {
        background-color: rgba(0, 0, 0, 0.3) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-main) !important;
        border-radius: 8px !important;
        padding: 12px 15px;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            border-color: var(--neon-blue-base) !important;
            box-shadow: 0 0 15px var(--neon-blue-glow) !important;
            outline: none;
        }

        .custom-input::placeholder {
            color: rgba(255, 255, 255, 0.2) !important;
        }

    /* Ocultar las flechas del input number para que se vea más limpio */
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* ==========================================
           3. BOTONES NEÓN
           ========================================== */
    .btn-neon {
        background: transparent;
        color: var(--neon-blue-base) !important;
        border: 1px solid var(--neon-blue-base);
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-neon:hover {
            background: var(--neon-blue-base);
            color: #000 !important;
            box-shadow: 0 0 20px var(--neon-blue-glow);
            transform: translateY(-2px);
        }

    .btn-back {
        color: var(--text-muted);
        transition: color 0.3s ease;
    }

        .btn-back:hover {
            color: var(--text-main);
            text-shadow: 0 0 8px rgba(255,255,255,0.5);
        }

    /* ==========================================
           4. TARJETA FUTURISTA
           ========================================== */
    .tech-card {
        background-color: var(--bg-card);
        border-radius: 16px;
        border: 1px solid var(--border-color);
        box-shadow: 0 15px 50px rgba(0,0,0,0.5);
        position: relative;
        overflow: hidden;
    }

        .tech-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--neon-blue-base), transparent);
        }
</style>

<div class="container-fluid container-xl mt-4 pb-5">
    <div class="row">
        <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">

            <div class="d-flex align-items-center mb-4">
                <h2 class="fw-bold mb-0 text-white d-flex align-items-center gap-2">
                    <i class="bi bi-cpu" style="color: var(--neon-blue-base); text-shadow: 0 0 10px var(--neon-blue-glow);"></i>
                    Nuevo Producto
                </h2>
                <a asp-action="Index" class="btn btn-link ms-auto text-decoration-none btn-back d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>

            <div class="tech-card p-4 p-md-5">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger d-flex align-items-center border-0 mb-4" style="background-color: rgba(232, 62, 140, 0.1); color: var(--danger-color); border-radius: 12px;">
                        <i class="bi bi-exclamation-triangle-fill me-3 fs-5" style="text-shadow: 0 0 10px rgba(232, 62, 140, 0.4);"></i>
                        <div>@ViewBag.Error</div>
                    </div>
                }

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Marca</label>
                            <select asp-for="ID_MARCA" class="form-select custom-input" asp-items="@ViewBag.Marcas" required>
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Categoría</label>
                            <select asp-for="ID_CATEGORIA" class="form-select custom-input" asp-items="@ViewBag.Categorias" required>
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--neon-blue-base); letter-spacing: 1px;">Modelo / Nombre</label>
                            <input asp-for="MODELO" class="form-control custom-input" required maxlength="100" placeholder="Ej. iPhone 15 Pro Max" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Características Breves</label>
                            <textarea asp-for="CARACTERISTICAS" class="form-control custom-input" rows="2" required maxlength="200" placeholder="Ej. Chip A17 Pro, Titanio, 256GB..."></textarea>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Descripción del Producto</label>
                            <textarea asp-for="DESCRIPCION" class="form-control custom-input" rows="4" required maxlength="500" placeholder="Redacta la descripción detallada aquí..."></textarea>
                            <div class="text-end mt-2">
                                <small style="color: var(--text-muted); font-size: 0.75rem;">Máximo 500 caracteres.</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Precio Unitario</label>
                            <div class="input-group">
                                <span class="input-group-text border-0" style="background-color: var(--neon-blue-tint); color: var(--neon-blue-base); border-radius: 8px 0 0 8px;">$</span>
                                <input asp-for="PRECIO" type="number" step="0.01" min="0.01" class="form-control custom-input fw-bold fs-5" required placeholder="0.00" style="border-radius: 0 8px 8px 0 !important; color: var(--neon-blue-base) !important; text-shadow: 0 0 8px rgba(0,212,255,0.2);" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Stock Inicial</label>
                            <div class="input-group">
                                <input asp-for="EXISTENCIAS" type="number" min="0" step="1" class="form-control custom-input text-white" required placeholder="0" style="border-radius: 8px 0 0 8px !important;" />
                                <span class="input-group-text border-0" style="background-color: rgba(0,0,0,0.3); color: var(--text-muted); border-radius: 0 8px 8px 0;">uds</span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Fotografía del Producto</label>
                            <input type="file" name="archivoImagen" class="form-control custom-input" accept="image/*" />
                        </div>
                    </div>

                    <div class="mt-5 pt-4 border-top border-secondary border-opacity-25">
                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-link text-decoration-none btn-back d-flex align-items-center">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-neon px-4 py-2 d-flex align-items-center gap-2">
                                <i class="bi bi-cloud-arrow-up-fill"></i> Publicar Producto
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>