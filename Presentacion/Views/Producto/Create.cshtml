@model Entidades.Producto

@{
    ViewData["Title"] = "Nuevo Producto - YuNet Store";
}

<style>
    /* ... (Tus estilos se mantienen igual) ... */
    :root {
        --bg-main: #F4F7FE;
        --bg-card: #FFFFFF;
        --text-main: #2B3674;
        --text-muted: #707EAE;
        --border-color: #E2E8F0;
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.05);
        --danger-color: #EE5D50;
        --danger-bg: rgba(238, 93, 80, 0.1);
        --danger-glow: rgba(238, 93, 80, 0.4);
    }

    [data-bs-theme="dark"], body.dark-theme, [data-theme="dark"] {
        --bg-main: #13131A;
        --bg-card: #1C1C24;
        --text-main: #FFFFFF;
        --text-muted: #8A8A98;
        --border-color: #2D2D3A;
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
        --danger-color: #E83E8C;
        --danger-bg: rgba(232, 62, 140, 0.1);
        --danger-glow: rgba(232, 62, 140, 0.4);
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-main);
        font-family: system-ui, -apple-system, sans-serif;
    }

    .custom-input {
        background-color: var(--bg-main) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-main) !important;
        border-radius: 8px !important;
        padding: 12px 15px;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            border-color: var(--neon-blue-base) !important;
            box-shadow: 0 0 15px var(--neon-blue-glow) !important;
            outline: none;
        }

    .btn-neon {
        background: transparent;
        color: var(--neon-blue-base) !important;
        border: 1px solid var(--neon-blue-base);
        font-weight: 600;
        border-radius: 8px;
        padding: 10px 20px;
        transition: all 0.3s ease;
    }

        .btn-neon:hover {
            background: var(--neon-blue-base);
            color: #FFF !important;
            box-shadow: 0 0 20px var(--neon-blue-glow);
            transform: translateY(-2px);
        }

    .tech-card {
        background-color: var(--bg-card);
        border-radius: 16px;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        position: relative;
        overflow: hidden;
    }

        .tech-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--neon-blue-base), transparent);
        }
</style>

<div class="container-fluid container-xl mt-4 pb-5">
    <div class="row">
        <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">

            <div class="d-flex align-items-center mb-4">
                <h2 class="fw-bold mb-0 d-flex align-items-center gap-2" style="color: var(--text-main);">
                    <i class="bi bi-cpu" style="color: var(--neon-blue-base); text-shadow: 0 0 10px var(--neon-blue-glow);"></i>
                    Nuevo Producto
                </h2>
                <a asp-action="Index" class="btn btn-link ms-auto text-decoration-none text-muted d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>

            <div class="tech-card p-4 p-md-5">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger d-flex align-items-center border-0 mb-4" style="background-color: var(--danger-bg); color: var(--danger-color); border-radius: 12px; border-left: 5px solid var(--danger-color) !important;">
                        <i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>
                        <div>@ViewBag.Error</div>
                    </div>
                }

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Marca</label>
                            <select asp-for="ID_MARCA" class="form-select custom-input" asp-items="@ViewBag.Marcas" required>
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Categoría</label>
                            <select asp-for="ID_CATEGORIA" class="form-select custom-input" asp-items="@ViewBag.Categorias" required>
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--neon-blue-base); letter-spacing: 1px;">Modelo / Nombre</label>
                            <input asp-for="MODELO" class="form-control custom-input" required maxlength="100" placeholder="Ej. iPhone 15 Pro Max" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Características Breves</label>
                            <textarea asp-for="CARACTERISTICAS" class="form-control custom-input" rows="2" required maxlength="200" placeholder="Ej. Chip A17 Pro, Titanio, 256GB..."></textarea>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Descripción del Producto</label>
                            <textarea asp-for="DESCRIPCION" class="form-control custom-input" rows="4" required maxlength="500" placeholder="Redacta la descripción detallada aquí..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Precio Unitario ($)</label>
                            <div class="input-group">
                                <span class="input-group-text border-0" style="background-color: var(--neon-blue-tint); border: 1px solid var(--border-color) !important; border-right: none !important; color: var(--neon-blue-base); border-radius: 8px 0 0 8px;">$</span>
                                <input asp-for="PRECIO" type="number" step="0.01" min="0.01" class="form-control custom-input fw-bold fs-5" required placeholder="0.00" style="border-radius: 0 8px 8px 0 !important; border-left: none !important; color: var(--neon-blue-base) !important;" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Stock Inicial</label>
                            <div class="input-group">
                                <input asp-for="EXISTENCIAS" type="number" value="0" readonly class="form-control custom-input"
                                       style="border-radius: 8px 0 0 8px !important; border-right: none !important; background-color: rgba(0,0,0,0.1) !important; opacity: 0.6; cursor: not-allowed;" />
                                <span class="input-group-text border-0" style="background-color: var(--bg-main); border: 1px solid var(--border-color) !important; border-left: none !important; color: var(--text-muted); border-radius: 0 8px 8px 0;">uds</span>
                            </div>
                            <div class="form-text small" style="font-size: 0.7rem; color: var(--text-muted);">
                                <i class="bi bi-info-circle"></i> El stock se carga mediante <b>Entrada de Mercadería</b>.
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Fotografía del Producto</label>
                            <input type="file" name="archivoImagen" class="form-control custom-input" accept="image/*" />
                        </div>
                    </div>

                    <div class="mt-5 pt-4" style="border-top: 1px solid var(--border-color);">
                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-link text-decoration-none text-muted">Cancelar</a>
                            <button type="submit" class="btn btn-neon px-4 py-2 d-flex align-items-center gap-2">
                                <i class="bi bi-cloud-arrow-up-fill"></i> Publicar Producto
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>