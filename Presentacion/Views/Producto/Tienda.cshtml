@model IEnumerable<Entidades.Producto>

@{
    ViewData["Title"] = "YuNet Store - Catálogo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================
           1. GRID FLUIDO (Catálogo a pantalla completa)
           ========================================== */
    .grilla-fluida {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); /* Tarjetas un poco más grandes para la tienda */
        gap: 2rem;
    }

    /* Diseño Tech/Mobile Store Premium */
    .tech-card {
        background: var(--bg-card, #1C1C24);
        border: 1px solid rgba(198, 195, 242, 0.1);
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
    }

        .tech-card:hover {
            border-color: rgba(198, 195, 242, 0.5);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
            transform: translateY(-8px);
        }

    .tech-img-box {
        height: 220px;
        background: radial-gradient(circle at center, rgba(255,255,255,0.05) 0%, rgba(0,0,0,0.2) 100%);
        padding: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tech-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 15px 15px rgba(0,0,0,0.4));
        transition: transform 0.5s ease;
    }

    .tech-card:hover .tech-img {
        transform: scale(1.12);
    }

    .badge-premium {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(198, 195, 242, 0.15);
        color: #C6C3F2;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: bold;
        backdrop-filter: blur(5px);
        border: 1px solid rgba(198, 195, 242, 0.2);
    }

    .btn-tech {
        background: linear-gradient(135deg, #20C997 0%, #16a085 100%);
        color: #13131A;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        transition: all 0.3s;
        width: 100%;
        padding: 10px;
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
    }

        .btn-tech:hover:not(:disabled) {
            box-shadow: 0 5px 15px rgba(32, 201, 151, 0.4);
            transform: scale(1.02);
        }

        .btn-tech:disabled {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-muted, #6c757d);
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

    /* Toasts */
    #toastContainer {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 9999;
    }

    .yunet-toast {
        min-width: 280px;
        background: #1C1C24;
        border-left: 4px solid #20C997;
        color: white;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.5);
        margin-top: 12px;
        transform: translateX(150%);
        transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        display: flex;
        align-items: center;
    }

        .yunet-toast.show {
            transform: translateX(0);
        }
</style>

<div class="container mt-4 pb-5">

    <div class="row mb-5">
        <div class="col-12">
            <div class="p-4 p-md-5 rounded-4 position-relative overflow-hidden" style="background: linear-gradient(45deg, #13131A, #1C1C24); border: 1px solid rgba(198, 195, 242, 0.1);">
                <div class="position-relative z-index-1">
                    <span class="badge mb-2" style="background: rgba(32, 201, 151, 0.2); color: #20C997;">Nuevos Ingresos</span>
                    <h2 class="fw-bold text-white mb-2">Descubre tu próximo <span style="color: #C6C3F2;">Smartphone</span></h2>
                    <p style="color: var(--text-muted, #adb5bd); max-width: 500px;">Explora nuestra selección de terminales premium. La mejor tecnología al alcance de tu mano con garantía total.</p>
                </div>
                <div class="position-absolute rounded-circle" style="width: 300px; height: 300px; background: radial-gradient(circle, rgba(198,195,242,0.1) 0%, transparent 70%); top: -100px; right: -50px;"></div>
                <div class="position-absolute rounded-circle" style="width: 200px; height: 200px; background: radial-gradient(circle, rgba(32,201,151,0.1) 0%, transparent 70%); bottom: -50px; right: 200px;"></div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-3 rounded-4" style="background-color: var(--bg-card, #1C1C24); border: 1px solid rgba(255,255,255,0.05);">
        <div class="mb-3 mb-md-0">
            <h5 class="fw-bold mb-0 text-white d-flex align-items-center">
                <i class="bi bi-grid-fill me-2" style="color: #C6C3F2;"></i> Catálogo de Equipos
            </h5>
        </div>
        <div class="input-group shadow-sm" style="max-width: 400px; border-radius: 10px; overflow: hidden;">
            <span class="input-group-text bg-dark border-0 text-muted"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control bg-dark border-0 text-white shadow-none" placeholder="Buscar por marca o modelo...">
        </div>
    </div>

    <div class="grilla-fluida">
        @foreach (var item in Model)
        {
            if (item.ESTADO && item.EXISTENCIAS > 0)
            {
                string modeloJs = item.MODELO.Replace("'", "\\'");
                string precioJs = item.PRECIO.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

                <div class="tech-card">
                    @if (item.EXISTENCIAS <= 5)
                    {
                        <span class="badge-premium" style="color: #ffc107; border-color: rgba(255, 193, 7, 0.3);">¡Últimas @item.EXISTENCIAS unidades!</span>
                    }

                    <div class="tech-img-box">
                        <img src="@Url.Action("VerImagen", "Producto", new { id = item.ID_PRODUCTO })"
                             alt="@item.MODELO" class="tech-img"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        <i class="bi bi-phone" style="font-size: 5rem; color: rgba(255,255,255,0.05); display: none;"></i>
                    </div>

                    <div class="card-body p-4 d-flex flex-column flex-grow-1">
                        <h5 class="fw-bold mb-1 text-white text-truncate" title="@item.MODELO">
                            @item.MODELO
                        </h5>
                        <small class="mb-3" style="color: var(--text-muted, #adb5bd);">Envío gratis disponible</small>

                        <div class="mt-auto d-flex flex-column gap-3">
                            <span class="fw-bold fs-4" style="color: #20C997;">
                                $@item.PRECIO.ToString("N2")
                            </span>

                            <button class="btn btn-tech" onclick="agregarAlCarrito(@item.ID_PRODUCTO, '@modeloJs', @precioJs)">
                                <i class="bi bi-cart-plus me-2"></i> Añadir al Carrito
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div id="toastContainer"></div>

@section Scripts {
    <script>
        function agregarAlCarrito(id, modelo, precio) {
            // Aquí puedes hacer una petición fetch (AJAX) a tu CarritoController real.
            // Por ahora, simulamos visualmente que se agregó para darle feedback al cliente.

            mostrarNotificacion(`¡<strong>${modelo}</strong> agregado a tu carrito!`);

            // Efecto visual divertido: hacer vibrar el carrito en la barra de navegación superior (si tienes el ID)
            let iconoNav = document.querySelector('.bi-cart3');
            if(iconoNav) {
                iconoNav.classList.add('bi-cart-fill');
                iconoNav.classList.remove('bi-cart3');
                iconoNav.style.color = '#20C997';
                setTimeout(() => {
                    iconoNav.classList.remove('bi-cart-fill');
                    iconoNav.classList.add('bi-cart3');
                    iconoNav.style.color = '';
                }, 1000);
            }
        }

        function mostrarNotificacion(mensaje) {
            const container = document.getElementById("toastContainer");
            const toast = document.createElement("div");
            toast.className = "yunet-toast";

            toast.innerHTML = `<i class="bi bi-check-circle-fill me-3 fs-4" style="color: #20C997;"></i> <span style="font-size: 0.95rem;">${mensaje}</span>`;

            container.appendChild(toast);

            // Pequeño delay para la animación
            setTimeout(() => toast.classList.add("show"), 10);

            // Ocultar y destruir después de 3.5 segundos
            setTimeout(() => {
                toast.classList.remove("show");
                setTimeout(() => toast.remove(), 400);
            }, 3500);
        }
    </script>
}