@model IEnumerable<Entidades.Producto>

@{
    ViewData["Title"] = "Catálogo de Equipos";
}

<style>
    /* ==========================================
           VARIABLES NEÓN (Heredadas del Home / Pedidos)
           ========================================== */
    :root {
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
        --neon-green: #00FF7F;
        --neon-red: #ff3366;
        --neon-yellow: #ffcc00;
        --neon-purple: #C6C3F2;
    }

    /* ==========================================
           GRID FLUIDO Y TARJETAS NEÓN
           ========================================== */
    .grilla-fluida {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 2rem;
    }

    /* Calcado de tu .order-card */
    .neon-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
        color: var(--text-main);
    }

        .neon-card:hover {
            border-color: var(--neon-blue-base);
            box-shadow: 0 10px 30px var(--neon-blue-glow);
            transform: translateY(-8px);
        }

    .tech-img-box {
        height: 220px;
        background-color: transparent;
        border-bottom: 1px solid var(--border-color);
        padding: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.4s;
    }

    .neon-card:hover .tech-img-box {
        background-color: var(--neon-blue-tint);
        border-bottom-color: rgba(0, 212, 255, 0.2);
    }

    .tech-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 15px 15px rgba(0,0,0,0.3));
        transition: transform 0.5s ease;
    }

    .neon-card:hover .tech-img {
        transform: scale(1.12);
    }

    /* Badges calcados de tu .status-badge */
    .neon-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        font-weight: 700;
        font-size: 0.75rem;
        padding: 0.5em 1.2em;
        border-radius: 8px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        z-index: 10;
        backdrop-filter: blur(5px);
    }

        .neon-badge.agotado {
            color: var(--neon-red);
            background-color: rgba(255, 51, 102, 0.1);
            border: 1px solid var(--neon-red);
            box-shadow: 0 0 10px rgba(255, 51, 102, 0.2);
        }

        .neon-badge.alerta {
            color: var(--neon-yellow);
            background-color: rgba(255, 204, 0, 0.1);
            border: 1px solid var(--neon-yellow);
            box-shadow: 0 0 10px rgba(255, 204, 0, 0.2);
        }

    /* Botón calcado de tu .action-btn.complete */
    .btn-neon-cart {
        background-color: var(--bg-main);
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        font-weight: 700;
        transition: all 0.3s ease;
        width: 100%;
        padding: 10px;
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
    }

        .btn-neon-cart:hover:not(:disabled) {
            color: var(--neon-green);
            border-color: var(--neon-green);
            background-color: rgba(0, 255, 127, 0.1);
            box-shadow: 0 0 15px rgba(0, 255, 127, 0.4);
            transform: scale(1.02);
        }

        .btn-neon-cart:disabled {
            background-color: transparent;
            color: var(--text-muted);
            border: 1px dashed var(--border-color);
            cursor: not-allowed;
            opacity: 0.7;
        }

    /* Buscador con estilo Neón */
    .search-neon {
        background-color: var(--bg-main);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        transition: all 0.3s;
    }

        .search-neon:focus-within {
            border-color: var(--neon-blue-base);
            box-shadow: 0 0 15px var(--neon-blue-glow);
        }

        .search-neon input {
            background-color: transparent !important;
            color: var(--text-main) !important;
            border: none;
            box-shadow: none !important;
        }

            .search-neon input::placeholder {
                color: var(--text-muted);
            }

    /* Toasts dinámicos */
    #toastContainer {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 9999;
    }
</style>

<div class="container-fluid container-xl py-4 pb-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <div class="premium-label mb-1" style="color: var(--neon-blue-base); font-size: 0.75rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;">Tienda en línea</div>
            <h2 class="h3 mb-1 fw-bold" style="color: var(--text-main);">Catálogo de Equipos</h2>
            <p class="mb-0" style="color: var(--text-muted);">Descubre nuestra selección de terminales premium. La mejor tecnología al alcance de tu mano.</p>
        </div>

        <div class="search-neon d-flex align-items-center rounded-3 px-3 py-2" style="max-width: 400px; width: 100%;">
            <i class="bi bi-search" style="color: var(--neon-blue-base);"></i>
            <input type="text" class="form-control ms-2 py-1 px-0" placeholder="Buscar por marca o modelo...">
        </div>
    </div>

    <div id="toastContainer"></div>

    <div class="grilla-fluida">
        @foreach (var item in Model)
        {
            if (item.ESTADO)
            {
                string modeloJs = item.MODELO.Replace("'", "\\'");

                <div class="neon-card">

                    @* LÓGICA DE BADGES (Usa las clases Neón) *@
                    @if (item.EXISTENCIAS <= 0)
                    {
                        <span class="neon-badge agotado">¡Agotado!</span>
                    }
                    else if (item.EXISTENCIAS <= 5)
                    {
                        <span class="neon-badge alerta">¡Últimas @item.EXISTENCIAS!</span>
                    }

                    <div class="tech-img-box">
                        <img src="@Url.Action("VerImagen", "Producto", new { id = item.ID_PRODUCTO })"
                             alt="@item.MODELO" class="tech-img @(item.EXISTENCIAS <= 0 ? "opacity-50" : "")"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        <i class="bi bi-phone" style="font-size: 5rem; color: var(--border-color); display: none;"></i>
                    </div>

                    <div class="card-body p-4 d-flex flex-column flex-grow-1">
                        <h5 class="fw-bold mb-1 text-truncate" title="@item.MODELO" style="color: var(--neon-blue-base);">
                            @item.MODELO
                        </h5>
                        <small class="mb-3" style="color: var(--text-muted);">Envío gratis disponible</small>

                        <div class="mt-auto d-flex flex-column gap-3">
                            <span class="fw-bold fs-4" style="color: var(--text-main); letter-spacing: 0.5px;">
                                C$ @item.PRECIO.ToString("N2")
                            </span>

                            @* BOTÓN DE CARRITO *@
                            @if (item.EXISTENCIAS > 0)
                            {
                                <button class="btn-neon-cart" onclick="agregarAlCarrito(@item.ID_PRODUCTO, '@modeloJs')">
                                    <i class="bi bi-cart-plus me-2"></i> Añadir al Carrito
                                </button>
                            }
                            else
                            {
                                <button class="btn-neon-cart" disabled>
                                    <i class="bi bi-x-circle me-2"></i> Sin Inventario
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        function agregarAlCarrito(idProducto, modelo) {
            let formData = new FormData();
            formData.append("idProducto", idProducto);

            fetch('/Carrito/Agregar', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) throw new Error("Error en la red");
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    // Notificación usando el estilo de alerta de tus Pedidos
                    mostrarNotificacionExito(`Producto <strong style="color: var(--neon-blue-base);">${modelo}</strong> agregado al carrito.`);

                    let iconoNav = document.querySelector('.bi-cart3');
                    if(iconoNav) {
                        iconoNav.classList.add('bi-cart-fill');
                        iconoNav.classList.remove('bi-cart3');
                        iconoNav.style.color = 'var(--neon-green)';
                        iconoNav.style.filter = 'drop-shadow(0 0 10px rgba(0, 255, 127, 0.5))';

                        setTimeout(() => {
                            iconoNav.classList.remove('bi-cart-fill');
                            iconoNav.classList.add('bi-cart3');
                            iconoNav.style.color = '';
                            iconoNav.style.filter = '';
                        }, 1000);
                    }

                    actualizarYAbrirOffcanvas();

                } else {
                    mostrarNotificacionError(data.message || 'Error al agregar al carrito.');
                }
            })
            .catch(error => {
                console.error("Error en la petición:", error);
                mostrarNotificacionError("Ocurrió un error al conectar con el servidor.");
            });
        }

        function actualizarYAbrirOffcanvas() {
            fetch('/Carrito/ObtenerResumen')
                .then(response => response.text())
                .then(html => {
                    let contenedor = document.getElementById('contenedorCarrito');
                    if(contenedor) {
                        contenedor.innerHTML = html;
                    }

                    let offcanvasElement = document.getElementById('offcanvasCarrito');
                    if(offcanvasElement) {
                        let bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvasElement) || new bootstrap.Offcanvas(offcanvasElement);
                        bsOffcanvas.show();
                    }
                })
                .catch(error => console.error("Error actualizando el offcanvas:", error));
        }

        // Calqué la misma estructura HTML de las alertas que usaste en Pedidos
        function mostrarNotificacionExito(mensaje) {
            const container = document.getElementById("toastContainer");
            const toastHtml = `
                <div class="alert shadow-lg alert-dismissible fade show mb-2" style="background-color: var(--bg-card); border: 1px solid var(--neon-green); border-left: 4px solid var(--neon-green); color: var(--text-main); box-shadow: 0 0 15px rgba(0, 255, 127, 0.2);">
                    <i class="bi bi-check-circle-fill me-2 fs-5 align-middle" style="color: var(--neon-green);"></i>
                    <span class="align-middle">${mensaje}</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>`;

            insertarYDestruirToast(container, toastHtml);
        }

        function mostrarNotificacionError(mensaje) {
            const container = document.getElementById("toastContainer");
            const toastHtml = `
                <div class="alert shadow-lg alert-dismissible fade show mb-2" style="background-color: var(--bg-card); border: 1px solid var(--neon-red); border-left: 4px solid var(--neon-red); color: var(--text-main); box-shadow: 0 0 15px rgba(255, 51, 102, 0.2);">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle" style="color: var(--neon-red);"></i>
                    <span class="align-middle">${mensaje}</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>`;

            insertarYDestruirToast(container, toastHtml);
        }

        function insertarYDestruirToast(container, html) {
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = html;
            const toast = tempDiv.firstElementChild;
            container.appendChild(toast);

            setTimeout(() => {
                if (toast.parentNode) {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 200);
                }
            }, 3500);
        }
    </script>
}