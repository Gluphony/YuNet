@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Gestión de Roles y Permisos";
}

<style>
    /* ==========================================
               1. VARIABLES GLOBALES (MODO CLARO)
               ========================================== */
    :root {
        --bg-main: #F4F7FE;
        --bg-card: #FFFFFF;
        --text-main: #2B3674;
        --text-muted: #707EAE;
        --border-color: #E2E8F0;
        /* Tema Neón y Acentos */
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.05);
        --primary-color: #4318FF;
        --primary-glow: rgba(67, 24, 255, 0.3);
        --warning-color: #FFB547;
        --danger-color: #EE5D50;
        --danger-bg: rgba(238, 93, 80, 0.1);
        --success-color: #05CD99;
        --success-bg: rgba(5, 205, 153, 0.1);
    }

    /* ==========================================
               1.5 VARIABLES MODO OSCURO
               ========================================== */
    [data-bs-theme="dark"], body.dark-theme, [data-theme="dark"] {
        --bg-main: #13131A;
        --bg-card: #1C1C24;
        --text-main: #FFFFFF;
        --text-muted: #8A8A98;
        --border-color: #2D2D3A;
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
        --primary-color: #00D4FF; /* Cambia a cyan en oscuro */
        --primary-glow: rgba(0, 212, 255, 0.3);
        --warning-color: #FFB547;
        --danger-color: #E83E8C;
        --danger-bg: rgba(232, 62, 140, 0.1);
        --success-color: #05CD99;
        --success-bg: rgba(5, 205, 153, 0.1);
    }

    /* ==========================================
               2. ESTILOS GENERALES
               ========================================== */
    body {
        background-color: var(--bg-main);
        color: var(--text-main);
    }

    .tech-card {
        background-color: var(--bg-card);
        border-radius: 16px;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        position: relative;
        overflow: hidden;
        transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    [data-bs-theme="dark"] .tech-card {
        box-shadow: 0 15px 50px rgba(0,0,0,0.5);
    }

    .tech-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--primary-color), transparent);
    }

    /* ==========================================
               3. TABLA FUTURISTA
               ========================================== */
    .table {
        color: var(--text-main);
        margin-bottom: 0;
    }

        .table th {
            background-color: transparent !important;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border-color);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            padding: 1rem;
        }

        .table td {
            background-color: transparent !important;
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
            padding: 1rem;
            color: var(--text-main);
        }

    .table-hover tbody tr:hover td {
        background-color: var(--neon-blue-tint) !important;
    }

    /* ==========================================
               4. BOTONES E INPUTS
               ========================================== */
    .btn-neon-primary {
        background: transparent;
        color: var(--primary-color) !important;
        border: 1px solid var(--primary-color);
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-neon-primary:hover {
            background: var(--primary-color);
            color: #FFF !important;
            box-shadow: 0 0 15px var(--primary-glow);
            transform: translateY(-2px);
        }

    [data-bs-theme="dark"] .btn-neon-primary:hover {
        color: #000 !important;
    }

    .custom-input {
        background-color: var(--bg-main) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-main) !important;
        border-radius: 8px !important;
        padding: 10px 15px;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 10px var(--primary-glow) !important;
            outline: none;
        }

        .custom-input[readonly] {
            opacity: 0.7;
            cursor: not-allowed;
        }

    /* ==========================================
               5. MODALES
               ========================================== */
    .modal-content {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
    }

    .modal-header {
        border-bottom: 1px solid var(--border-color);
        background-color: var(--neon-blue-tint) !important;
    }

        .modal-header.bg-primary {
            background-color: rgba(67, 24, 255, 0.1) !important;
        }

        .modal-header.bg-warning {
            background-color: rgba(255, 181, 71, 0.1) !important;
        }

    .modal-title {
        color: var(--text-main) !important;
    }

    .modal-footer {
        border-top: 1px solid var(--border-color);
        background-color: transparent !important;
    }

    .btn-close {
        filter: invert(0.5);
    }

    [data-bs-theme="dark"] .btn-close {
        filter: invert(1);
    }

    /* ==========================================
               6. BADGES Y ALERTS
               ========================================== */
    .badge-soft-success {
        background-color: var(--success-bg);
        color: var(--success-color);
        border: 1px solid rgba(5, 205, 153, 0.2);
    }

    .badge-soft-danger {
        background-color: var(--danger-bg);
        color: var(--danger-color);
        border: 1px solid rgba(238, 93, 80, 0.2);
    }

    .badge-soft-info {
        background-color: var(--neon-blue-tint);
        color: var(--neon-blue-base);
        border: 1px solid rgba(0, 212, 255, 0.2);
    }

    .alert-custom {
        border-radius: 12px;
        border: 0;
    }

    .alert-custom-success {
        background-color: var(--success-bg);
        color: var(--success-color);
        border-left: 5px solid var(--success-color);
    }

    .alert-custom-danger {
        background-color: var(--danger-bg);
        color: var(--danger-color);
        border-left: 5px solid var(--danger-color);
    }
</style>

<div class="container-fluid container-xl mt-4 pb-5">

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-custom alert-custom-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5" style="text-shadow: 0 0 10px var(--success-color);"></i>
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-custom alert-custom-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5" style="text-shadow: 0 0 10px var(--danger-color);"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="tech-card p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <h4 class="mb-0 fw-bold d-flex align-items-center gap-2" style="color: var(--text-main);">
                <i class="bi bi-shield-lock-fill" style="color: var(--primary-color); text-shadow: 0 0 10px var(--primary-glow);"></i>
                Roles del Sistema
            </h4>
            <button class="btn btn-neon-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#modalCrear">
                <i class="bi bi-plus-lg me-1"></i> Nuevo Rol
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 10%;">ID</th>
                        <th style="width: 20%;">Nombre del Rol</th>
                        <th style="width: 40%;">Descripción</th>
                        <th style="width: 15%;">Estado</th>
                        <th class="text-center" style="width: 15%;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Rows.Count > 0)
                    {
                        foreach (DataRow fila in Model.Rows)
                        {
                            <tr>
                                <td class="fw-bold" style="color: var(--text-muted);">#@fila["Id_Rol"]</td>
                                <td><span class="badge badge-soft-info px-2 py-1">@fila["Nombre_Rol"]</span></td>
                                <td style="color: var(--text-muted); font-size: 0.9rem;">@fila["Descripcion"]</td>
                                <td>
                                    @if (Convert.ToBoolean(fila["Estado"]))
                                    {
                                        <span class="badge badge-soft-success px-2 py-1"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-danger px-2 py-1"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-secondary border-0 me-1 btn-editar" style="color: var(--warning-color);"
                                            data-id="@fila["Id_Rol"]"
                                            data-nombre="@fila["Nombre_Rol"]"
                                            data-desc="@fila["Descripcion"]"
                                            data-estado="@(Convert.ToBoolean(fila["Estado"]) ? "1" : "0")"
                                            data-version="@Convert.ToBase64String((byte[])fila["VERSION_FILA"])"
                                            data-bs-toggle="modal" data-bs-target="#modalEditar" title="Editar Rol">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </button>

                                    @if (Convert.ToBoolean(fila["Estado"]))
                                    {
                                        <form action="/Rol/Desactivar" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas desactivar este rol? Esto podría afectar a los usuarios que lo tengan asignado.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idRol" value="@fila["Id_Rol"]" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary border-0" style="color: var(--danger-color);" title="Desactivar Rol">
                                                <i class="bi bi-trash-fill fs-5"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="btn btn-sm border-0 disabled" style="color: transparent;"><i class="bi bi-trash-fill fs-5"></i></span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-shield-x text-muted" style="font-size: 2rem;"></i>
                                <p class="mt-2 mb-0" style="color: var(--text-muted);">No se encontraron roles registrados.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCrear" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary">
                <h5 class="modal-title fw-bold"><i class="bi bi-shield-plus me-2" style="color: var(--primary-color);"></i>Crear Rol</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/Rol/Crear" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="selectRol" class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Nombre del Rol</label>
                        <select class="form-select custom-input" id="selectRol" name="NOMBRE_ROL" onchange="llenarDescripcion()" required>
                            <option value="" data-desc="">Seleccione un rol...</option>
                            <option value="Administrador" data-desc="Acceso total al sistema">Administrador</option>
                            <option value="Usuario" data-desc="Acceso limitado a funciones específicas">Usuario</option>
                            <option value="Auditor" data-desc="Acceso solo a funciones de auditoría y reportes">Auditor</option>
                            <option value="Vendedor" data-desc="Acceso a funciones de ventas y caja">Vendedor</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="txtDescripcion" class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Descripción</label>
                        <textarea class="form-control custom-input" id="txtDescripcion" name="DESCRIPCION" rows="3" readonly placeholder="La descripción se autocompletará aquí..."></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-link text-decoration-none" style="color: var(--text-muted);" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-neon-primary px-4"><i class="bi bi-save me-2"></i>Guardar Rol</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-warning">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2" style="color: var(--warning-color);"></i>Editar Rol</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Rol/Editar" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" id="editId" name="ID_ROL" />
                    <input type="hidden" id="editVersion" name="VersionOriginalBase64" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Nombre del Rol</label>
                        <input type="text" class="form-control custom-input" id="editNombre" name="NOMBRE_ROL" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Descripción</label>
                        <textarea class="form-control custom-input" id="editDesc" name="DESCRIPCION" rows="3" readonly></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Estado</label>
                        <select class="form-select custom-input" id="editEstado" name="EstadoHtml" required>
                            <option value="1">Activo</option>
                            <option value="0">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link text-decoration-none" style="color: var(--text-muted);" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn px-4 fw-bold" style="background-color: var(--warning-color); color: #000; border-radius: 8px;">
                        <i class="bi bi-arrow-repeat me-2"></i>Actualizar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const botonesEditar = document.querySelectorAll('.btn-editar');

            botonesEditar.forEach(boton => {
                boton.addEventListener('click', function () {
                    // Cargar valores al modal desde los atributos 'data-'
                    document.getElementById('editId').value = this.getAttribute('data-id');
                    document.getElementById('editNombre').value = this.getAttribute('data-nombre');
                    document.getElementById('editDesc').value = this.getAttribute('data-desc');
                    document.getElementById('editEstado').value = this.getAttribute('data-estado');

                    // Cargar valores de versión para manejar la concurrencia
                    document.getElementById('editVersion').value = this.getAttribute('data-version');
                });
            });
        });

        function llenarDescripcion() {
            // Obtenemos el select y el textarea por su ID
            var combo = document.getElementById("selectRol");
            var cajaDescripcion = document.getElementById("txtDescripcion");

            // Obtenemos la opción seleccionada actualmente
            var opcionSeleccionada = combo.options[combo.selectedIndex];

            // Extraemos el texto del atributo 'data-desc' y lo pasamos al textarea
            var descripcion = opcionSeleccionada.getAttribute("data-desc");
            cajaDescripcion.value = descripcion;
        }
    </script>
}