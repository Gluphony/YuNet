@model IEnumerable<Entidades.Categoria>
@{
    ViewData["Title"] = "Categorías - YuNet Store";
}

<style>
    /* ==========================================
                   1. VARIABLES GLOBALES (MODO CLARO)
                   ========================================== */
    :root {
        --bg-main: #F4F7FE;
        --bg-card: #FFFFFF;
        --text-main: #2B3674;
        --text-muted: #707EAE;
        --border-color: #E2E8F0;
        /* PALETA NEÓN OFICIAL (Basada en Home) */
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
        /* Estados (Botones de acción y alertas) */
        --success-base: #05CD99;
        --success-glow: rgba(5, 205, 153, 0.2);
        --danger-base: #EE5D50;
        --danger-glow: rgba(238, 93, 80, 0.2);
        --warning-base: #F6C000;
        --warning-glow: rgba(246, 192, 0, 0.2);
    }

    /* ==========================================
                   1.5 VARIABLES MODO OSCURO
                   ========================================== */
    [data-bs-theme="dark"], body.dark-theme, [data-theme="dark"] {
        --bg-main: #13131A;
        --bg-card: #1C1C24;
        --text-main: #FFFFFF;
        --text-muted: #8A8A98;
        --border-color: #2D2D3A;
        /* PALETA NEÓN OFICIAL (Brillo ajustado para dark) */
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.5);
        --neon-blue-tint: rgba(0, 212, 255, 0.15);
        /* Estados */
        --success-base: #20C997;
        --success-glow: rgba(32, 201, 151, 0.3);
        --danger-base: #E83E8C;
        --danger-glow: rgba(232, 62, 140, 0.3);
        --warning-base: #FFC107;
        --warning-glow: rgba(255, 193, 7, 0.3);
    }

    /* ==========================================
                   2. COMPONENTES BASE
                   ========================================== */
    .custom-input {
        background-color: var(--bg-main) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-main) !important;
        border-radius: 8px !important;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            border-color: var(--neon-blue-base) !important;
            box-shadow: 0 0 15px var(--neon-blue-glow) !important;
            outline: none;
        }

        .custom-input::placeholder {
            color: var(--text-muted) !important;
            opacity: 0.6;
        }

    .tech-card {
        background-color: var(--bg-card);
        border-radius: 16px;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        position: relative;
        overflow: hidden;
        transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    [data-bs-theme="dark"] .tech-card {
        box-shadow: 0 15px 50px rgba(0,0,0,0.5);
    }

    .tech-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--neon-blue-base), transparent);
    }

    /* ==========================================
                   3. BOTONES NEÓN Y ACCIONES
                   ========================================== */
    .btn-neon {
        background: transparent;
        color: var(--neon-blue-base) !important;
        border: 1px solid var(--neon-blue-base);
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-neon:hover {
            background: var(--neon-blue-base);
            color: #FFF !important;
            box-shadow: 0 0 20px var(--neon-blue-glow);
            transform: translateY(-2px);
        }

    [data-bs-theme="dark"] .btn-neon:hover {
        color: #000 !important;
    }

    .btn-action {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.3s ease;
        background: transparent;
    }

    .btn-edit {
        border: 1px solid var(--warning-base);
        color: var(--warning-base);
    }

        .btn-edit:hover {
            background: var(--warning-base);
            color: #000;
            box-shadow: 0 0 15px var(--warning-glow);
        }

    .btn-delete {
        border: 1px solid var(--danger-base);
        color: var(--danger-base);
    }

        .btn-delete:hover {
            background: var(--danger-base);
            color: #fff;
            box-shadow: 0 0 15px var(--danger-glow);
        }

    /* ==========================================
                   4. TABLAS Y MODALES
                   ========================================== */
    .table-tech > :not(caption) > * > * {
        background-color: transparent !important;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-main);
    }

    .table-tech tbody tr {
        transition: all 0.2s ease;
    }

        .table-tech tbody tr:hover {
            background-color: var(--neon-blue-tint) !important;
            box-shadow: inset 3px 0 0 var(--neon-blue-base);
        }

    .modal-content-tech {
        background-color: var(--bg-card);
        border: 1px solid var(--neon-blue-glow);
        border-radius: 16px;
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.2);
    }

    [data-bs-theme="dark"] .modal-content-tech {
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
    }

    .btn-close-dynamic {
        filter: none;
    }

    [data-bs-theme="dark"] .btn-close-dynamic {
        filter: invert(1) grayscale(100%) brightness(200%);
    }
</style>

<div class="container-fluid container-xl mt-4 pb-5">

    @* --- ALERTAS --- *@
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert" style="background-color: rgba(5, 205, 153, 0.1); color: var(--success-base); border: 1px solid var(--success-base); border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-3 fs-5" style="text-shadow: 0 0 10px var(--success-glow);"></i>
            <div>@TempData["MensajeExito"]</div>
            <button type="button" class="btn-close btn-close-dynamic" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert" style="background-color: rgba(238, 93, 80, 0.1); color: var(--danger-base); border: 1px solid var(--danger-base); border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill me-3 fs-5" style="text-shadow: 0 0 10px var(--danger-glow);"></i>
            <div>@TempData["MensajeError"]</div>
            <button type="button" class="btn-close btn-close-dynamic" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* --- ENCABEZADO --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 d-flex align-items-center gap-2 fw-bold" style="color: var(--text-main);">
                <i class="bi bi-diagram-3" style="color: var(--neon-blue-base); text-shadow: 0 0 10px var(--neon-blue-glow);"></i>
                Categorías
            </h2>
            <p class="mb-0 mt-1" style="color: var(--text-muted); font-size: 0.9rem;">Gestiona la clasificación de tus productos</p>
        </div>

        @* Agrupamos los botones para que se mantengan juntos a la derecha *@
        <div class="d-flex gap-3">
            @* Botón Exportar *@
            <a href="@Url.Action("DescargarPdf", "Categoria")"
               target="_blank"
               id="linkPdf"
               class="btn btn-outline-info px-4 py-2 d-flex align-items-center gap-2"
               style="border-radius: 8px; font-weight: 600; transition: all 0.3s ease;">
                <i class="bi bi-file-earmark-pdf"></i> Exportar a PDF
            </a>

            @* Botón Nueva Categoría *@
            <button type="button" class="btn btn-neon px-4 py-2 d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalNuevaCategoria">
                <i class="bi bi-plus-lg"></i> Nueva Categoría
            </button>
        </div>
    </div>

    @* --- TARJETA PRINCIPAL --- *@
    <div class="tech-card mb-4">
        <div class="card-body p-4 p-md-5">

            @* Filtros *@
            <div class="row mb-4 align-items-center">
                <div class="col-md-6 col-lg-5">
                    <form asp-controller="Categoria" asp-action="Filtrar" method="get" class="d-flex gap-2">
                        <div class="input-group">
                            <span class="input-group-text border-0" style="background-color: var(--bg-main); color: var(--text-muted); border-radius: 8px 0 0 8px; border-top: 1px solid var(--border-color) !important; border-bottom: 1px solid var(--border-color) !important; border-left: 1px solid var(--border-color) !important;">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   name="nombre"
                                   id="txtBuscar"
                                   class="form-control custom-input border-start-0"
                                   placeholder="Buscar categoría..."
                                   value="@Context.Request.Query["nombre"]"
                                   style="border-radius: 0 8px 8px 0 !important; padding-left: 0;">
                        </div>
                        <button type="submit" class="btn btn-neon px-3">Buscar</button>
                    </form>
                </div>

                @* Botón Recargar: Limpia el filtro volviendo al Index *@
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary border-0 d-flex align-items-center justify-content-center"
                       style="background-color: var(--bg-main); color: var(--text-main); width: 42px; height: 42px; border-radius: 8px;"
                       title="Recargar lista completa">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </div>

            @* Tabla *@
            <div class="table-responsive">
                <table class="table table-tech align-middle mb-0">
                    <thead style="border-bottom: 2px solid var(--neon-blue-glow);">
                        <tr>
                            <th scope="col" class="pb-3 text-uppercase" style="font-size: 0.75rem; color: var(--neon-blue-base); letter-spacing: 1px;">ID</th>
                            <th scope="col" class="pb-3 text-uppercase" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 1px;">Nombre de Categoría</th>
                            <th scope="col" class="pb-3 text-uppercase" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 1px;">Estado</th>
                            <th scope="col" class="pb-3 text-uppercase text-end" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 1px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="py-3 fw-bold" style="color: var(--neon-blue-base);">#@item.ID_CATEGORIA</td>
                                    <td class="py-3 fw-semibold">@item.NOMBRE_CATEGORIA</td>
                                    <td class="py-3">
                                        @if (item.ESTADO)
                                        {
                                            <span class="badge rounded-pill" style="background-color: rgba(32, 201, 151, 0.1); color: var(--success-base); border: 1px solid var(--success-base); box-shadow: 0 0 10px var(--success-glow); padding: 0.5em 1em;">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill" style="background-color: rgba(232, 62, 140, 0.1); color: var(--danger-base); border: 1px solid var(--danger-base); box-shadow: 0 0 10px var(--danger-glow); padding: 0.5em 1em;">Inactivo</span>
                                        }
                                    </td>
                                    <td class="py-3 text-end">
                                        <button type="button" onclick="abrirModalEditar(@item.ID_CATEGORIA, '@item.NOMBRE_CATEGORIA', '@item.ESTADO')" class="btn-action btn-edit me-2" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        @if (item.ESTADO)
                                        {
                                            <button type="button" class="btn-action btn-delete" title="Desactivar" onclick="desactivarCategoria(@item.ID_CATEGORIA)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="d-flex flex-column align-items-center">
                                        <i class="bi bi-inbox fs-1 mb-3" style="color: var(--neon-blue-base); opacity: 0.5;"></i>
                                        <h5 style="color: var(--text-main);">No hay categorías registradas</h5>
                                        <p style="color: var(--text-muted);">Haz clic en "Nueva Categoría" para comenzar.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

@* ==========================================
   MODALES (VENTANAS EMERGENTES)
   ========================================== *@

@* --- MODAL CREAR --- *@
<div class="modal fade" id="modalNuevaCategoria" tabindex="-1" aria-labelledby="modalCategoriaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-tech">
            <form action="@Url.Action("Crear", "Categoria")" method="post">
                <div class="modal-header border-0 pb-0 mt-2 mx-2">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="modalCategoriaLabel" style="color: var(--text-main);">
                        <i class="bi bi-tag-fill" style="color: var(--neon-blue-base);"></i> Nueva Categoría
                    </h5>
                    <button type="button" class="btn-close btn-close-dynamic" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-4">
                    <div class="mb-3">
                        <label for="NOMBRE_CATEGORIA" class="form-label small fw-bold text-uppercase mb-1" style="color: var(--neon-blue-base); letter-spacing: 1px;">Nombre de la Categoría</label>
                        <input type="text" class="form-control custom-input p-3" id="NOMBRE_CATEGORIA" name="NOMBRE_CATEGORIA" required placeholder="Ej. Laptops, Monitores, Periféricos...">
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-link text-decoration-none" style="color: var(--text-muted);" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-neon px-4 py-2">Guardar Categoría</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* --- MODAL EDITAR --- *@
<div class="modal fade" id="modalEditarCategoria" tabindex="-1" aria-labelledby="modalEditarCategoriaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-tech" style="border-color: var(--warning-base);">
            <form action="@Url.Action("Editar", "Categoria")" method="post">
                <div class="modal-header border-0 pb-0 mt-2 mx-2">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="modalEditarCategoriaLabel" style="color: var(--warning-base); text-shadow: 0 0 10px var(--warning-glow);">
                        <i class="bi bi-pencil-square"></i> Editar Categoría
                    </h5>
                    <button type="button" class="btn-close btn-close-dynamic" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-4">
                    <input type="hidden" id="edit_ID_CATEGORIA" name="ID_CATEGORIA" />

                    <div class="mb-4">
                        <label for="edit_NOMBRE_CATEGORIA" class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Nombre de la Categoría</label>
                        <input type="text" class="form-control custom-input p-3" id="edit_NOMBRE_CATEGORIA" name="NOMBRE_CATEGORIA" required>
                    </div>

                    <div class="mb-2">
                        <label for="edit_ESTADO" class="form-label small fw-bold text-uppercase mb-1" style="color: var(--text-muted); letter-spacing: 1px;">Estado</label>
                        <select class="form-select custom-input p-3" id="edit_ESTADO" name="ESTADO" required>
                            <option value="True">Activo</option>
                            <option value="False">Inactivo</option>
                        </select>
                        <small id="alertaEstadoCategoria" class="d-none mt-2 d-flex align-items-center gap-1" style="color: var(--warning-base); font-size: 0.8rem; font-weight: bold;">
                            <i class="bi bi-exclamation-triangle"></i> ¡Ojo! Si tiene productos activos, el sistema bloqueará la acción.
                        </small>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-link text-decoration-none" style="color: var(--text-muted);" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn px-4 py-2" style="background-color: var(--warning-base); color: #000; font-weight: 600; border-radius: 8px; box-shadow: 0 0 15px var(--warning-glow);">Actualizar Categoría</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalEditar(id, nombre, estado) {
            document.getElementById('edit_ID_CATEGORIA').value = id;
            document.getElementById('edit_NOMBRE_CATEGORIA').value = nombre;
            document.getElementById('edit_ESTADO').value = estado;

            // Limpiamos la alerta por si estaba visible de una edición anterior
            document.getElementById('alertaEstadoCategoria').classList.add('d-none');

            // Si el estado ya venía Inactivo (False), mostramos la alerta por precaución
            if (estado === 'False' || estado === 'false') {
                 document.getElementById('alertaEstadoCategoria').classList.remove('d-none');
            }

            var modalElement = document.getElementById('modalEditarCategoria');
            var modalInstance = new bootstrap.Modal(modalElement);
            modalInstance.show();
        }

        // 🔥 MAGIA: SweetAlert para el botón de la basura (Desactivar)
        function desactivarCategoria(id) {
            Swal.fire({
                title: '¿Desactivar Categoría?',
                text: "Si esta categoría tiene productos activos asociados, el sistema bloqueará la acción por seguridad. ¿Deseas intentarlo?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EE5D50',
                cancelButtonColor: '#707EAE',
                confirmButtonText: 'Sí, intentar desactivar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = '@Url.Action("Desactivar", "Categoria")';

                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'id'; // <-- Cuidamos que se llame 'id' para hacer match con el Controller
                    input.value = id;

                    form.appendChild(input);
                    document.body.appendChild(form);

                    form.submit();
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Lógica del PDF
            const linkPdf = document.getElementById("linkPdf");
            const txtBuscar = document.querySelector('input[name="nombre"]');

            if (linkPdf && txtBuscar) {
                linkPdf.addEventListener("click", function (e) {
                    const valorBusqueda = txtBuscar.value.trim();
                    const urlBase = "@Url.Action("DescargarPdf", "Categoria")";
                    this.href = `${urlBase}?busqueda=${encodeURIComponent(valorBusqueda)}`;
                });
            }

            // 🔥 MAGIA: Mostrar alerta si seleccionan Inactivo en el modal de Editar
            const selectEstadoCat = document.getElementById('edit_ESTADO');
            const alertaEstadoCat = document.getElementById('alertaEstadoCategoria');

            if(selectEstadoCat) {
                selectEstadoCat.addEventListener('change', function() {
                    if(this.value === 'False' || this.value === 'false') {
                        alertaEstadoCat.classList.remove('d-none');
                    } else {
                        alertaEstadoCat.classList.add('d-none');
                    }
                });
            }
        });
    </script>
}