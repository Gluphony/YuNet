@model Entidades.Proveedor
@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark">Editar Proveedor</h3>
        <p class="text-muted mb-0">Modificar la información del proveedor seleccionado</p>
    </div>
    <a href="/Proveedor/Index" class="btn btn-outline-secondary shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver al listado
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form action="/Proveedor/Editar" method="post">
            <input type="hidden" name="ID_PROVEEDOR" value="@Model.ID_PROVEEDOR" />

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label fw-bold text-secondary small">Razón Social *</label>
                    <input type="text" class="form-control" name="RAZON_SOCIAL" value="@Model.RAZON_SOCIAL" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-secondary small">Nombre del Contacto</label>
                    <input type="text" class="form-control" name="NOMBRE_CONTACTO" value="@Model.NOMBRE_CONTACTO">
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-secondary small">Correo Electrónico</label>
                    <input type="email" class="form-control" name="CORREO" value="@Model.CORREO">
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-secondary small d-block">Estado en el Sistema</label>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" role="switch" id="estadoSwitch" name="ESTADO" value="true" @(Model.ESTADO ? "checked" : "")>
                        <label class="form-check-label" for="estadoSwitch">
                            @(Model.ESTADO ? "Proveedor Activo" : "Proveedor Inactivo")
                        </label>
                    </div>
                </div>

            </div>

            <hr class="my-4 text-muted">

            <div class="d-flex justify-content-end gap-2">
                <a href="/Proveedor/Index" class="btn btn-light border">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">
                    <i class="bi bi-save me-1"></i> Actualizar Proveedor
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('estadoSwitch').addEventListener('change', function() {
            var label = this.nextElementSibling;
            if (this.checked) {
                label.textContent = 'Proveedor Activo';
            } else {
                label.textContent = 'Proveedor Inactivo';
            }
        });
    </script>
}