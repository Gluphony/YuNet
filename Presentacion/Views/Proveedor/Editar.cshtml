@model Entidades.Proveedor
@{
    ViewData["Title"] = "Editar Proveedor";
}

@section Styles {
    <style>
        /* ==========================================
                           ESTILOS DE FORMULARIO YUNET (MODO OSCURO/CLARO)
                           ========================================== */
        .form-yunet {
            background-color: var(--hover-bg);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            border-radius: 8px;
            padding: 0.6rem 1rem;
            transition: all 0.3s ease;
        }

            .form-yunet:focus {
                background-color: var(--bg-card);
                border-color: var(--tech-primary);
                box-shadow: 0 0 0 3px var(--tech-glow);
                color: var(--text-main);
                outline: none;
            }

            /* Deshabilitar el fondo blanco por defecto en readonly/disabled */
            .form-yunet:disabled, .form-yunet[readonly] {
                background-color: rgba(0,0,0,0.05);
                opacity: 0.7;
            }

        /* Personalización del Switch */
        .form-check-input:checked {
            background-color: var(--tech-primary);
            border-color: var(--tech-primary);
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 3px var(--tech-glow);
            border-color: var(--tech-primary);
        }

        .yunet-label {
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }
    </style>
}

<div class="container-fluid px-0 mb-4 mt-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--text-main);">
                <i class="bi bi-pencil-square me-2" style="color: var(--tech-primary);"></i>Editar Proveedor
            </h2>
            <p class="mb-0" style="color: var(--text-muted);">Modificando los datos del proveedor <strong style="color: var(--tech-accent);">#@Model.ID_PROVEEDOR</strong></p>
        </div>
        <a href="/Proveedor/Index" class="btn click-anim shadow-sm" style="background-color: var(--hover-bg); color: var(--text-main); border: 1px solid var(--border-color); border-radius: 10px; padding: 0.6rem 1.2rem; font-weight: 500;">
            <i class="bi bi-arrow-left me-2"></i>Volver al listado
        </a>
    </div>
</div>

<div class="card shadow-lg border-0" style="background-color: var(--bg-card); border-radius: 15px;">
    <div class="card-body p-4 p-md-5">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 12px;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form action="/Proveedor/Editar" method="post">
            <input type="hidden" name="ID_PROVEEDOR" value="@Model.ID_PROVEEDOR" />

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label yunet-label">Razón Social <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: var(--hover-bg); border: 1px solid var(--border-color); color: var(--text-muted); border-right: none;">
                            <i class="bi bi-building"></i>
                        </span>
                        <input type="text" class="form-control form-yunet" style="border-left: none;" name="RAZON_SOCIAL" value="@Model.RAZON_SOCIAL" required placeholder="Ej: Tech Solutions S.A.">
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label yunet-label">Nombre del Contacto</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: var(--hover-bg); border: 1px solid var(--border-color); color: var(--text-muted); border-right: none;">
                            <i class="bi bi-person-badge"></i>
                        </span>
                        <input type="text" class="form-control form-yunet" style="border-left: none;" name="NOMBRE_CONTACTO" value="@Model.NOMBRE_CONTACTO" placeholder="Nombre de quien atiende">
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label yunet-label">Teléfono <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: var(--hover-bg); border: 1px solid var(--border-color); color: var(--text-muted); border-right: none;">
                            <i class="bi bi-telephone"></i>
                        </span>
                        <input type="tel"
                               class="form-control form-yunet"
                               style="border-left: none;"
                               name="TELEFONO"
                               value="@Model?.TELEFONO"
                               placeholder="Ej. 8888-8888"
                               maxlength="15"
                               oninput="this.value = this.value.replace(/[^0-9+\- ]/g, '');"
                               required>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label yunet-label">Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: var(--hover-bg); border: 1px solid var(--border-color); color: var(--text-muted); border-right: none;">
                            <i class="bi bi-envelope-at"></i>
                        </span>
                        <input type="email" class="form-control form-yunet" style="border-left: none;" name="CORREO" value="@Model.CORREO" placeholder="contacto@empresa.com">
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label yunet-label">Dirección <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: var(--hover-bg); border: 1px solid var(--border-color); color: var(--text-muted); border-right: none;">
                            <i class="bi bi-geo-alt"></i>
                        </span>
                        <textarea class="form-control form-yunet"
                                  style="border-left: none;"
                                  name="DIRECCION"
                                  rows="2"
                                  maxlength="255"
                                  placeholder="Ej: De la rotonda 2 cuadras al sur..."
                                  required>@Model?.DIRECCION</textarea>
                        <div class="form-text text-muted">Máximo 255 caracteres.</div>
                    </div>
                </div>

                <div class="col-12 d-flex flex-column justify-content-center mt-4">
                    <label class="form-label yunet-label d-block">Estado en el Sistema</label>
                    <div class="form-check form-switch mt-1" style="font-size: 1.1rem;">
                        <input class="form-check-input shadow-sm" style="cursor: pointer;" type="checkbox" role="switch" id="estadoSwitch" name="ESTADO" value="true" @(Model.ESTADO ? "checked" : "")>
                        <label class="form-check-label ms-2" for="estadoSwitch" style="color: var(--text-main); font-weight: 500; cursor: pointer;">
                            @(Model.ESTADO ? "Proveedor Activo" : "Proveedor Inactivo")
                        </label>
                    </div>
                </div>
            </div>

            <hr class="my-5" style="border-color: var(--border-color); opacity: 1;">

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-3">
                <a href="/Proveedor/Index" class="btn click-anim" style="background-color: transparent; color: var(--text-main); border: 1px solid var(--border-color); border-radius: 10px; padding: 0.6rem 1.5rem; font-weight: 500;">
                    Cancelar
                </a>
                <button type="submit" class="btn text-white click-anim shadow" style="background: linear-gradient(135deg, var(--tech-primary) 0%, var(--tech-accent) 100%); border: none; border-radius: 10px; padding: 0.6rem 1.5rem; font-weight: 600;">
                    <i class="bi bi-save me-2"></i>Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('estadoSwitch').addEventListener('change', function() {
            var label = this.nextElementSibling;
            if (this.checked) {
                label.innerHTML = '<span style="color: #20c997;">Proveedor Activo</span>';
            } else {
                label.innerHTML = '<span style="color: #ea868f;">Proveedor Inactivo</span>';
            }
        });

        // Opcional: Ejecutar una vez al cargar para dar color inicial al texto del switch
        window.addEventListener('load', function() {
            var switchElem = document.getElementById('estadoSwitch');
            var label = switchElem.nextElementSibling;
            if (switchElem.checked) {
                label.innerHTML = '<span style="color: #20c997;">Proveedor Activo</span>';
            } else {
                label.innerHTML = '<span style="color: #ea868f;">Proveedor Inactivo</span>';
            }
        });
    </script>
}