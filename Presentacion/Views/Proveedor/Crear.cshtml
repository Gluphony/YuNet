@model Entidades.Proveedor
@{
    ViewData["Title"] = "Nuevo Proveedor";
}

@section Styles {
    <style>
        /* ==========================================
                                   ESTILOS DE FORMULARIO YUNET (MODO OSCURO/CLARO)
                                   ========================================== */
        .form-yunet {
            background-color: var(--hover-bg);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            border-radius: 8px;
            padding: 0.6rem 1rem;
            transition: all 0.3s ease;
        }

            .form-yunet:focus {
                background-color: var(--bg-card);
                border-color: var(--tech-primary);
                box-shadow: 0 0 0 3px var(--tech-glow);
                color: var(--text-main);
                outline: none;
            }

        .yunet-label {
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }

        /* Ajuste para el placeholder en modo oscuro */
        .form-yunet::placeholder {
            color: var(--text-muted);
            opacity: 0.6;
        }

        /* Ajuste para validación de Bootstrap */
        .was-validated .form-control:invalid {
            border-color: #EE5D50;
            background-image: none; /* Quita el icono feo por defecto de HTML5 */
        }
    </style>
}

<div class="container-fluid px-0 mb-4 mt-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--text-main);">
                <i class="bi bi-building-add me-2" style="color: var(--tech-primary);"></i>Registrar Proveedor
            </h2>
            <p class="mb-0" style="color: var(--text-muted);">Completar la información del nuevo socio comercial</p>
        </div>
        <a href="/Proveedor/Index" class="btn click-anim shadow-sm" style="background-color: var(--hover-bg); color: var(--text-main); border: 1px solid var(--border-color); border-radius: 10px; padding: 0.6rem 1.2rem; font-weight: 500;">
            <i class="bi bi-arrow-left me-2"></i>Volver al listado
        </a>
    </div>
</div>

<div class="card shadow-lg border-0" style="background-color: var(--bg-card); border-radius: 15px;">
    <div class="card-body p-4 p-md-5">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 12px;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form action="/Proveedor/Crear" method="post" id="formCrearProv" class="needs-validation" novalidate>

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label yunet-label">Razón Social <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: var(--hover-bg); border: 1px solid var(--border-color); color: var(--text-muted); border-right: none;">
                            <i class="bi bi-building"></i>
                        </span>
                        <input type="text" class="form-control form-yunet" style="border-left: none;"
                               name="RAZON_SOCIAL" value="@Model?.RAZON_SOCIAL"
                               maxlength="100"
                               oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s\.,]/g, '')"
                               placeholder="Ej. Distribuidora XYZ S.A." required>
                        <div class="invalid-feedback">La razón social es obligatoria y solo permite letras.</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label yunet-label">Nombre del Contacto</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: var(--hover-bg); border: 1px solid var(--border-color); color: var(--text-muted); border-right: none;">
                            <i class="bi bi-person-badge"></i>
                        </span>
                        <input type="text" class="form-control form-yunet" style="border-left: none;"
                               name="NOMBRE_CONTACTO" value="@Model?.NOMBRE_CONTACTO"
                               maxlength="60"
                               oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '')"
                               placeholder="Ej. Juan Pérez">
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label yunet-label">Teléfono <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: var(--hover-bg); border: 1px solid var(--border-color); color: var(--text-muted); border-right: none;">
                            <i class="bi bi-telephone"></i>
                        </span>
                        <input type="tel" class="form-control form-yunet" style="border-left: none;"
                               name="TELEFONO" value="@Model?.TELEFONO"
                               placeholder="Ej. 8888-8888"
                               minlength="8" maxlength="15"
                               oninput="this.value = this.value.replace(/[^0-9+\- ]/g, '');"
                               required>
                        <div class="invalid-feedback">Ingrese un teléfono válido (entre 8 y 15 números).</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label yunet-label">Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: var(--hover-bg); border: 1px solid var(--border-color); color: var(--text-muted); border-right: none;">
                            <i class="bi bi-envelope-at"></i>
                        </span>
                        <input type="email" class="form-control form-yunet" style="border-left: none;"
                               name="CORREO" value="@Model?.CORREO"
                               maxlength="50"
                               pattern="^[a-zA-Z0-9._%+-]{3,30}@@(gmail\.com|hotmail\.com|yahoo\.com|outlook\.com|yunet\.com)$"
                               placeholder="contacto@empresa.com">
                        <div class="invalid-feedback">Correo no permitido o demasiado largo. Use dominios comunes (gmail, hotmail...).</div>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label yunet-label">Dirección Completa <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text" style="background-color: var(--hover-bg); border: 1px solid var(--border-color); color: var(--text-muted); border-right: none;">
                            <i class="bi bi-geo-alt"></i>
                        </span>
                        <textarea class="form-control form-yunet" style="border-left: none;"
                                  name="DIRECCION" rows="2"
                                  maxlength="255"
                                  placeholder="Ej: De la rotonda 2 cuadras al sur..."
                                  required>@Model?.DIRECCION</textarea>
                    </div>
                    <div class="form-text mt-1" style="color: var(--text-muted); font-size: 0.8rem;">Máximo 255 caracteres.</div>
                </div>

            </div>

            <hr class="my-5" style="border-color: var(--border-color); opacity: 1;">

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-3">
                <a href="/Proveedor/Index" class="btn click-anim" style="background-color: transparent; color: var(--text-main); border: 1px solid var(--border-color); border-radius: 10px; padding: 0.6rem 1.5rem; font-weight: 500;">
                    Cancelar
                </a>
                <button type="submit" class="btn text-white click-anim shadow" style="background: linear-gradient(135deg, var(--tech-primary) 0%, var(--tech-accent) 100%); border: none; border-radius: 10px; padding: 0.6rem 1.5rem; font-weight: 600;">
                    <i class="bi bi-save me-2"></i>Guardar Proveedor
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script>
        // Activación de validación nativa de Bootstrap + Filtro Anti-Spam
        (function () {
            'use strict'
            var form = document.getElementById('formCrearProv');

            // Expresión regular: busca 5 caracteres idénticos seguidos (ej: aaaaa, 33333)
            const regexSpam = /(.)\1{4,}/;

            form.addEventListener('submit', function (event) {
                let esValido = true;
                let mensajeError = "";

                // Validamos la Razón Social contra spam
                const razonSocial = document.querySelector('input[name="RAZON_SOCIAL"]').value;
                if (regexSpam.test(razonSocial)) {
                    esValido = false;
                    mensajeError = "La Razón Social contiene demasiados caracteres repetidos. Ingrese un nombre real.";
                }

                // Validamos el Contacto contra spam
                const contacto = document.querySelector('input[name="NOMBRE_CONTACTO"]').value;
                if (contacto && regexSpam.test(contacto)) {
                    esValido = false;
                    mensajeError = "El Nombre del Contacto contiene caracteres repetidos. Ingrese un nombre real.";
                }

                // Validamos la Dirección contra spam
                const direccion = document.querySelector('textarea[name="DIRECCION"]').value;
                if (regexSpam.test(direccion)) {
                    esValido = false;
                    mensajeError = "La Dirección contiene demasiados caracteres repetidos.";
                }

                // Si es spam o si HTML5 dice que es inválido, detenemos todo
                if (!esValido) {
                    event.preventDefault();
                    event.stopPropagation();

                    Swal.fire({
                        title: "Datos Inválidos",
                        text: mensajeError,
                        icon: "warning",
                        background: 'var(--bg-card)',
                        color: 'var(--text-main)',
                        confirmButtonColor: 'var(--neon-blue-base)'
                    });
                } else if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                form.classList.add('was-validated');
            }, false);
        })()
    </script>
}