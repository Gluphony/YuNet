@model System.Data.DataTable

@{
    ViewData["Title"] = "Gestión de Unidades (IMEI)";
    // Recuperamos el ID que se haya buscado
    int idProductoActual = ViewBag.IdProducto != null ? (int)ViewBag.IdProducto : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0" style="color: var(--text-main); font-weight: 700;">Inventario Físico (IMEI)</h2>
        <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">Registra y consulta las unidades físicas por producto</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-4 col-lg-5 mb-4">
        <div class="card border-0 shadow-sm form-card h-100" style="background-color: var(--bg-card); border-radius: 12px; border-left: 0.25rem solid #C6C3F2 !important; transition: 0.3s;">
            <div class="card-header py-3" style="background-color: transparent; border-bottom: 1px solid var(--border-color);">
                <h6 class="m-0 fw-bold" style="color: #C6C3F2;"><i class="bi bi-upc-scan me-2"></i>Registrar Nueva Unidad</h6>
            </div>
            <div class="card-body p-4">

                <div class="mb-3">
                    <label class="form-label fw-bold text-uppercase mb-1" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">ID del Producto</label>
                    <input type="number" id="txtIdProducto" class="form-control border-0" value="@(idProductoActual > 0 ? idProductoActual : "")" placeholder="Ej. 101" style="background-color: var(--bg-main); color: var(--text-main);" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-uppercase mb-1" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">IMEI / Número de Serie</label>
                    <input type="text" id="txtImei" class="form-control border-0" placeholder="Ingrese el IMEI" style="background-color: var(--bg-main); color: var(--text-main);" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-uppercase mb-1" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Estado Físico</label>
                    <select id="cbEstado" class="form-select border-0" style="background-color: var(--bg-main); color: var(--text-main);">
                        <option value="NUEVO">Nuevo sellado</option>
                        <option value="EXHIBICION">De exhibición</option>
                        <option value="REACONDICIONADO">Reacondicionado</option>
                    </select>
                </div>

                <button id="btnGuardar" class="btn border-0 shadow-sm w-100 py-2 mt-2" style="background-color: #C6C3F2; color: #262628; font-weight: 600; border-radius: 8px; transition: 0.3s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
                    <i class="bi bi-save me-1"></i> Guardar Unidad
                </button>

                <div id="mensajeNotificacion" class="alert mt-3 mb-0 border-0" style="display: none; font-size: 0.9rem; border-radius: 8px;"></div>
            </div>
        </div>
    </div>

    <div class="col-xl-8 col-lg-7 mb-4">
        <div class="card border-0 shadow-sm h-100" style="background-color: var(--bg-card); border-radius: 12px; transition: 0.3s;">
            <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background-color: transparent; border-bottom: 1px solid var(--border-color);">
                <h6 class="m-0 fw-bold" style="color: var(--text-main);"><i class="bi bi-box-seam me-2"></i>Unidades Disponibles</h6>

                <form method="get" action="/UnidadExistencia/Index" class="d-flex">
                    <input type="number" name="idProducto" class="form-control form-control-sm border-0 me-2" placeholder="ID Producto..." value="@(idProductoActual > 0 ? idProductoActual : "")" required style="background-color: var(--bg-main); color: var(--text-main);">
                    <button type="submit" class="btn btn-sm border-0 shadow-sm px-3" style="background-color: var(--bg-main); color: var(--text-main); border: 1px solid var(--border-color) !important; font-weight: 600; border-radius: 6px;">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </form>
            </div>
            <div class="card-body p-4">

                @if (ViewBag.Error != null)
                {
                    <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 8px;">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>
                        <div>@ViewBag.Error</div>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="color: var(--text-main);">
                        <thead style="border-bottom: 2px solid var(--border-color);">
                            <tr>
                                <th scope="col" class="pb-3 text-uppercase border-0 rounded-start" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">ID Unidad</th>
                                <th scope="col" class="pb-3 text-uppercase border-0" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">IMEI</th>
                                <th scope="col" class="pb-3 text-uppercase border-0" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Estado Físico</th>
                                <th scope="col" class="pb-3 text-uppercase border-0 text-center rounded-end" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Disponible</th>
                            </tr>
                        </thead>
                        <tbody style="border-top: none;">
                            @if (Model != null && Model.Rows.Count > 0)
                            {
                                foreach (System.Data.DataRow row in Model.Rows)
                                {
                                    <tr style="border-bottom: 1px solid var(--border-color); transition: background-color 0.2s;">
                                        <td class="py-3 fw-bold" style="color: var(--text-main);">#@row["ID_UNIDAD_EXISTENCIA"]</td>
                                        <td class="py-3">
                                            <span class="badge" style="background-color: var(--bg-main); color: var(--text-main); border: 1px solid var(--border-color); font-weight: 500; font-family: monospace; font-size: 0.9rem;">
                                                <i class="bi bi-upc me-1"></i> @row["IMEI"]
                                            </span>
                                        </td>
                                        <td class="py-3" style="color: var(--text-main);">@row["ESTADO_FISICO"]</td>
                                        <td class="py-3 text-center">
                                            <span class="badge rounded-pill" style="background-color: rgba(25, 135, 84, 0.15); color: #20c997; border: 1px solid rgba(32, 201, 151, 0.5); padding: 0.4em 0.8em;">
                                                <i class="bi bi-check-circle me-1"></i> Sí
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else if (idProductoActual > 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <div class="d-flex flex-column align-items-center">
                                            <i class="bi bi-phone-vibrate fs-1 mb-3" style="color: var(--text-muted);"></i>
                                            <h5 style="color: var(--text-main);">No hay unidades disponibles</h5>
                                            <p style="color: var(--text-muted);">No se encontraron unidades físicas para el producto <strong>#@idProductoActual</strong>.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <div class="d-flex flex-column align-items-center">
                                            <i class="bi bi-search fs-1 mb-3" style="color: var(--text-muted);"></i>
                                            <h5 style="color: var(--text-main);">Busca un producto</h5>
                                            <p style="color: var(--text-muted);">Usa el buscador de arriba para listar las unidades de un producto específico.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    /* Efecto hover suave para la tarjeta de formulario */
    .form-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.5rem 2rem 0 rgba(0, 0, 0, 0.1) !important;
    }

    /* Correcciones para la tabla en modo oscuro */
    .table-hover tbody tr:hover {
        background-color: var(--bg-main) !important;
    }

    .table > :not(caption) > * > * {
        background-color: transparent !important;
        border-bottom-color: var(--border-color);
    }

    /* Estilo para que el dropdown y los inputs no se vean blancos en modo oscuro */
    select option {
        background-color: var(--bg-card);
        color: var(--text-main);
    }
</style>

@section Scripts {
    <script>
        document.getElementById("btnGuardar").addEventListener("click", function () {

            const idProducto = document.getElementById("txtIdProducto").value;
            const imei = document.getElementById("txtImei").value;
            const estado = document.getElementById("cbEstado").value;

            if(!idProducto || !imei) {
                mostrarMensaje('<i class="bi bi-exclamation-triangle-fill me-2"></i> El ID del producto y el IMEI son obligatorios.', "rgba(255, 193, 7, 0.15)", "#ffc107");
                return;
            }

            const btn = this;
            const textoOriginal = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Guardando...';
            btn.disabled = true;

            const unidad = {
                ID_PRODUCTO: parseInt(idProducto),
                IMEI: imei,
                ESTADO_FISICO: estado
            };

            fetch('/UnidadExistencia/Insertar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(unidad)
            })
            .then(response => response.json())
            .then(data => {
                if (data.exito) {
                    mostrarMensaje('<i class="bi bi-check-circle-fill me-2"></i>' + data.mensaje, "rgba(25, 135, 84, 0.15)", "#20c997");

                    setTimeout(() => {
                        window.location.href = '/UnidadExistencia/Index?idProducto=' + idProducto;
                    }, 1200);

                } else {
                    mostrarMensaje('<i class="bi bi-x-circle-fill me-2"></i>' + data.mensaje, "rgba(220, 53, 69, 0.15)", "#ff6b6b");
                    restaurarBoton(btn, textoOriginal);
                }
            })
            .catch(error => {
                mostrarMensaje('<i class="bi bi-wifi-off me-2"></i> Error de conexión con el servidor.', "rgba(220, 53, 69, 0.15)", "#ff6b6b");
                restaurarBoton(btn, textoOriginal);
            });
        });

        // Modificamos ligeramente la función de mensajes para aceptar colores personalizados
        // y que se vea bien en ambos temas
        function mostrarMensaje(html, bgColor, textColor) {
            const div = document.getElementById("mensajeNotificacion");
            div.innerHTML = html;
            div.style.backgroundColor = bgColor;
            div.style.color = textColor;
            div.style.border = `1px solid ${textColor}50`; // Borde semi-transparente
            div.style.display = "block";
        }

        function restaurarBoton(btn, textoOriginal) {
            btn.innerHTML = textoOriginal;
            btn.disabled = false;
        }
    </script>
}