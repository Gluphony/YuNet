@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | YuNet System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        /* ==========================================
                                   VARIABLES Y TEMA OSCURO REFINADO
                                   ========================================== */
        :root {
            --neon-primary: #00D4FF;
            --neon-secondary: #ff00ff; /* Un toque magenta para contraste */
            --bg-deep: #050508;
            --glass-bg: rgba(20, 20, 25, 0.7);
            --glass-border: rgba(0, 212, 255, 0.2);
            --text-main: #ffffff;
            --text-muted: #8b92a5;
            --input-bg: rgba(255, 255, 255, 0.03);
        }

        body {
            background-color: var(--bg-deep);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            margin: 0;
            position: relative;
        }

        /* Sobrescribir el gris oscuro por defecto de Bootstrap */
        .text-muted {
            color: #aab2c5 !important;
        }

        /* ==========================================
                                   FONDO ANIMADO (PARTÍCULAS Y BRILLOS)
                                   ========================================== */
        .background-fx {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            overflow: hidden;
            background: radial-gradient(circle at 15% 50%, rgba(0, 212, 255, 0.08), transparent 40%), radial-gradient(circle at 85% 30%, rgba(255, 0, 255, 0.05), transparent 40%);
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            animation: float 10s infinite alternate ease-in-out;
            opacity: 0.5;
        }

        .orb-1 {
            width: 300px;
            height: 300px;
            background: var(--neon-primary);
            top: -100px;
            left: -100px;
        }

        .orb-2 {
            width: 250px;
            height: 250px;
            background: var(--neon-secondary);
            bottom: -50px;
            right: 10%;
            animation-delay: -5s;
        }

        @@keyframes float {
            0%

        {
            transform: translateY(0) scale(1);
        }

        100% {
            transform: translateY(40px) scale(1.1);
        }

        }

        /* ==========================================
                                   CONTENEDOR PRINCIPAL (GLASSMORPHISM)
                                   ========================================== */
        .login-wrapper {
            position: relative;
            z-index: 10;
            display: flex;
            width: 1000px;
            max-width: 95%;
            min-height: 600px;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.6), inset 0 0 20px rgba(0, 212, 255, 0.05);
            overflow: hidden;
        }

            /* Línea de brillo superior animada */
            .login-wrapper::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 50%;
                height: 2px;
                background: linear-gradient(90deg, transparent, var(--neon-primary), transparent);
                animation: scanline 4s linear infinite;
            }

        @@keyframes scanline {
            0%

        {
            left: -100%;
        }

        100% {
            left: 200%;
        }

        }

        /* ==========================================
                                   LADO IZQUIERDO: BRANDING
                                   ========================================== */
        .login-brand {
            width: 50%;
            padding: 4rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            border-right: 1px solid rgba(255,255,255,0.05);
            background: linear-gradient(135deg, rgba(0,0,0,0.4) 0%, rgba(0,212,255,0.05) 100%);
        }

        .brand-icon {
            font-size: 4.5rem;
            color: var(--neon-primary);
            filter: drop-shadow(0 0 15px rgba(0, 212, 255, 0.6));
            margin-bottom: 1rem;
            display: inline-block;
            animation: pulse-glow 3s infinite alternate;
        }

        @@keyframes pulse-glow {
            0%

        {
            filter: drop-shadow(0 0 10px rgba(0, 212, 255, 0.4));
            transform: scale(1);
        }

        100% {
            filter: drop-shadow(0 0 25px rgba(0, 212, 255, 0.8));
            transform: scale(1.05);
        }

        }

        .brand-title {
            font-size: 3rem;
            font-weight: 800;
            letter-spacing: 2px;
            background: linear-gradient(to right, #fff, var(--neon-primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.5rem;
        }

        .brand-subtitle {
            color: var(--text-muted);
            font-size: 1.1rem;
            letter-spacing: 1px;
            margin-bottom: 2rem;
            text-transform: uppercase;
        }

        /* ==========================================
                                   LADO DERECHO: FORMULARIO
                                   ========================================== */
        .login-form-container {
            width: 50%;
            padding: 4rem 3.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-header h3 {
            font-weight: 700;
            margin-bottom: 0.2rem;
        }

        .form-header p {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 2.5rem;
        }

        /* Inputs Flotantes Estilo Neón */
        .form-floating-custom {
            position: relative;
            margin-bottom: 1.5rem;
        }

            .form-floating-custom input {
                width: 100%;
                background: var(--input-bg);
                border: 1px solid rgba(255, 255, 255, 0.1);
                color: var(--text-main);
                padding: 1rem 1rem 1rem 3rem;
                border-radius: 12px;
                font-size: 1rem;
                transition: all 0.3s ease;
            }

                .form-floating-custom input:focus {
                    outline: none;
                    background: rgba(0, 212, 255, 0.05);
                    border-color: var(--neon-primary);
                    box-shadow: 0 0 15px rgba(0, 212, 255, 0.2), inset 0 0 10px rgba(0, 212, 255, 0.1);
                }

            .form-floating-custom i.icon-left {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                transition: color 0.3s ease;
                z-index: 2;
            }

            .form-floating-custom input:focus ~ i.icon-left,
            .form-floating-custom input:not(:placeholder-shown) ~ i.icon-left {
                color: var(--neon-primary);
            }

        /* Toggle Password */
        .toggle-password {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            cursor: pointer;
            z-index: 2;
            transition: color 0.3s ease;
        }

            .toggle-password:hover {
                color: var(--neon-primary);
            }

        /* Controles extra (Recordarme / Olvidé) */
        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            font-size: 0.85rem;
        }

        .link-neon {
            color: var(--neon-primary);
            text-decoration: none;
            transition: all 0.3s ease;
            position: relative;
        }

            .link-neon::after {
                content: '';
                position: absolute;
                width: 0;
                height: 1px;
                bottom: -2px;
                left: 0;
                background-color: var(--neon-primary);
                transition: width 0.3s ease;
            }

            .link-neon:hover {
                color: #fff;
                text-shadow: 0 0 8px var(--neon-primary);
            }

                .link-neon:hover::after {
                    width: 100%;
                }

        /* Checkbox Custom */
        .form-check-input {
            background-color: var(--input-bg);
            border-color: rgba(255,255,255,0.2);
        }

            .form-check-input:checked {
                background-color: var(--neon-primary);
                border-color: var(--neon-primary);
                box-shadow: 0 0 10px var(--neon-primary);
            }

        /* Botón de Submit con Efecto Cyberpunk */
        .btn-glow {
            width: 100%;
            padding: 1rem;
            background: transparent;
            color: var(--neon-primary);
            border: 1px solid var(--neon-primary);
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            margin-bottom: 1.5rem;
        }

            .btn-glow::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: var(--neon-primary);
                z-index: -1;
                transform: scaleX(0);
                transform-origin: left;
                transition: transform 0.4s ease;
            }

            .btn-glow:hover {
                color: #000;
                border-color: transparent;
                box-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
                transform: translateY(-3px);
            }

                .btn-glow:hover::before {
                    transform: scaleX(1);
                }

        /* Alerta de Error */
        .alert-neon {
            background: rgba(255, 51, 102, 0.1);
            border: 1px solid rgba(255, 51, 102, 0.3);
            color: #ff3366;
            border-radius: 8px;
            padding: 0.8rem;
            font-size: 0.85rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
        }

        /* Alerta de Éxito (Verde Neón) */
        .alert-success-neon {
            background: rgba(0, 255, 170, 0.1);
            border: 1px solid rgba(0, 255, 170, 0.3);
            color: #00ffaa;
            border-radius: 8px;
            padding: 0.8rem;
            font-size: 0.85rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
        }

        /* ==========================================
                                   RESPONSIVE
                                   ========================================== */
        @@media (max-width: 900px) {
            .login-wrapper

        {
            flex-direction: column;
            max-width: 500px;
            min-height: auto;
        }

        .login-brand {
            width: 100%;
            padding: 3rem 2rem;
            border-right: none;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            text-align: center;
        }

        .login-form-container {
            width: 100%;
            padding: 3rem 2rem;
        }

        }
    </style>
</head>
<body>

    <div class="background-fx">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <div class="login-wrapper animate__animated animate__zoomIn">

        <a href="@Url.Action("Index", "Home")" class="btn btn-sm btn-outline-secondary position-absolute" style="top: 20px; left: 20px; z-index: 100; border-color: rgba(255,255,255,0.2); color: var(--text-muted);">
            <i class="bi bi-arrow-left me-1"></i> Volver a Tienda
        </a>

        <div class="login-brand">

            <div>
                <i class="bi bi-cpu brand-icon"></i>
                <h1 class="brand-title">YuNet</h1>
                <p class="brand-subtitle">System Core</p>
                <p class="small lh-lg" style="max-width: 300px; color: #cbd5e1;">
                    Acceso restringido. Por favor, autentique su identidad para ingresar al panel de administración central.
                </p>
            </div>
        </div>

        <div class="login-form-container">
            <div class="form-header">
                <h3>Identificación</h3>
                <p>Ingrese sus credenciales operativas</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-neon animate__animated animate__shakeX">
                    <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                    <div>@ViewBag.Error</div>
                </div>
            }
            @if (ViewBag.Exito != null || TempData["Exito"] != null)
            {
                <div class="alert-success-neon animate__animated animate__pulse">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div>@(ViewBag.Exito ?? TempData["Exito"])</div>
                </div>
            }

            <form action="/Login/Index" method="POST" id="loginForm">

                <div class="form-floating-custom">
                    <input type="email" name="correo" id="emailInput" placeholder=" " required autofocus autocomplete="off" maxlength="80">
                    <i class="bi bi-envelope icon-left"></i>
                    <label style="position: absolute; left: 3rem; top: 1rem; color: var(--text-muted); pointer-events: none; transition: 0.3s; opacity: 0;">Correo electrónico</label>
                </div>

                <div class="form-floating-custom">
                    <input type="password" name="clave" id="passwordInput" placeholder=" " required maxlength="35">
                    <i class="bi bi-shield-lock icon-left"></i>
                    <span class="toggle-password" id="togglePassword">
                        <i class="bi bi-eye-slash" id="eyeIcon"></i>
                    </span>
                </div>

                <div class="form-options">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe" name="recordarme" value="true">
                        <label class="form-check-label text-muted" for="rememberMe">
                            Recordar sesión
                        </label>
                    </div>
                    <a href="~/Login/RestablecerClave" style="color: #00e5ff; text-decoration: none;">¿Olvidó su clave?</a>
                </div>

                <button type="submit" class="btn-glow">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Inicializar Sesión
                </button>

                <div class="text-center mt-4">
                    <p class="text-muted small">¿Usuario nuevo? <a href="/Login/Registro" class="link-neon fw-bold">Solicitar Acceso</a></p>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Lógica para mostrar/ocultar contraseña
        const togglePassword = document.querySelector('#togglePassword');
        const passwordInput = document.querySelector('#passwordInput');
        const eyeIcon = document.querySelector('#eyeIcon');

        togglePassword.addEventListener('click', function () {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);

            eyeIcon.classList.toggle('bi-eye');
            eyeIcon.classList.toggle('bi-eye-slash');
        });

        // Efecto visual para inputs: mostrar placeholder simulado al enfocar
        const inputs = document.querySelectorAll('.form-floating-custom input');
        inputs.forEach(input => {
            input.setAttribute('placeholder', input.type === 'email' ? 'usuario@yunet.com' : '••••••••');
        });

        // ==============================================================
        // 🔥 MAGIA DE RECORDAR CORREO (Local Storage)
        // ==============================================================
        document.addEventListener('DOMContentLoaded', function() {
            const emailInput = document.getElementById('emailInput');
            const rememberCheckbox = document.getElementById('rememberMe');
            const loginForm = document.getElementById('loginForm');

            // 1. Al cargar la página, revisamos si hay un correo guardado
            const savedEmail = localStorage.getItem('yunet_saved_email');
            if (savedEmail) {
                emailInput.value = savedEmail;
                rememberCheckbox.checked = true;
            }

            // 2. Al enviar el formulario, guardamos o borramos el correo
            loginForm.addEventListener('submit', function() {
                if (rememberCheckbox.checked) {
                    localStorage.setItem('yunet_saved_email', emailInput.value);
                } else {
                    localStorage.removeItem('yunet_saved_email');
                }
            });
        });
    </script>
</body>
</html>