@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | YuNet Inventario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-color: #0d6efd;
            --bg-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        body {
            background: var(--bg-gradient);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 2.5rem;
            border-radius: 15px;
            border: none;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            background-color: rgba(255, 255, 255, 0.98);
        }

        .brand-logo {
            font-size: 2.5rem;
            letter-spacing: -1px;
            color: #4e54c8;
        }

        .form-control {
            border-radius: 8px;
            padding: 0.75rem 1rem;
            border: 1px solid #ced4da;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                box-shadow: 0 0 0 0.25rem rgba(78, 84, 200, 0.25);
                border-color: #4e54c8;
            }

        .btn-login {
            background: var(--bg-gradient);
            border: none;
            color: white;
            padding: 0.8rem;
            border-radius: 8px;
            font-weight: 600;
            transition: transform 0.2s ease;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
                color: white;
            }

        .input-group-text {
            background-color: transparent;
            border-right: none;
            color: #6c757d;
        }

        .form-control {
            border-left: none;
        }

        .input-group:focus-within .input-group-text {
            border-color: #4e54c8;
            color: #4e54c8;
        }
    </style>
</head>
<body>

    <div class="login-card animate__animated animate__fadeIn">
        <div class="text-center mb-4">
            <div class="mb-2">
                <i class="bi bi-box-seam brand-logo"></i>
            </div>
            <h2 class="fw-bold mb-1">YuNet</h2>
            <p class="text-muted small">Panel de Control de Inventario</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger d-flex align-items-center py-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div style="font-size: 0.85rem;">@ViewBag.Error</div>
            </div>
        }

        <form action="/Login/Index" method="POST">
            <div class="mb-3">
                <label class="form-label small fw-bold text-secondary">CORREO ELECTRÓNICO</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input type="email" class="form-control" name="correo" placeholder="correo@yunet.com" required autofocus>
                </div>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between">
                    <label class="form-label small fw-bold text-secondary">CONTRASEÑA</label>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control" name="clave" placeholder="••••••••" required>
                </div>
            </div>

            <button type="submit" class="btn btn-login w-100 mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i> Acceder al sistema
            </button>
        </form>

        <div class="text-center border-top pt-3 mt-3">
            <p class="text-muted mb-0" style="font-size: 0.75rem;">
                &copy; @DateTime.Now.Year YuNet Solutions. <br>
                Todos los derechos reservados.
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>