@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | YuNet Inventario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --primary-color: #4e54c8;
            --secondary-color: #8f94fb;
        }

        body {
            background-color: #f8f9fa;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden; /* Evita scroll en pantallas grandes */
        }

        /* Contenedor principal estilo pantalla dividida */
        .login-wrapper {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            display: flex;
            width: 900px;
            max-width: 95%;
            min-height: 550px;
        }

        /* Lado Izquierdo: Branding/Imagen */
        .login-brand {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            width: 50%;
            padding: 3rem;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

            .login-brand i {
                font-size: 5rem;
                margin-bottom: 1rem;
                text-shadow: 2px 4px 10px rgba(0,0,0,0.2);
            }

        /* Lado Derecho: Formulario */
        .login-form-container {
            width: 50%;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-control {
            border-radius: 8px;
            padding: 0.8rem 1rem;
            border: 1px solid #ced4da;
            transition: all 0.3s ease;
            background-color: #fcfcfc;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: var(--primary-color);
                background-color: white;
            }

        /* Ajustes para el grupo de inputs con íconos */
        .input-group-text {
            background-color: #fcfcfc;
            border-right: none;
            color: #6c757d;
            border-radius: 8px 0 0 8px;
        }

        .input-group .form-control {
            border-left: none;
        }

        .input-group:focus-within .input-group-text {
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

        /* Botón de mostrar contraseña */
        .toggle-password {
            background-color: #fcfcfc;
            border: 1px solid #ced4da;
            border-left: none;
            color: #6c757d;
            cursor: pointer;
            border-radius: 0 8px 8px 0;
            padding: 0 1rem;
            display: flex;
            align-items: center;
        }

        .input-group:focus-within .toggle-password {
            border-color: var(--primary-color);
        }

        .btn-login {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            border: none;
            color: white;
            padding: 0.9rem;
            border-radius: 8px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(78, 84, 200, 0.3);
                color: white;
            }

        /* Responsivo para móviles */
        @@media (max-width: 768px) {
            .login-wrapper {
                flex-direction: column;
                min-height: auto;
            }

            .login-brand {
                width: 100%;
                padding: 2rem;
            }

                .login-brand i {
                    font-size: 3rem;
                }

            .login-form-container {
                width: 100%;
                padding: 2rem;
            }
        }
    </style>
</head>
<body>

    <div class="login-wrapper animate__animated animate__zoomIn">

        <div class="login-brand">
            <i class="bi bi-boxes"></i> <h1 class="fw-bold mb-2">YuNet</h1>
            <p class="fs-5 opacity-75 mb-4">Sistema Integral de Gestión</p>
            <p class="small opacity-50 text-center px-3">
                Administra tus productos, controla tu inventario y gestiona usuarios de forma segura y eficiente.
            </p>
        </div>

        <div class="login-form-container">
            <div class="mb-4">
                <h3 class="fw-bold text-dark mb-1">¡Bienvenido de nuevo!</h3>
                <p class="text-muted small">Por favor, ingresa tus credenciales.</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-center py-2 animate__animated animate__shakeX" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div style="font-size: 0.85rem;">@ViewBag.Error</div>
                </div>
            }

            <form action="/Login/Index" method="POST">
                <div class="mb-4">
                    <label class="form-label small fw-bold text-secondary">CORREO ELECTRÓNICO</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input type="email" class="form-control" name="correo" placeholder="usuario@yunet.com" required autofocus>
                    </div>
                </div>

                <div class="mb-5">
                    <div class="d-flex justify-content-between">
                        <label class="form-label small fw-bold text-secondary">CONTRASEÑA</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" class="form-control border-end-0" id="passwordInput" name="clave" placeholder="••••••••" required>
                        <span class="toggle-password" id="togglePassword">
                            <i class="bi bi-eye-slash" id="eyeIcon"></i>
                        </span>
                    </div>
                </div>

                <button type="submit" class="btn btn-login w-100 mb-3">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Acceder al sistema
                </button>
            </form>

            <div class="text-center pt-3 mt-auto">
                <p class="text-muted mb-0" style="font-size: 0.75rem;">
                    &copy; @DateTime.Now.Year YuNet Solutions. <br>
                    Todos los derechos reservados.
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const togglePassword = document.querySelector('#togglePassword');
        const passwordInput = document.querySelector('#passwordInput');
        const eyeIcon = document.querySelector('#eyeIcon');

        togglePassword.addEventListener('click', function () {
            // Cambiar tipo de input
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);

            // Cambiar el ícono
            eyeIcon.classList.toggle('bi-eye');
            eyeIcon.classList.toggle('bi-eye-slash');
        });
    </script>
</body>
</html>