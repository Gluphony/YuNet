@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Solicitar Acceso | YuNet System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        /* Reutilizamos tus variables de diseño */
        :root {
            --neon-primary: #00D4FF;
            --neon-secondary: #ff00ff;
            --bg-deep: #050508;
            --glass-bg: rgba(20, 20, 25, 0.7);
            --glass-border: rgba(0, 212, 255, 0.2);
            --text-main: #ffffff;
            --text-muted: #8b92a5;
            --input-bg: rgba(255, 255, 255, 0.03);
        }

        body {
            background-color: var(--bg-deep);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            margin: 0;
            position: relative;
        }

        .background-fx {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            background: radial-gradient(circle at 15% 50%, rgba(0, 212, 255, 0.08), transparent 40%), radial-gradient(circle at 85% 30%, rgba(255, 0, 255, 0.05), transparent 40%);
        }

        .login-wrapper {
            position: relative;
            z-index: 10;
            width: 500px;
            max-width: 95%;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.6), inset 0 0 20px rgba(0, 212, 255, 0.05);
            padding: 3rem;
        }

        .form-header h3 {
            font-weight: 700;
            margin-bottom: 0.2rem;
            text-align: center;
        }

        .form-header p {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 2.5rem;
            text-align: center;
        }

        .form-floating-custom {
            position: relative;
            margin-bottom: 1.5rem;
        }

            .form-floating-custom input, .form-floating-custom select {
                width: 100%;
                background: var(--input-bg);
                border: 1px solid rgba(255, 255, 255, 0.1);
                color: var(--text-main);
                padding: 1rem 1rem 1rem 3rem;
                border-radius: 12px;
                font-size: 1rem;
                transition: all 0.3s ease;
            }

                .form-floating-custom input:focus, .form-floating-custom select:focus {
                    outline: none;
                    background: rgba(0, 212, 255, 0.05);
                    border-color: var(--neon-primary);
                    box-shadow: 0 0 15px rgba(0, 212, 255, 0.2), inset 0 0 10px rgba(0, 212, 255, 0.1);
                }

            .form-floating-custom i.icon-left {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                z-index: 2;
            }

        /* Estilo opciones Select oscuras */
        option {
            background-color: var(--bg-deep);
            color: white;
        }

        .btn-glow {
            width: 100%;
            padding: 1rem;
            background: transparent;
            color: var(--neon-primary);
            border: 1px solid var(--neon-primary);
            border-radius: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: all 0.4s;
        }

            .btn-glow:hover {
                color: #000;
                background: var(--neon-primary);
                box-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
            }

        .alert-neon {
            background: rgba(255, 51, 102, 0.1);
            border: 1px solid rgba(255, 51, 102, 0.3);
            color: #ff3366;
            border-radius: 8px;
            padding: 0.8rem;
            font-size: 0.85rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
        }
    </style>
</head>
<body>

    <div class="background-fx"></div>

    <div class="login-wrapper animate__animated animate__fadeInUp">

        <div class="form-header">
            <i class="bi bi-person-plus" style="font-size: 3rem; color: var(--neon-primary);"></i>
            <h3>Nuevo Operador</h3>
            <p>Complete los datos para solicitar acceso a YuNet</p>
        </div>

        <div id="js-error-container"></div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-neon animate__animated animate__shakeX">
                <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                <div>@ViewBag.Error</div>
            </div>
        }

        <form id="formRegistro" action="/Login/Registro" method="POST">
            @Html.AntiForgeryToken()

            <div class="form-floating-custom">
                <input type="text" name="Nombre" placeholder="Nombre completo"
                       value="@ViewBag.NombreTemp"
                       pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+"
                       title="El nombre solo debe contener letras y espacios. No se permiten números ni caracteres especiales."
                       required autocomplete="off">
                <i class="bi bi-person icon-left"></i>
            </div>

            <div class="form-floating-custom">
                <input type="email" name="Correo" placeholder="usuario@yunet.com"
                       value="@ViewBag.CorreoTemp"
                       required autocomplete="off" id="inputCorreo">
                <i class="bi bi-envelope icon-left"></i>
            </div>

            <div class="form-floating-custom">
                <input type="password" name="Clave" placeholder="Contraseña" required id="inputClave">
                <i class="bi bi-shield-lock icon-left"></i>
            </div>

            <div class="form-floating-custom">
                <select name="Id_Rol" required id="selectRol">
                    <option value="1">Administrador</option>
                    <option value="2" selected>Usuario</option>
                    <option value="3">Vendedor</option>
                    <option value="4">Auditor</option>
                </select>
                <i class="bi bi-person-badge icon-left"></i>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn-glow m-0 flex-grow-1">
                    <i class="bi bi-check2-circle me-2"></i> Registrarse
                </button>

                <a href="/Login/Index" class="btn d-flex align-items-center justify-content-center px-4"
                   style="border: 1px solid #ff3366; color: #ff3366; border-radius: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; transition: all 0.3s; text-decoration: none;"
                   onmouseover="this.style.background='#ff3366'; this.style.color='#fff'; this.style.boxShadow='0 0 15px rgba(255, 51, 102, 0.5)';"
                   onmouseout="this.style.background='transparent'; this.style.color='#ff3366'; this.style.boxShadow='none';">
                    <i class="bi bi-box-arrow-left me-2"></i> Salir
                </a>
            </div>
        </form>

    </div>

    <script>
        document.getElementById('formRegistro').addEventListener('submit', function (e) {

            // 1. Obtener los valores de los inputs
            const clave = document.getElementById('inputClave').value;
            const correo = document.getElementById('inputCorreo').value.trim();
            const idRol = document.getElementById('selectRol').value;
            const errorContainer = document.getElementById('js-error-container');

            // Limpiar errores previos
            errorContainer.innerHTML = '';
            let errorMsg = '';

            // 2. Validar longitud de contraseña
            if (clave.length < 5) {
                errorMsg = "La contraseña debe tener al menos 5 caracteres.";
            }
            // 3. Validar formato del correo basado en el rol
            else {
                let terminacionEsperada = "";
                switch (idRol) {
                    case "1": terminacionEsperada = ".admin@yunet.com"; break;
                    case "2": terminacionEsperada = ".usuario@yunet.com"; break;
                    case "3": terminacionEsperada = ".vendedor@yunet.com"; break;
                    case "4": terminacionEsperada = ".auditor@yunet.com"; break;
                }

                if (!correo.endsWith(terminacionEsperada)) {
                    errorMsg = `Formato de correo inválido. Para este rol, el correo debe terminar en '${terminacionEsperada}'.`;
                }
            }

            // 4. Si hay error, detenemos el envío e inyectamos la alerta visual
            if (errorMsg !== '') {
                e.preventDefault(); // Evita que la página recargue y envíe el formulario

                errorContainer.innerHTML = `
                    <div class="alert-neon animate__animated animate__shakeX">
                        <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                        <div>${errorMsg}</div>
                    </div>
                `;
            }
        });
    </script>
</body>
</html>