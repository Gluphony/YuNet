@{
    ViewData["Title"] = "YuNet Store - Inicio";
}

<style>
    /* ==========================================
               VARIABLES NEÓN
               ========================================== */
    :root {
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
    }

    /* ==========================================
               ESTILOS ADAPTATIVOS (Modo Claro/Oscuro)
               ========================================== */

    /* Tarjetas de Beneficios */
    .benefit-card {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        position: relative;
        overflow: hidden;
        color: var(--text-main);
    }

        .benefit-card:hover {
            transform: translateY(-5px);
            border-color: var(--neon-blue-base) !important;
            box-shadow: 0 10px 30px var(--neon-blue-glow);
            background-color: var(--neon-blue-tint) !important;
        }

        .benefit-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--neon-blue-base), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .benefit-card:hover::before {
            opacity: 1;
        }

    /* Íconos Neón */
    .icon-circle {
        height: 3.5rem;
        width: 3.5rem;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        background-color: var(--neon-blue-tint);
        color: var(--neon-blue-base);
        border: 1px solid rgba(0, 212, 255, 0.2);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .benefit-card:hover .icon-circle {
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0 0 15px var(--neon-blue-glow);
    }

    .btn-neon {
        background: transparent;
        color: var(--neon-blue-base) !important;
        border: 1px solid var(--neon-blue-base);
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-neon:hover {
            background: var(--neon-blue-base);
            color: #fff !important;
            box-shadow: 0 0 20px var(--neon-blue-glow);
            transform: translateY(-2px);
        }

    /* ==========================================
               TARJETAS DE PRODUCTO FOTOGRÁFICAS
               ========================================== */
    .product-photo-card {
        border-radius: 20px;
        overflow: hidden;
        position: relative;
        border: 1px solid var(--border-color);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        background-color: var(--bg-card);
        height: 100%;
        cursor: pointer;
    }

        .product-photo-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px var(--neon-blue-glow);
            border-color: var(--neon-blue-base);
        }

    .product-photo-bg {
        height: 220px;
        background-size: cover;
        background-position: center;
        position: relative;
    }

    .product-photo-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.2) 60%, transparent 100%);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 1.5rem;
    }

    .premium-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 0.8rem;
    }

    /* Marcas */
    .brand-card {
        background-color: var(--bg-card) !important;
        border-radius: 16px;
        border: 1px solid var(--border-color) !important;
        transition: all 0.4s ease;
        filter: grayscale(100%) opacity(0.5);
        cursor: pointer;
        color: var(--text-main);
        /* Nuevas propiedades para centrado perfecto: */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 140px;
    }

        .brand-card:hover {
            filter: grayscale(0%) opacity(1);
            transform: translateY(-5px);
            background-color: var(--neon-blue-tint) !important;
            border-color: rgba(0, 212, 255, 0.3) !important;
            color: var(--neon-blue-base) !important;
        }
        }

    /* ==========================================
               SECCIÓN DE INFORMACIÓN (SCROLL + IMAGEN FIJA)
               ========================================== */
    .scroll-container {
        position: relative;
        margin: 5rem 0;
    }

    .sticky-image-wrapper {
        position: sticky;
        top: 100px; /* Se queda pegado debajo del navbar */
        height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .sticky-image-wrapper img {
            max-height: 100%;
            object-fit: contain;
            filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5));
        }

    .feature-step {
        min-height: 60vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        opacity: 0.3;
        transform: translateX(30px);
        transition: all 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
        color: var(--text-main);
    }

        .feature-step.active-step {
            opacity: 1;
            transform: translateX(0);
        }

            .feature-step.active-step h3 {
                color: var(--neon-blue-base);
                text-shadow: 0 0 10px var(--neon-blue-glow);
            }

        .feature-step p {
            opacity: 0.8;
        }

    /* ==========================================
               ACORDEÓN FAQ (ADAPTATIVO)
               ========================================== */
    .accordion-item {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-main) !important;
    }

    .accordion-button {
        background-color: var(--bg-card) !important;
        color: var(--text-main) !important;
        box-shadow: none !important;
    }

        .accordion-button:not(.collapsed) {
            background-color: var(--neon-blue-tint) !important;
            color: var(--neon-blue-base) !important;
            border-bottom: 1px solid var(--border-color);
        }
</style>

