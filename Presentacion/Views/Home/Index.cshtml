@{
    ViewData["Title"] = "Dashboard";
}

<style>
    /* Estilos específicos para las tarjetas del Dashboard */
    .stat-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .icon-circle {
        height: 3rem;
        width: 3rem;
        border-radius: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .border-left-primary {
        border-left: 0.25rem solid #0d6efd !important;
    }

    .border-left-success {
        border-left: 0.25rem solid #198754 !important;
    }

    .border-left-warning {
        border-left: 0.25rem solid #ffc107 !important;
    }

    .border-left-info {
        border-left: 0.25rem solid #0dcaf0 !important;
    }
    /* Nuevo color para Auditoría */
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark">Dashboard General</h3>
        <p class="text-muted mb-0">Resumen de la actividad del sistema YuNet</p>
    </div>
    <a href="/Productos/Crear" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
    </a>
</div>

<div class="row mb-4">

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card border-left-primary h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs fw-bold text-primary text-uppercase mb-1" style="font-size: 0.8rem;">
                            Usuarios Activos
                        </div>
                        <div class="h3 mb-0 fw-bold text-dark">12</div>
                    </div>
                    <div class="col-auto">
                        <div class="icon-circle bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card border-left-success h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs fw-bold text-success text-uppercase mb-1" style="font-size: 0.8rem;">
                            Productos Totales
                        </div>
                        <div class="h3 mb-0 fw-bold text-dark">345</div>
                    </div>
                    <div class="col-auto">
                        <div class="icon-circle bg-success bg-opacity-10 text-success">
                            <i class="bi bi-box-seam-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card border-left-warning h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs fw-bold text-warning text-uppercase mb-1" style="font-size: 0.8rem;">
                            Stock Bajo
                        </div>
                        <div class="h3 mb-0 fw-bold text-dark">8</div>
                    </div>
                    <div class="col-auto">
                        <div class="icon-circle bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card border-left-info h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs fw-bold text-info text-uppercase mb-1" style="font-size: 0.8rem;">
                            Eventos Hoy
                        </div>
                        <div class="h3 mb-0 fw-bold text-dark">42</div>
                    </div>
                    <div class="col-auto">
                        <div class="icon-circle bg-info bg-opacity-10 text-info">
                            <i class="bi bi-shield-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card stat-card">
            <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 fw-bold text-primary">Accesos y Tareas Frecuentes</h6>
            </div>
            <div class="card-body">
                <p class="text-muted">Bienvenido <strong>@User.Identity.Name</strong>. Utiliza el menú de la izquierda para navegar o selecciona una tarea rápida:</p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/Usuarios/Index" class="btn btn-outline-secondary"><i class="bi bi-person-gear"></i> Gestionar Permisos</a>
                    <a href="/Productos/Index" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Buscar Producto</a>
                    <a href="/Auditoria/Index" class="btn btn-outline-info text-dark"><i class="bi bi-list-check"></i> Ver Registros de Auditoría</a>
                </div>
            </div>
        </div>
    </div>
</div>