@model List<Entidades.DetallePedido>

@{
    ViewData["Title"] = "Ticket de Pedido";
    // Calculamos el total sumando el subtotal de cada línea (Ajusta las propiedades si es necesario)
    decimal totalPedido = Model != null && Model.Any() ? Model.Sum(d => d.CANTIDAD * d.PRECIO_UNITARIO) : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <h2 class="h3 mb-0" style="color: var(--text-main); font-weight: 700;">Detalle del Pedido</h2>
        <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">Revisión de artículos y totales</p>
    </div>

    <div>
        <a href="javascript:history.back()" class="btn border-0 shadow-sm px-3 py-2 me-2" style="background-color: var(--bg-card); color: var(--text-main); border: 1px solid var(--border-color) !important; font-weight: 600; border-radius: 8px;">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
        <button onclick="window.print()" class="btn border-0 shadow-sm px-3 py-2" style="background-color: #C6C3F2; color: #262628; font-weight: 600; border-radius: 8px; transition: 0.3s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
            <i class="bi bi-printer me-2"></i>Imprimir Ticket
        </button>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center d-print-none" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 8px;">
        <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>
        <div>@ViewBag.Error</div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm mb-4" id="seccionTicket" style="background-color: var(--bg-card); border-radius: 12px; transition: 0.3s;">

            <div class="card-header p-4 text-center" style="background-color: transparent; border-bottom: 2px dashed var(--border-color);">
                <h4 class="fw-bold mb-1" style="color: var(--text-main);">Tu Empresa POS</h4>
                <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">Ticket de Venta / Comprobante</p>
                @if (Model != null && Model.Any())
                {
                    <div class="mt-3 d-inline-block px-3 py-1" style="background-color: var(--bg-main); border-radius: 8px; border: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted); font-size: 0.85rem;">Pedido No.</span>
                        <strong style="color: var(--text-main); font-size: 1.1rem;" class="ms-1">#@Model.First().ID_PEDIDO</strong>
                    </div>
                }
            </div>

            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0" style="color: var(--text-main);">
                        <thead style="border-bottom: 1px solid var(--border-color);">
                            <tr>
                                <th scope="col" class="pb-3 text-uppercase" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Cant.</th>
                                <th scope="col" class="pb-3 text-uppercase" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Descripción</th>
                                <th scope="col" class="pb-3 text-uppercase text-end" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Precio Unit.</th>
                                <th scope="col" class="pb-3 text-uppercase text-end" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Importe</th>
                            </tr>
                        </thead>
                        <tbody style="border-bottom: 2px dashed var(--border-color);">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="py-3 fw-bold" style="color: var(--text-main); width: 10%;">@item.CANTIDAD</td>
                                        <td class="py-3" style="color: var(--text-main); width: 50%;">Producto ID: @item.ID_PRODUCTO</td>
                                        <td class="py-3 text-end" style="color: var(--text-muted); width: 20%;">@item.PRECIO_UNITARIO.ToString("C")</td>
                                        <td class="py-3 text-end fw-bold" style="color: var(--text-main); width: 20%;">@((item.CANTIDAD * item.PRECIO_UNITARIO).ToString("C"))</td>
                                    </tr>
                                }
                            }
                            else if (ViewBag.Error == null)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <i class="bi bi-cart-x fs-2 mb-2 d-block" style="color: var(--text-muted);"></i>
                                        <span style="color: var(--text-main);">No hay detalles para este pedido.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-end mt-4">
                    <div class="col-md-5 col-lg-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span style="color: var(--text-muted);">Subtotal:</span>
                            <span style="color: var(--text-main); font-weight: 500;">@totalPedido.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span style="color: var(--text-muted);">Impuestos (0%):</span>
                            <span style="color: var(--text-main); font-weight: 500;">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between p-3 rounded" style="background-color: var(--bg-main); border: 1px solid var(--border-color);">
                            <span class="fw-bold text-uppercase" style="color: var(--text-main);">Total:</span>
                            <span class="fw-bold fs-5" style="color: #C6C3F2;">@totalPedido.ToString("C")</span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="card-footer text-center py-4" style="background-color: transparent; border-top: none;">
                <p class="mb-0 fw-bold" style="color: var(--text-main);">¡Gracias por tu compra!</p>
                <small style="color: var(--text-muted);">Por favor conserva este ticket para cualquier aclaración o devolución.</small>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos para que al imprimir se vea bien y se oculten cosas innecesarias (menús, botones) */
    @@media print {
        body {
            background-color: white !important;
        }

        .d-print-none {
            display: none !important;
        }
        /* Forzamos colores oscuros para la impresora independientemente del modo oscuro de la app */
        #seccionTicket {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }

            #seccionTicket * {
                color: black !important;
            }
    }
</style>