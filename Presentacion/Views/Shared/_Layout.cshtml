<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YuNet Store</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ==========================================
                   1. PALETA DE COLORES "TECH E-COMMERCE"
                   ========================================== */
        :root {
            --bg-main: #F1F5F9;
            --bg-card: #FFFFFF;
            --text-main: #0F172A;
            --text-muted: #64748B;
            --border-color: #E2E8F0;
            --header-bg: #FFFFFF;
            --hover-bg: #F8FAFC;
            --tech-primary: #2563EB;
            --tech-accent: #06B6D4;
            --tech-glow: rgba(37, 99, 235, 0.2);
        }

        [data-theme="dark"] {
            --bg-main: #0B0F19;
            --bg-card: #151E2E;
            --text-main: #F8FAFC;
            --text-muted: #94A3B8;
            --border-color: #334155;
            --header-bg: #0F172A;
            --hover-bg: #1E293B;
            --tech-primary: #3B82F6;
            --tech-accent: #22D3EE;
            --tech-glow: rgba(34, 211, 238, 0.2);
        }

        html, body {
            height: 100%;
            margin: 0;
            background-color: var(--bg-main) !important;
            color: var(--text-main);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .text-muted {
            color: var(--text-muted) !important;
        }

        /* ==========================================
                   2. HEADER RETRÁCTIL Y ANIMACIONES
                   ========================================== */
        .yunet-header {
            background-color: var(--header-bg) !important;
            border-bottom: 1px solid var(--border-color);
            padding: 0.7rem 1.5rem;
            transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            z-index: 1040;
        }

        .header-hidden {
            transform: translateY(-100%);
        }

        .header-toggle-tab {
            position: fixed;
            top: 75px;
            right: 30px;
            background: var(--tech-primary);
            color: white;
            border: none;
            border-radius: 0 0 8px 8px;
            padding: 2px 15px 5px 15px;
            cursor: pointer;
            z-index: 1039;
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            box-shadow: 0 4px 10px var(--tech-glow);
        }

        .header-hidden ~ .header-toggle-tab {
            top: 0;
            background: var(--tech-accent);
        }

        .click-anim {
            transition: transform 0.15s ease, background-color 0.2s ease, box-shadow 0.2s ease;
        }

            .click-anim:active {
                transform: scale(0.92) !important;
            }

        /* ==========================================
                   3. ESTILOS DE NAVEGACIÓN
                   ========================================== */
        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--text-main) !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-link-btn {
            color: var(--text-main) !important;
            font-weight: 600;
            padding: 0.5rem 1.2rem !important;
            border-radius: 20px;
            margin: 0 0.2rem;
        }

            .nav-link-btn:hover, .nav-item.show .nav-link-btn {
                background-color: var(--hover-bg);
                color: var(--tech-accent) !important;
                box-shadow: 0 0 15px var(--tech-glow);
                transform: translateY(-2px);
            }

        .header-search {
            background-color: var(--hover-bg);
            border-radius: 24px;
            padding: 0.6rem 1.2rem;
            border: 1px solid transparent;
            color: var(--text-main);
            width: 100%;
            transition: all 0.3s ease;
        }

            .header-search:focus {
                outline: none;
                border-color: var(--tech-primary);
                box-shadow: 0 0 0 4px var(--tech-glow);
                background-color: var(--bg-card);
            }

        .user-circle {
            background: linear-gradient(135deg, var(--tech-primary) 0%, var(--tech-accent) 100%);
            color: white;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            cursor: pointer;
        }

        /* Clase extra para el usuario no logueado */
        .user-circle-guest {
            background: var(--text-muted) !important;
        }

        .dropdown-menu {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .dropdown-item {
            color: var(--text-main);
            font-weight: 500;
            padding: 0.7rem 1.2rem;
            transition: 0.2s;
        }

            .dropdown-item:hover {
                background-color: var(--hover-bg);
                color: var(--tech-primary);
            }

        #main-content {
            margin-top: 90px;
            min-height: calc(100vh - 150px);
            transition: margin-top 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        .header-hidden ~ #main-content {
            margin-top: 20px;
        }

        /* ==========================================
                   4. FOOTER
                   ========================================== */
        .footer-link {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.3s ease;
            display: inline-block;
            margin-bottom: 0.5rem;
        }

            .footer-link:hover {
                color: var(--tech-accent);
                transform: translateX(5px);
            }
    </style>
</head>
<body>

    <nav id="yunetHeader" class="navbar navbar-expand-lg fixed-top yunet-header">
        <div class="container-fluid">
            <a class="navbar-brand click-anim" href="@Url.Action("Index", "Home")">
                <i class="bi bi-cpu" style="color: var(--tech-primary); font-size: 1.8rem;"></i>
                <span style="letter-spacing: -0.5px;">YuNet <sup style="color: var(--tech-accent); font-size: 0.7rem;">STORE</sup></span>
            </a>

            <button class="navbar-toggler border-0 click-anim" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <i class="bi bi-grid-3x3-gap-fill fs-2" style="color: var(--tech-primary);"></i>
            </button>

            <div class="collapse navbar-collapse justify-content-center" id="navbarMain">
                <form class="d-none d-lg-flex mx-auto position-relative click-anim" style="flex: 1; max-width: 450px;">
                    <i class="bi bi-search position-absolute" style="top: 50%; left: 15px; transform: translateY(-50%); color: var(--text-muted);"></i>
                    <input type="text" class="header-search ps-5" placeholder="Buscar iPhone, Samsung, accesorios...">
                </form>

                <ul class="navbar-nav mb-2 mb-lg-0 align-items-center gap-1">

                    <li class="nav-item">
                        <a class="nav-link nav-link-btn click-anim" href="@Url.Action("Index", "Home")">
                            <i class="bi bi-house-door me-1 d-lg-none"></i> Inicio
                        </a>
                    </li>

                    @if (!User.Identity.IsAuthenticated || User.IsInRole("Usuario"))
                    {
                        <li class="nav-item">
                            <a class="nav-link nav-link-btn click-anim" href="@Url.Action("Index", "Producto")">
                                <i class="bi bi-shop me-1 d-lg-none"></i> Tienda
                            </a>
                        </li>
                    }

                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Usuario"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-btn click-anim" href="@Url.Action("Index", "Carrito")">
                                    <i class="bi bi-cart3 me-1 d-lg-none"></i> Mi Carrito
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Administrador") || User.IsInRole("Admin") || User.IsInRole("Auditor") || User.IsInRole("Vendedor"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-btn dropdown-toggle click-anim" href="#" role="button" data-bs-toggle="dropdown">
                                    Operaciones
                                </a>
                                <ul class="dropdown-menu border-0 mt-2">
                                    <li><a class="dropdown-item click-anim" href="@Url.Action("Index", "Carrito")"><i class="bi bi-cart3 me-2" style="color: var(--tech-primary);"></i> Punto de Venta</a></li>
                                    <li><a class="dropdown-item click-anim" href="@Url.Action("Index", "Pedido")"><i class="bi bi-receipt me-2" style="color: var(--tech-primary);"></i> Historial Pedidos</a></li>
                                    <li><a class="dropdown-item click-anim" href="@Url.Action("Index", "Devolucion")"><i class="bi bi-arrow-return-left me-2" style="color: var(--tech-primary);"></i> Devoluciones</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-btn dropdown-toggle click-anim" href="#" role="button" data-bs-toggle="dropdown">
                                    Inventario
                                </a>
                                <ul class="dropdown-menu border-0 mt-2">
                                    <li><a class="dropdown-item click-anim" href="@Url.Action("Index", "Producto")"><i class="bi bi-phone me-2" style="color: var(--tech-accent);"></i> Productos</a></li>
                                    <li><a class="dropdown-item click-anim" href="@Url.Action("Index", "Marca")"><i class="bi bi-award me-2" style="color: var(--tech-accent);"></i> Marcas</a></li>

                                    @if (User.IsInRole("Administrador") || User.IsInRole("Admin") || User.IsInRole("Auditor"))
                                    {
                                        <li><a class="dropdown-item click-anim" href="@Url.Action("Index", "Categoria")"><i class="bi bi-tags me-2" style="color: var(--tech-accent);"></i> Categorías</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    }
                </ul>
            </div>

            <div class="d-flex align-items-center gap-3 ms-lg-3 mt-3 mt-lg-0">
                <button id="themeToggleBtn" class="btn btn-link text-decoration-none click-anim" style="color: var(--text-muted); font-size: 1.2rem;">
                    <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                </button>

                @{
                    bool isLogged = User.Identity?.IsAuthenticated ?? false;
                    string userName = isLogged ? (User.Identity.Name ?? "Usuario") : "Invitado";
                    string userRole = isLogged ? (User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Rol") : "Sesión no iniciada";
                    string inicial = isLogged && !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "?";
                    string circleClass = isLogged ? "user-circle shadow" : "user-circle user-circle-guest shadow";
                }

                <div class="dropdown">
                    <div class="d-flex align-items-center gap-2 click-anim" role="button" data-bs-toggle="dropdown">
                        <div class="d-none d-md-block text-end">
                            <div class="fw-bold lh-1" style="font-size: 0.95rem;">@userName</div>
                            <small style="color: var(--tech-accent); font-size: 0.75rem; font-weight: bold;">@userRole</small>
                        </div>
                        <div class="@circleClass">@inicial</div>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end border-0 mt-3">
                        @if (isLogged)
                        {
                            <li><a class="dropdown-item py-2 click-anim" href="#"><i class="bi bi-person me-2 text-muted"></i> Mi Perfil</a></li>
                            <li><hr class="dropdown-divider border-secondary"></li>
                            <li><a class="dropdown-item py-2 text-danger fw-bold click-anim" href="@Url.Action("Salir", "Home")"><i class="bi bi-power me-2"></i> Salir</a></li>
                        }
                        else
                        {
                            <li><a class="dropdown-item py-2 text-primary fw-bold click-anim" href="@Url.Action("Index", "Login")"><i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión</a></li>
                        }
                    </ul>
                </div>

            </div>
        </div>
    </nav>

    <button id="toggleHeaderBtn" class="header-toggle-tab click-anim" title="Ocultar/Mostrar Menú">
        <i class="bi bi-chevron-up" id="toggleHeaderIcon"></i>
    </button>

    <div id="main-content">
        @RenderBody()
    </div>

    <footer class="py-5 mt-5 border-top" style="border-color: var(--border-color) !important; background-color: var(--bg-card);">
        <div class="container">
            <div class="row mb-4">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <h4 class="fw-bold mb-3 d-flex align-items-center" style="color: var(--text-main);">
                        <i class="bi bi-cpu me-2" style="color: var(--tech-primary);"></i>YuNet Store
                    </h4>
                    <p class="text-muted pe-lg-4">La tienda de tecnología líder en el mercado. Descubre lo último en innovación, calidad y servicio.</p>
                </div>
            </div>
            <hr class="mb-4" style="border-color: var(--border-color);">
            <div class="text-center">
                <h6 class="fw-bold mb-1" style="color: var(--tech-primary);">YuNet Store POS</h6>
                <small class="text-muted">&copy; @DateTime.Now.Year - Sistema de Gestión de Ventas Inteligente</small>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Lógica del Cambio de Tema
            const themeToggleBtn = document.getElementById('themeToggleBtn');
            const themeIcon = document.getElementById('themeIcon');
            const htmlEl = document.documentElement;

            const savedTheme = localStorage.getItem('yunet_theme') || 'dark';
            htmlEl.setAttribute('data-theme', savedTheme);
            updateIcon(savedTheme);

            themeToggleBtn.addEventListener('click', () => {
                const currentTheme = htmlEl.getAttribute('data-theme');
                const newTheme = currentTheme === 'light' ? 'dark' : 'light';
                htmlEl.setAttribute('data-theme', newTheme);
                localStorage.setItem('yunet_theme', newTheme);
                updateIcon(newTheme);
            });

            function updateIcon(theme) {
                if(theme === 'dark') {
                    themeIcon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
                    themeIcon.style.color = 'var(--tech-accent)';
                } else {
                    themeIcon.classList.replace('bi-sun-fill', 'bi-moon-stars-fill');
                    themeIcon.style.color = 'var(--text-muted)';
                }
            }

            // Lógica del Header Retráctil
            const header = document.getElementById('yunetHeader');
            const toggleHeaderBtn = document.getElementById('toggleHeaderBtn');
            const toggleHeaderIcon = document.getElementById('toggleHeaderIcon');

            let headerIsHidden = localStorage.getItem('yunet_header_hidden') === 'true';

            if (headerIsHidden) {
                header.classList.add('header-hidden');
                toggleHeaderIcon.classList.replace('bi-chevron-up', 'bi-chevron-down');
            }

            toggleHeaderBtn.addEventListener('click', () => {
                header.classList.toggle('header-hidden');
                headerIsHidden = header.classList.contains('header-hidden');

                if (headerIsHidden) {
                    toggleHeaderIcon.classList.replace('bi-chevron-up', 'bi-chevron-down');
                } else {
                    toggleHeaderIcon.classList.replace('bi-chevron-down', 'bi-chevron-up');
                }

                localStorage.setItem('yunet_header_hidden', headerIsHidden);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>