@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YuNet</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --bg-main: #f4f6f9;
            --bg-card: #ffffff;
            --text-main: #262628;
            --text-muted: #6c757d;
            --border-color: #e3e6f0;
        }

        [data-theme="dark"] {
            --bg-main: #18181b;
            --bg-card: #27272a;
            --text-main: #e4e4e7;
            --text-muted: #a1a1aa;
            --border-color: #3f3f46;
        }

        html, body {
            height: 100%;
            margin: 0;
            background-color: var(--bg-main) !important;
            color: var(--text-main);
        }

        body {
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .card, .bg-white {
            background-color: var(--bg-card) !important;
            border-color: var(--border-color) !important;
            color: var(--text-main);
            transition: 0.3s;
        }

        .topbar {
            background-color: var(--bg-card) !important;
            transition: 0.3s;
        }

        .text-dark {
            color: var(--text-main) !important;
        }

        .text-muted {
            color: var(--text-muted) !important;
        }

        #wrapper {
            display: flex;
            min-height: 100vh;
        }

        #content-wrapper {
            display: flex;
            flex-direction: column;
            width: 100%;
            overflow-x: hidden;
        }

        .sidebar {
            background-color: #262628 !important;
            min-width: 250px;
            max-width: 250px;
            transition: all 0.3s ease;
            height: 100vh;
            position: sticky;
            top: 0;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            scrollbar-width: none;
        }

            .sidebar::-webkit-scrollbar {
                display: none;
            }

            .sidebar.toggled {
                min-width: 85px !important;
                max-width: 85px !important;
                text-align: center;
            }

                .sidebar.toggled .nav-item span,
                .sidebar.toggled .sidebar-brand-text,
                .sidebar.toggled .sidebar-heading {
                    display: none !important;
                }

                .sidebar.toggled .collapse {
                    display: none !important;
                }

            .sidebar .nav-link {
                color: #a1a1a5 !important;
                transition: 0.2s;
            }

                .sidebar .nav-link i {
                    color: #a1a1a5 !important;
                    transition: 0.2s;
                    font-size: 1.1rem;
                }

                .sidebar .nav-link:hover, .sidebar .nav-item.active .nav-link {
                    color: #C6C3F2 !important;
                    background-color: rgba(198, 195, 242, 0.05);
                    border-right: 3px solid #C6C3F2;
                }

                    .sidebar .nav-link:hover i, .sidebar .nav-item.active .nav-link i {
                        color: #C6C3F2 !important;
                    }

        .topbar {
            height: 4.375rem;
            border-bottom: 1px solid var(--border-color);
        }

        .user-circle {
            background-color: #C6C3F2;
            color: #262628;
            width: 36px;
            height: 36px;
            font-weight: 800;
        }

        .btn-theme-toggle {
            background-color: var(--bg-main);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.3s;
        }
    </style>
</head>
<body>
    <div id="wrapper">
        <ul class="navbar-nav sidebar accordion py-3" id="accordionSidebar">
            <li class="nav-item mb-4 mt-2">
                <a class="sidebar-brand d-flex align-items-center justify-content-center text-decoration-none" href="@Url.Action("Index", "Home")">
                    <div class="sidebar-brand-icon"><i class="bi bi-boxes" style="color: #C6C3F2; font-size: 1.8rem;"></i></div>
                    <div class="sidebar-brand-text mx-3 text-white fw-bold fs-5">YuNet <sup style="color: #C6C3F2;">POS</sup></div>
                </a>
            </li>

            @* --- MENÚ DINÁMICO SEGÚN ROL --- *@
            @{
                var rol = Context.Session.GetString("Rol") ?? "Cliente";
            }

            @if (rol == "Admin")
            {
                <li class="nav-item">
                    <a class="nav-link px-4 py-3" href="@Url.Action("Index", "Home")"><i class="bi bi-grid-1x2-fill me-3"></i><span>Dashboard</span></a>
                </li>

                <div class="sidebar-heading mt-3 mb-2 px-4" style="font-size: 0.7rem; color: #6c6c70; letter-spacing: 1px; text-transform: uppercase;">Operaciones</div>

                <li class="nav-item">
                    <a class="nav-link collapsed px-4 py-2" href="#" data-bs-toggle="collapse" data-bs-target="#collapseVentas">
                        <i class="bi bi-cart3 me-3"></i><span>Ventas</span>
                    </a>
                    <div id="collapseVentas" class="collapse" data-bs-parent="#accordionSidebar">
                        <div class="py-2 collapse-inner rounded shadow-sm mx-3 mb-2 mt-1" style="background-color: var(--bg-card);">
                            <a class="collapse-item text-decoration-none d-block px-4 py-2" style="color: var(--text-main);" asp-controller="Carrito" asp-action="Index">Punto de Venta</a>
                            <a class="collapse-item text-decoration-none d-block px-4 py-2" style="color: var(--text-main);" asp-controller="Pedido" asp-action="Index">Pedidos</a>
                        </div>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link collapsed px-4 py-2" href="#" data-bs-toggle="collapse" data-bs-target="#collapseInventario">
                        <i class="bi bi-box-seam me-3"></i><span>Inventario</span>
                    </a>
                    <div id="collapseInventario" class="collapse" data-bs-parent="#accordionSidebar">
                        <div class="py-2 collapse-inner rounded shadow-sm mx-3 mb-2 mt-1" style="background-color: var(--bg-card);">
                            <a class="collapse-item text-decoration-none d-block px-4 py-2" style="color: var(--text-main);" href="@Url.Action("Index", "Producto")">Catálogo</a>
                            <a class="collapse-item text-decoration-none d-block px-4 py-2" style="color: var(--text-main);" href="@Url.Action("Index", "Inventario")">Existencias</a>
                        </div>
                    </div>
                </li>

                <div class="sidebar-heading mt-4 mb-2 px-4" style="font-size: 0.7rem; color: #6c6c70; letter-spacing: 1px; text-transform: uppercase;">Administración</div>
                <li class="nav-item">
                    <a class="nav-link px-4 py-2" href="@Url.Action("Index", "Usuarios")"><i class="bi bi-people me-3"></i><span>Usuarios</span></a>
                </li>
            }
            else
            {
                @* --- VISTA CLIENTE (SINSA STYLE) --- *@
                <div class="sidebar-heading mt-3 mb-2 px-4" style="font-size: 0.7rem; color: #6c6c70; letter-spacing: 1px; text-transform: uppercase;">Menú Cliente</div>
                <li class="nav-item">
                    <a class="nav-link px-4 py-3" href="@Url.Action("Catalogo", "Tienda")">
                        <i class="bi bi-shop me-3"></i><span>Ir a la Tienda</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-4 py-3" href="#">
                        <i class="bi bi-bag-check me-3"></i><span>Mis Pedidos</span>
                    </a>
                </li>
            }

            <div class="text-center mt-auto mb-4 d-none d-md-inline pt-5">
                <button class="rounded-circle border-0 d-flex align-items-center justify-content-center mx-auto" id="sidebarToggle" style="background-color: rgba(255,255,255,0.1); width: 40px; height: 40px; color: #C6C3F2;">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>
        </ul>

        <div id="content-wrapper">
            <nav class="navbar navbar-expand topbar mb-4 shadow-sm px-4">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item me-4">
                        <button id="themeToggleBtn" class="btn-theme-toggle">
                            <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                        </button>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                            <div class="d-flex flex-column text-end me-3 d-none d-lg-flex" style="color: var(--text-main);">
                                <span class="fw-bold" style="font-size: 0.9rem;">@(Context.Session.GetString("UsuarioNombre") ?? "Invitado")</span>
                                <span class="text-muted" style="font-size: 0.75rem;">@rol</span>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center user-circle shadow-sm">
                                @((Context.Session.GetString("UsuarioNombre") ?? "U").Substring(0, 1).ToUpper())
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="background-color: var(--bg-card);">
                            <li><a class="dropdown-item py-2" style="color: var(--text-main);" href="#"><i class="bi bi-person me-2"></i> Mi Perfil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2 text-danger" href="@Url.Action("Salir", "Home")"><i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión</a></li>
                        </ul>
                    </li>
                </ul>
            </nav>

            <div class="container-fluid px-4 pb-4">
                @RenderBody()
            </div>

            <footer class="sticky-footer mt-auto py-3 shadow-sm border-top" style="background-color: var(--bg-card);">
                <div class="container my-auto text-center text-muted" style="font-size: 0.85rem;">
                    <span>&copy; 2026 - YuNet Sistema de Inventario y POS</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Sidebar Toggle
            document.querySelector('#sidebarToggle').addEventListener('click', () => {
                document.querySelector('.sidebar').classList.toggle('toggled');
            });

            // Theme Toggle
            const themeBtn = document.getElementById('themeToggleBtn');
            const html = document.documentElement;
            themeBtn.addEventListener('click', () => {
                const theme = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
                html.setAttribute('data-theme', theme);
                localStorage.setItem('yunet_theme', theme);
            });

            const savedTheme = localStorage.getItem('yunet_theme') || 'light';
            html.setAttribute('data-theme', savedTheme);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>