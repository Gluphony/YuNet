@{
    ViewData["Title"] = "¡Compra Exitosa!";
    // Recibimos el ID del pedido que enviamos desde el controlador
    int idPedido = ViewBag.IdPedido != null ? (int)ViewBag.IdPedido : 0;
}

<style>
    /* ==========================================
           ESTILOS DE LA VISTA DE ÉXITO (TECH THEME)
           ========================================== */
    .success-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .success-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        max-width: 550px;
        width: 100%;
        margin: 0 auto;
        padding: 3.5rem 2rem;
        position: relative;
        overflow: hidden;
        text-align: center;
        transition: box-shadow 0.3s ease;
    }

    [data-theme="dark"] .success-card {
        box-shadow: 0 10px 40px rgba(0,0,0,0.4);
        border: 1px solid rgba(255,255,255,0.05);
    }

    /* Brillo superior en la tarjeta */
    .success-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--tech-primary) 0%, var(--tech-accent) 100%);
        box-shadow: 0 0 15px var(--tech-glow);
    }

    .success-icon-wrapper {
        width: 110px;
        height: 110px;
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.15) 0%, rgba(59, 130, 246, 0.15) 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem auto;
        border: 2px solid var(--tech-primary);
        box-shadow: 0 0 25px rgba(6, 182, 212, 0.3);
        animation: pulse-glow 2s infinite;
    }

    .success-icon {
        font-size: 3.5rem;
        background: linear-gradient(135deg, var(--tech-primary) 0%, var(--tech-accent) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .order-number-box {
        background-color: var(--hover-bg);
        border: 1px dashed var(--border-color);
        border-radius: 12px;
        padding: 1.5rem;
        margin: 2rem 0;
    }

    .order-number {
        font-size: 2.8rem;
        font-weight: 800;
        color: var(--text-main);
        letter-spacing: 2px;
        margin: 0;
        text-shadow: 0 0 10px rgba(59, 130, 246, 0.2);
    }

    .btn-tech-primary {
        background: linear-gradient(135deg, var(--tech-primary) 0%, var(--tech-accent) 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 1rem 2.5rem;
        font-weight: 600;
        font-size: 1.1rem;
        transition: transform 0.2s, box-shadow 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-tech-primary:hover {
            box-shadow: 0 8px 25px var(--tech-glow);
            color: white;
            transform: translateY(-2px);
        }

    @@keyframes pulse-glow {
        0%

    {
        box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.4);
    }

    70% {
        box-shadow: 0 0 0 20px rgba(6, 182, 212, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(6, 182, 212, 0);
    }

    }
</style>

<div class="container py-5 success-container">
    <div class="success-card">

        <div class="success-icon-wrapper">
            <i class="bi bi-check-lg success-icon"></i>
        </div>

        <h2 class="fw-bold mb-3" style="color: var(--text-main);">¡Tu pedido está confirmado!</h2>
        <p style="color: var(--text-muted); font-size: 1.1rem;">
            Gracias por tu compra. Hemos recibido tu orden y ya comenzamos a procesarla.
        </p>

        <div class="order-number-box">
            <p class="mb-1 text-uppercase fw-bold" style="color: var(--text-muted); font-size: 0.85rem; letter-spacing: 1px;">
                NÚMERO DE ORDEN
            </p>
            <h1 class="order-number">
                @if (idPedido > 0)
                {
                    <text>#@idPedido.ToString("D5")</text>
                }
                else
                {
                    <text>#ERROR</text>
                }
            </h1>
        </div>

        <p class="mb-4" style="color: var(--text-muted);">
            Te enviaremos una notificación cuando tus productos estén listos para ser entregados.
        </p>

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4">
            <a href="@Url.Action("Index", "Producto")" class="btn btn-tech-primary click-anim">
                <i class="bi bi-cart-plus me-2"></i> Seguir Comprando
            </a>
            <a href="@Url.Action("Historial", "Pedido")" class="btn btn-outline-info" style="border-radius: 12px; padding: 1rem 2rem;">
                <i class="bi bi-receipt me-2"></i> Ver mis Pedidos
            </a>
        </div>
