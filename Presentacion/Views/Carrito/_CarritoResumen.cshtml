@model List<Entidades.DetalleCarrito>

<div class="cart-items-list">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="d-flex align-items-center p-3 mb-2 rounded-3" style="background-color: var(--hover-bg); border: 1px solid var(--border-color);">
                <div class="flex-shrink-0 bg-primary bg-opacity-10 p-2 rounded">
                    <i class="bi bi-phone text-primary fs-4"></i>
                </div>

                <div class="flex-grow-1 ms-3">
                    <h6 class="mb-0 fw-bold" style="font-size: 0.9rem; color: var(--text-main);">@item.NOMBRE_PRODUCTO</h6>
                    <small class="text-muted">@item.CANTIDAD x C$ @item.PRECIO_UNITARIO.ToString("N2")</small>
                </div>

                <div class="text-end">
                    <div class="fw-bold text-primary mb-1" style="font-size: 0.85rem;">
                        C$ @((item.CANTIDAD * item.PRECIO_UNITARIO).ToString("N2"))
                    </div>
                    <button class="btn btn-sm p-0 text-danger opacity-75 click-anim"
                            onclick="eliminarItemRapido(@item.ID_DETALLE)">
                        <i class="bi bi-trash3"></i>
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x fs-1 text-muted opacity-25"></i>
            <p class="mt-3 text-muted">No hay productos aún</p>
        </div>
    }
</div>

<script>
    // Función extra para eliminar desde el lateral
    function eliminarItemRapido(id) {
        if(confirm('¿Quitar del carrito?')) {
            fetch('/DetalleCarrito/EliminarSimple/' + id, { method: 'POST' })
                .then(() => actualizarInterfazCarrito());
        }
    }
</script>