@model Entidades.Carrito
@{
    ViewData["Title"] = "Mi Carrito de Compras";
    // Extraemos la lista generada por tu LogicaDetalleCarrito
    var detalles = ViewBag.ListaDetalles as List<Entidades.DetalleCarrito> ?? new List<Entidades.DetalleCarrito>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-cart3 text-primary me-2"></i>Tu Carrito</h3>
        <p class="text-muted mb-0">Revisa los artículos antes de procesar tu pedido</p>
    </div>
    <a href="/Producto/Catalogo" class="btn btn-outline-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Seguir Comprando
    </a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom text-secondary fw-bold">
                Productos Seleccionados (@detalles.Count)
            </div>

            <div class="card-body p-0">
                @if (detalles.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
                        <h4 class="mt-3 text-muted">El carrito está vacío</h4>
                        <p class="text-secondary">¡Anímate a agregar algunos productos!</p>
                        <a href="/Producto/Catalogo" class="btn btn-primary mt-2">Ir al Catálogo</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small">
                                <tr>
                                    <th class="ps-4">Producto</th>
                                    <th>Precio</th>
                                    <th class="text-center">Cantidad</th>
                                    <th>Subtotal</th>
                                    <th class="text-center pe-4">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in detalles)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">@item.NOMBRE_PRODUCTO</td>

                                        <td>$@item.PRECIO_UNITARIO.ToString("0.00")</td>

                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border px-3 py-2">@item.CANTIDAD</span>
                                        </td>

                                        <td class="fw-bold text-primary">$@item.SUBTOTAL.ToString("0.00")</td>

                                        <td class="text-center pe-4">
                                            <form action="/DetalleCarrito/Eliminar" method="post" onsubmit="return confirm('¿Seguro que deseas quitar este producto?');">
                                                <input type="hidden" name="idDetalle" value="@item.ID_DETALLE" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Quitar producto">
                                                    <i class="bi bi-trash3-fill"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (detalles.Count > 0)
            {
                <div class="card-footer bg-white text-end py-3 border-top">
                    <form action="/Carrito/Vaciar" method="post" onsubmit="return confirm('¿Estás seguro de vaciar TODO el carrito? Esta acción no se puede deshacer.');">
                        <input type="hidden" name="idCarrito" value="@Model.ID_CARRITO" />
                        <button type="submit" class="btn btn-sm btn-outline-danger shadow-sm">
                            <i class="bi bi-eraser me-1"></i> Vaciar Carrito
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 border-top border-4 border-success h-100">
            <div class="card-header bg-white py-3 border-bottom text-secondary fw-bold">
                Resumen de Compra
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-3 text-secondary">
                    <span>N° Orden:</span>
                    <span class="fw-bold text-dark">#@Model.ID_CARRITO.ToString("D5")</span>
                </div>
                <div class="d-flex justify-content-between mb-3 text-secondary">
                    <span>Estado:</span>
                    <span class="badge bg-warning text-dark px-2 py-1">@Model.ESTADO</span>
                </div>

                <hr class="text-muted border-dashed my-4">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fw-bold h5 mb-0 text-dark">TOTAL PAGAR:</span>
                    <span class="fw-bold h2 mb-0 text-success">$@Model.TOTAL.ToString("0.00")</span>
                </div>

                <form action="/Carrito/CambiarEstado" method="post">
                    <input type="hidden" name="idCarrito" value="@Model.ID_CARRITO" />
                    <input type="hidden" name="nuevoEstado" value="COMPLETADO" />

                    <button type="submit" class="btn btn-success w-100 py-3 fw-bold shadow-sm" @(detalles.Count == 0 ? "disabled" : "")>
                        <i class="bi bi-credit-card me-2"></i> CONFIRMAR COMPRA
                    </button>
                </form>

                <div class="text-center mt-3">
                    <small class="text-muted">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> Transacción 100% segura
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>