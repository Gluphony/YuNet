@model Entidades.Carrito

@{
    ViewData["Title"] = User.IsInRole("Administrador") ? "Crear Pedido Manual" : "Mi Carrito";
    var detalles = ViewBag.ListaDetalles as List<Entidades.DetalleCarrito> ?? new List<Entidades.DetalleCarrito>();

    // OJO AQUÍ: Necesitamos que tu controlador envíe los productos disponibles
    var productosDisponibles = ViewBag.ProductosDisponibles as List<Entidades.Producto> ?? new List<Entidades.Producto>();
}

<style>
    .admin-panel {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.5rem;
    }

    .table-dark-custom {
        color: var(--text-main);
    }

        .table-dark-custom th {
            color: var(--neon-blue-base);
            border-bottom: 2px solid var(--border-color);
        }

        .table-dark-custom td {
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
        }

    .btn-agregar {
        background-color: var(--neon-blue-tint);
        color: var(--neon-blue-base);
        border: 1px solid var(--neon-blue-base);
    }

        .btn-agregar:hover {
            background-color: var(--neon-blue-base);
            color: #000;
        }
</style>

<div class="container-fluid py-4" style="color: var(--text-main);">

    @if (User.IsInRole("Administrador"))
    {
        <h2 class="h3 fw-bold mb-4" style="color: var(--neon-blue-base);">
            <i class="bi bi-person-lines-fill me-2"></i> Crear Pedido para Cliente
        </h2>

        <div class="row g-4">
            <div class="col-lg-7">

                <div class="admin-panel mb-4 shadow-sm">
                    <h5 class="fw-bold mb-3">1. Seleccionar Cliente</h5>
                    <div class="d-flex gap-2">
                        <select class="form-select" id="selectClienteAdmin" style="background-color: var(--bg-main); color: var(--text-main); border-color: var(--border-color);">
                            <option value="">-- Buscar y seleccionar cliente --</option>
                            <option value="1">Carlos (ID: 1)</option>
                            <option value="2">María (ID: 2)</option>
                        </select>
                        <button class="btn btn-outline-info">Fijar Cliente</button>
                    </div>
                </div>

                <div class="admin-panel shadow-sm">
                    <h5 class="fw-bold mb-3">2. Agregar Productos</h5>

                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-dark-custom">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Stock</th>
                                    <th>Precio</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (productosDisponibles.Any())
                                {
                                    foreach (var prod in productosDisponibles)
                                    {
                                        <tr>
                                            <td class="fw-bold">@prod.NOMBRE</td>
                                            <td>@prod.STOCK</td>
                                            <td>C$ @prod.PRECIO.ToString("N2")</td>
                                            <td class="text-end">
                                                <form action="/Carrito/AgregarAdmin" method="post" class="d-flex justify-content-end gap-2">
                                                    <input type="hidden" name="idProducto" value="@prod.ID_PRODUCTO" />
                                                    <input type="number" name="cantidad" value="1" min="1" max="@prod.STOCK" class="form-control form-control-sm" style="width: 70px; background-color: var(--bg-main); color: white;">
                                                    <button type="submit" class="btn btn-sm btn-agregar click-anim">Agregar</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            <i class="bi bi-box-seam fs-3 d-block mb-2"></i>
                                            El catálogo está vacío. El controlador debe enviar ViewBag.ProductosDisponibles.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="admin-panel shadow-sm h-100 d-flex flex-column">
                    <h5 class="fw-bold mb-3" style="color: var(--neon-green);">
                        <i class="bi bi-cart-check me-2"></i> Pedido Actual
                    </h5>

                    <div class="flex-grow-1">
                        @if (detalles.Count > 0)
                        {
                            <ul class="list-group list-group-flush mb-3">
                                @foreach (var item in detalles)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center" style="background-color: transparent; border-color: var(--border-color); color: var(--text-main);">
                                        <div>
                                            <div class="fw-bold">@item.NOMBRE_PRODUCTO</div>
                                            <small class="text-muted">@item.CANTIDAD x C$ @item.PRECIO_UNITARIO</small>
                                        </div>
                                        <span class="fw-bold text-info">C$ @((item.CANTIDAD * item.PRECIO_UNITARIO).ToString("N2"))</span>
                                        <form action="/DetalleCarrito/Eliminar" method="post">
                                            <input type="hidden" name="idDetalle" value="@item.ID_DETALLE" />
                                            <button class="btn btn-sm text-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                Aún no has agregado productos al pedido de este cliente.
                            </div>
                        }
                    </div>

                    <hr style="border-color: var(--border-color);" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5">Total a Cobrar:</span>
                        <span class="fs-3 fw-bold" style="color: var(--neon-blue-base);">C$ @Model.TOTAL.ToString("N2")</span>
                    </div>

                    @if (detalles.Count > 0)
                    {
                        <form action="/Carrito/ProcesarCompraAdmin" method="post">
                            <input type="hidden" name="idClienteReal" id="idClienteRealHidden" value="" required />
                            <select name="idMetodoPago" class="form-select mb-3" style="background-color: var(--bg-main); color: var(--text-main);">
                                <option value="1">Efectivo</option>
                                <option value="2">Transferencia</option>
                            </select>
                            <button type="submit" class="btn w-100 py-3 fw-bold fs-5" style="background-color: var(--neon-blue-base); color: black;">
                                Generar Pedido
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h3>Vista del Cliente</h3>
            <p>Aquí se mantiene tu diseño original del carrito para usuarios normales.</p>
        </div>
    }
</div>