@model Entidades.Carrito

@{
    ViewData["Title"] = "Mi Carrito de Compras";

    // Extraemos la lista que mandaste por el ViewBag en tu controlador
    // Nota: Revisa que Entidades.DetalleCarrito sea el nombre correcto de tu clase
    var detalles = ViewBag.ListaDetalles as List<Entidades.DetalleCarrito> ?? new List<Entidades.DetalleCarrito>();
}

<style>
    /* Estilos del sistema YuNet */
    .stat-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
        transition: transform 0.2s;
    }

    .border-left-primary {
        border-left: 0.25rem solid #0d6efd !important;
    }

    .border-left-success {
        border-left: 0.25rem solid #198754 !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark">Carrito de Compras</h3>
        <p class="text-muted mb-0">Orden #@Model.ID_CARRITO creada el @Model.FECHA_CREACION.ToString("dd/MM/yyyy")</p>
    </div>
    <a href="@Url.Action("Index", "Producto")" class="btn btn-outline-secondary shadow-sm">
    <i class="bi bi-arrow-left me-1"></i> Seguir Comprando
</a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success shadow-sm alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger shadow-sm alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-xl-8 col-lg-7 mb-4">
        <div class="card stat-card border-left-primary h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-primary"><i class="bi bi-cart3 me-2"></i>Artículos Seleccionados</h6>

                @if (detalles.Count > 0)
                {
                    <form action="/Carrito/Vaciar" method="post" class="m-0">
                        <input type="hidden" name="idCarrito" value="@Model.ID_CARRITO" />
                        <button type="submit" class="btn btn-sm btn-outline-danger shadow-sm" onclick="return confirm('¿Estás seguro de vaciar todo el carrito?');">
                            <i class="bi bi-trash3 me-1"></i> Vaciar Carrito
                        </button>
                    </form>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted" style="font-size: 0.85rem; text-transform: uppercase;">
                            <tr>
                                <th class="ps-4 border-0">Producto</th>
                                <th class="border-0 text-center">Precio</th>
                                <th class="border-0 text-center">Cantidad</th>
                                <th class="border-0 text-center">Subtotal</th>
                                <th class="pe-4 border-0 text-end">Quitar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (detalles.Count > 0)
                            {
                                foreach (var item in detalles)
                                {
                                    // IMPORTANTE: Asegúrate de que estos nombres (CANTIDAD, PRECIO_UNITARIO) coincidan con tu clase DetalleCarrito
                                    decimal subtotal = item.CANTIDAD * item.PRECIO_UNITARIO;

                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">@item.NOMBRE_PRODUCTO</td>
                                        <td class="text-center">C$ @item.PRECIO_UNITARIO.ToString("N2")</td>
                                        <td class="text-center"><span class="badge bg-secondary">@item.CANTIDAD</span></td>
                                        <td class="text-center fw-bold text-success">C$ @subtotal.ToString("N2")</td>
                                        <td class="pe-4 text-end">
                                            <form action="/DetalleCarrito/Eliminar" method="post" class="d-inline">
                                                <input type="hidden" name="idDetalle" value="@item.ID_DETALLE" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger shadow-sm" title="Quitar">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="bi bi-cart-x fs-1 d-block mb-2 text-black-50"></i>
                                        Tu carrito está vacío.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-lg-5 mb-4">
        <div class="card stat-card border-left-success h-100">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-success"><i class="bi bi-receipt me-2"></i>Resumen de Orden</h6>
            </div>
            <div class="card-body d-flex flex-column">

                <div class="d-flex justify-content-between mb-3 text-muted">
                    <span>Estado Actual:</span>
                    <span class="badge bg-info text-dark">@(string.IsNullOrEmpty(Model.ESTADO) ? "PENDIENTE" : Model.ESTADO)</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between mb-4">
                    <span class="fs-5 fw-bold text-dark">Total a Pagar:</span>
                    <span class="fs-5 fw-bold text-success">C$ @Model.TOTAL.ToString("N2")</span>
                </div>

                <div class="mt-auto">
                    @if (detalles.Count > 0)
                    {
                        <form action="/Carrito/CambiarEstado" method="post">
                            <input type="hidden" name="idCarrito" value="@Model.ID_CARRITO" />
                            <input type="hidden" name="nuevoEstado" value="COMPLETADO" />
                            <button type="submit" class="btn btn-success w-100 shadow-sm py-2 fw-bold">
                                <i class="bi bi-credit-card me-1"></i> Procesar Compra
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100 shadow-sm py-2 fw-bold" disabled>
                            <i class="bi bi-cart-x me-1"></i> Carrito Vacío
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>