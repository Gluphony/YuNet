@model Entidades.Carrito

@{
    ViewData["Title"] = "Mi Carrito de Compras";
    var detalles = ViewBag.ListaDetalles as List<Entidades.DetalleCarrito> ?? new List<Entidades.DetalleCarrito>();
}

<style>
    /* ==========================================
               ESTILOS ESPECÍFICOS DEL CARRITO TECH
               ========================================== */
    .cart-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        transition: transform 0.2s, box-shadow 0.2s;
        overflow: hidden;
    }

    [data-theme="dark"] .cart-card {
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }

    .cart-card-header {
        background-color: var(--hover-bg);
        border-bottom: 1px solid var(--border-color);
        padding: 1.2rem 1.5rem;
    }

    /* Tabla Adaptable al Tema */
    .table-cart {
        margin-bottom: 0;
        color: var(--text-main);
    }

        .table-cart th {
            background-color: var(--hover-bg);
            color: var(--text-muted);
            border-bottom: 2px solid var(--border-color);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            padding: 1rem;
        }

        .table-cart td {
            background-color: var(--bg-card);
            color: var(--text-main);
            border-bottom: 1px solid var(--border-color);
            padding: 1.2rem 1rem;
            vertical-align: middle;
            transition: background-color 0.2s;
        }

        .table-cart tr:hover td {
            background-color: var(--hover-bg);
        }

        .table-cart tr:last-child td {
            border-bottom: none;
        }

    /* Botones y Badges Personalizados */
    .btn-tech-outline {
        color: var(--text-main);
        border: 1px solid var(--border-color);
        background: transparent;
    }

        .btn-tech-outline:hover {
            border-color: var(--tech-primary);
            color: var(--tech-primary);
            background-color: var(--hover-bg);
        }

    .btn-checkout {
        background: linear-gradient(135deg, var(--tech-primary) 0%, var(--tech-accent) 100%);
        color: white;
        border: none;
        border-radius: 12px;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-checkout:hover {
            box-shadow: 0 8px 25px var(--tech-glow);
            color: white;
        }

    .price-text {
        color: var(--tech-primary);
        font-weight: 700;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--text-main);">Carrito de Compras</h3>
            <p class="mb-0" style="color: var(--text-muted);">
                Orden #<span class="fw-bold" style="color: var(--tech-accent);">@Model.ID_CARRITO</span>
                creada el @Model.FECHA_CREACION.ToString("dd/MM/yyyy")
            </p>
        </div>
        <a href="@Url.Action("Index", "Producto")" class="btn btn-tech-outline rounded-pill px-4 py-2 click-anim shadow-sm">
            <i class="bi bi-arrow-left me-2"></i> Seguir Comprando
        </a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert border-0 border-start border-4 border-success shadow-sm alert-dismissible fade show" style="background-color: var(--bg-card); color: var(--text-main);">
            <i class="bi bi-check-circle-fill text-success me-2 fs-5 align-middle"></i>
            <span class="align-middle">@TempData["MensajeExito"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" style="filter: var(--bs-btn-close-color);"></button>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert border-0 border-start border-4 border-danger shadow-sm alert-dismissible fade show" style="background-color: var(--bg-card); color: var(--text-main);">
            <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-5 align-middle"></i>
            <span class="align-middle">@TempData["MensajeError"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" style="filter: var(--bs-btn-close-color);"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-xl-8 col-lg-7">
            <div class="cart-card h-100">
                <div class="cart-card-header d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold" style="color: var(--text-main);">
                        <i class="bi bi-box-seam me-2" style="color: var(--tech-primary);"></i>Artículos Seleccionados
                    </h6>

                    @if (detalles.Count > 0)
                    {
                        <form action="/Carrito/Vaciar" method="post" class="m-0">
                            <input type="hidden" name="idCarrito" value="@Model.ID_CARRITO" />
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 click-anim" onclick="return confirm('¿Estás seguro de vaciar todo el carrito?');">
                                <i class="bi bi-trash3 me-1"></i> Vaciar
                            </button>
                        </form>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table table-cart align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4 border-0">Producto</th>
                                <th class="border-0 text-center">Precio</th>
                                <th class="border-0 text-center">Cant.</th>
                                <th class="border-0 text-center">Subtotal</th>
                                <th class="pe-4 border-0 text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (detalles.Count > 0)
                            {
                                foreach (var item in detalles)
                                {
                                    decimal subtotal = item.CANTIDAD * item.PRECIO_UNITARIO;

                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold" style="font-size: 1.05rem;">@item.NOMBRE_PRODUCTO</div>
                                        </td>
                                        <td class="text-center" style="color: var(--text-muted);">
                                            C$ @item.PRECIO_UNITARIO.ToString("N2")
                                        </td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill" style="background-color: var(--hover-bg); color: var(--text-main); border: 1px solid var(--border-color); font-size: 0.9rem; padding: 0.4em 0.8em;">
                                                @item.CANTIDAD
                                            </span>
                                        </td>
                                        <td class="text-center price-text">
                                            C$ @subtotal.ToString("N2")
                                        </td>
                                        <td class="pe-4 text-end">
                                            <form action="/DetalleCarrito/Eliminar" method="post" class="d-inline">
                                                <input type="hidden" name="idDetalle" value="@item.ID_DETALLE" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle click-anim" style="width: 32px; height: 32px; padding: 0;" title="Quitar producto">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div style="color: var(--text-muted);">
                                            <i class="bi bi-cart-x fs-1 d-block mb-3" style="opacity: 0.5;"></i>
                                            <h5 class="fw-bold">Tu carrito está vacío</h5>
                                            <p class="mb-0">¡Explora nuestra tienda y añade productos increíbles!</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-5">
            <div class="cart-card h-100 d-flex flex-column">
                <div class="cart-card-header">
                    <h6 class="m-0 fw-bold" style="color: var(--text-main);">
                        <i class="bi bi-receipt me-2" style="color: var(--tech-accent);"></i>Resumen de Orden
                    </h6>
                </div>

                <div class="card-body p-4 d-flex flex-column flex-grow-1">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span style="color: var(--text-muted);">Estado Actual:</span>
                        <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(6, 182, 212, 0.1); color: var(--tech-accent); border: 1px solid var(--tech-accent);">
                            @(string.IsNullOrEmpty(Model.ESTADO) ? "PENDIENTE" : Model.ESTADO)
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span style="color: var(--text-muted);">Total Artículos:</span>
                        <span class="fw-bold" style="color: var(--text-main);">@detalles.Sum(d => d.CANTIDAD)</span>
                    </div>

                    <hr style="border-color: var(--border-color); opacity: 1;" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold" style="color: var(--text-main);">Total a Pagar:</span>
                        <span class="fs-4 price-text">C$ @Model.TOTAL.ToString("N2")</span>
                    </div>

                    <div class="mt-auto pt-3">
                        @if (detalles.Count > 0)
                        {
                            <form action="/Carrito/ProcesarCompra" method="post">

                                <div class="mb-4">
                                    <label class="form-label" style="color: var(--text-muted); font-size: 0.9rem;">Método de Pago:</label>
                                    <select name="idMetodoPago" class="form-select border-0 shadow-sm" style="background-color: var(--hover-bg); color: var(--text-main); cursor: pointer;" required>
                                        <option value="" disabled selected>Selecciona tu pago...</option>
                                        <option value="1">Efectivo (Pago al entregar)</option>
                                        <option value="2">Transferencia Bancaria</option>
                                        <option value="3">Tarjeta de Crédito / Débito</option>
                                    </select>
                                </div>

                                <button type="submit" class="btn btn-checkout w-100 py-3 fw-bold fs-5 click-anim">
                                    <i class="bi bi-credit-card-fill me-2"></i> Confirmar y Pagar
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn w-100 py-3 fw-bold fs-5" style="background-color: var(--hover-bg); color: var(--text-muted); border: 1px dashed var(--border-color);" disabled>
                                <i class="bi bi-cart-x me-2"></i> Carrito Vacío
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>