@model IEnumerable<Entidades.Permisos>

@{
    ViewData["Title"] = "Gestión de Seguridad";
}

<style>
    /* ADN de Diseño: Refinado */
    .stat-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }

    .border-left-info {
        border-left: 5px solid #0dcaf0 !important;
    }

    /* Badge de Clave Estilo 'Developer' */
    .clave-badge {
        font-family: 'Fira Code', 'Cascadia Code', monospace;
        background: #f1f4f9;
        border: 1px solid #dce3f1;
        color: #2c52da;
        padding: 5px 12px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.8rem;
        letter-spacing: 0.3px;
        text-transform: uppercase;
    }

    /* Mejora de Tabla */
    .table thead th {
        background-color: #f8f9fa;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        font-weight: 700;
        color: #6c757d;
        border-bottom: 2px solid #dee2e6;
    }

    .tr-hover:hover {
        background-color: rgba(13, 202, 240, 0.02) !important;
    }

    /* Botones de acción minimalistas */
    .btn-action {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s;
    }

    .search-container {
        position: relative;
    }

        .search-container i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #adb5bd;
        }

    .search-input {
        padding-left: 35px;
        border-radius: 10px;
        border: 1px solid #dee2e6;
    }
</style>

<div class="row align-items-center mb-4">
    <div class="col-md-6">
        <h3 class="fw-bold mb-0 text-dark">Gestión de Permisos</h3>
        <p class="text-muted mb-0">Control de llaves de acceso al sistema</p>
    </div>
    <div class="col-md-6 text-md-end mt-3 mt-md-0">
        <a href="@Url.Action("Create", "Permisos")" class="btn btn-dark px-4 shadow-sm border-0" style="border-radius: 10px;">
            <i class="bi bi-shield-plus me-2"></i> Nuevo Permiso
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-radius: 12px; border-left: 5px solid #198754 !important;">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill fs-4 me-3"></i>
            <div>
                <strong>¡Excelente!</strong> @TempData["Success"]
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card stat-card border-left-info">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 fw-bold text-info text-uppercase">Diccionario de Accesos</h6>
        
        <div class="search-container">
            <i class="bi bi-search"></i>
            <input type="text" id="txtBuscador" class="form-control form-control-sm search-input" placeholder="Buscar permiso..." style="width: 250px;">
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tablaPermisos">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Clave del Sistema</th>
                        <th>Descripción</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="tr-hover">
                            <td class="ps-4 text-muted fw-bold">#@item.ID_PERMISO</td>
                            <td>
                                <span class="clave-badge">
                                    <i class="bi bi-code me-1"></i>@item.CLAVE_PERMISO
                                </span>
                            </td>
                            <td class="text-dark small">@item.DESCRIPCION</td>
                            <td class="text-center">
                                @if (item.ESTADO)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3">
                                        Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="@Url.Action("Edit", "Permisos", new { id = item.ID_PERMISO })"
                                           class="btn btn-outline-primary btn-action" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button class="btn btn-outline-danger btn-action"
                                            onclick="confirmarDesactivar(@item.ID_PERMISO)" title="Desactivar">
                                        <i class="bi bi-shield-lock"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Buscador dinámico por cualquier columna
        $(document).ready(function () {
        $("#txtBuscador").on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $("#tablaPermisos tbody tr").filter(function () {
        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
        });
        });
        });

        function confirmarDesactivar(id) {
        Swal.fire({
        title: '¿Bloquear permiso?',
        text: "Los usuarios con esta clave perderán el acceso de inmediato.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#000',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Sí, bloquear',
        cancelButtonText: 'Cancelar',
        borderRadius: '15px'
        }).then((result) => {
        if (result.isConfirmed) {
        $.post('@Url.Action("Desactivar", "Permisos")', { id: id }, function (data) {
        if (data.success) {
        Swal.fire({
        icon: 'success',
        title: 'Actualizado',
        text: data.message,
        showConfirmButton: false,
        timer: 1500
        }).then(() => location.reload());
        } else {
        Swal.fire('Error', data.message, 'error');
        }
        });
        }
        })
        }
    </script>
}