@model Entidades.Permisos

@{
    ViewBag.Title = "Crear Nuevo Permiso";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-shield-plus me-2"></i>Registrar Nuevo Permiso
            </h5>
        </div>
        
        <div class="card-body p-4">
            @using (Html.BeginForm("Create", "Permisos", FormMethod.Post, new { id = "formCreate" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger shadow-sm">
                            <i class="bi bi-exclamation-octagon me-2"></i> @ViewBag.Error
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary">Clave del Permiso</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                                @Html.EditorFor(model => model.CLAVE_PERMISO, new { htmlAttributes = new { @class = "form-control", placeholder = "EJ: MODULO_VENTAS", style = "text-transform:uppercase" } })
                            </div>
                            @Html.ValidationMessageFor(model => model.CLAVE_PERMISO, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary">Descripción</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-chat-left-text"></i></span>
                                @Html.EditorFor(model => model.DESCRIPCION, new { htmlAttributes = new { @class = "form-control", placeholder = "Describa el alcance de este permiso" } })
                            </div>
                            @Html.ValidationMessageFor(model => model.DESCRIPCION, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <hr class="my-4 text-muted" />

                    <div class="d-flex justify-content-end align-items-center gap-3">
                        <a href="@Url.Action("Index", "Permisos")" class="btn btn-outline-danger border-0 fw-bold px-4">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-dark shadow px-5 fw-bold">
                            <i class="bi bi-check2-circle me-1"></i> Guardar Permiso
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        $(document).ready(function () {
            $('#CLAVE_PERMISO').on('input', function () {
                this.value = this.value.toUpperCase();
            });
        });
    </script>
}