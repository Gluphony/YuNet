@model IEnumerable<Entidades.Producto>
@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="display-5 border-bottom pb-2">Nuestra Tienda <small class="text-muted" style="font-size: 0.5em;">Estilo Sinsa</small></h2>
        </div>
    </div>

    <div class="row">
        @if (Model != null)
        {
            foreach (var p in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm border-0 rounded-lg overflow-hidden card-hover">
                        @if (p.IMAGEN != null)
                        {
                            <img src="data:image/jpg;base64,@Convert.ToBase64String(p.IMAGEN)" class="card-img-top p-3" style="height: 200px; object-fit: contain;">
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/200x200?text=Sin+Imagen" class="card-img-top p-3">
                        }

                        <div class="card-body d-flex flex-column">
                            <p class="text-muted mb-1" style="font-size: 0.8em;">@p.MODELO</p>
                            <h6 class="card-title text-truncate">@p.DESCRIPCION</h6>
                            <h5 class="text-primary mt-auto">C$ @p.PRECIO.ToString("N2")</h5>

                            @if (p.EXISTENCIAS > 0)
                            {
                                <button class="btn btn-warning w-100 mt-2 fw-bold" onclick="alert('¡Añadido al carrito!')">
                                    <i class="fas fa-cart-plus"></i> AGREGAR
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100 mt-2 disabled">AGOTADO</button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .card-hover:hover {
        transform: translateY(-5px);
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
    }

    .btn-warning {
        background-color: #f37021 !important; /* Color naranja institucional */
        border: none;
        color: white;
    }
</style>