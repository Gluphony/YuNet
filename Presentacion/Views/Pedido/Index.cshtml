@model IEnumerable<Entidades.Pedido>

@{
    ViewData["Title"] = "Gestión de Pedidos";
}

<style>
    /* Heredamos tus estilos de tarjetas */
    .stat-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
        transition: transform 0.2s;
    }

    .border-left-primary {
        border-left: 0.25rem solid #0d6efd !important;
    }

    .border-left-success {
        border-left: 0.25rem solid #198754 !important;
    }

    .border-left-warning {
        border-left: 0.25rem solid #ffc107 !important;
    }

    .border-left-info {
        border-left: 0.25rem solid #0dcaf0 !important;
    }

    /* Estilo para los badges de estado */
    .badge-status {
        border-radius: 50rem;
        padding: 0.5em 1em;
        font-weight: 600;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark">Gestión de Pedidos</h3>
        <p class="text-muted mb-0">Listado detallado de pedidos registrados en YuNet</p>
    </div>
    @if (User.IsInRole("Administrador") || User.IsInRole("Cajero"))
    {
        <a href="/Pedido/Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-cart-plus me-1"></i> Nuevo Pedido
        </a>
    }
</div>

<div class="row">
    <div class="col-12">
        <div class="card stat-card border-left-primary">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-primary">Listado General</h6>
                <div class="dropdown no-arrow">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Pendientes</a></li>
                        <li><a class="dropdown-item" href="#">Completados</a></li>
                    </ul>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="dataTable">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Usuario</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#@item.ID_PEDIDO</td>
                                    <td>ID: @item.ID_USUARIO</td>
                                    <td>@item.FECHA_PEDIDO.ToShortDateString()</td>
                                    <td><span class="text-success fw-bold">$@item.TOTAL.ToString("N2")</span></td>
                                    <td>
                                        @{
                                            var badgeClass = item.ESTADO == "Completado" ? "bg-success" :
                                            item.ESTADO == "Pendiente" ? "bg-warning text-dark" : "bg-info";
                                        }
                                        <span class="badge badge-status @badgeClass">@item.ESTADO</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a href="/Pedido/Details/@item.ID_PEDIDO" class="btn btn-sm btn-outline-info" title="Ver Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Administrador"))
                                            {
                                                <button class="btn btn-sm btn-outline-warning" onclick="cambiarEstado(@item.ID_PEDIDO)" title="Actualizar Estado">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cambiarEstado(id) {
            // Ejemplo de interacción con el controlador que hicimos antes
            if(confirm("¿Desea marcar este pedido como procesado?")) {
                console.log("Actualizando pedido: " + id);
                // Aquí iría tu llamada AJAX al método ActualizarEstado del controlador
            }
        }
    </script>
}