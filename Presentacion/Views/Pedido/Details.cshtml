@model Entidades.Pedido

@{
    ViewData["Title"] = "Detalle del Pedido";

    // Configuración limpia: C# solo decide la clase y el ícono
    string estadoStr = Model.ESTADO?.ToUpper() ?? "DESCONOCIDO";
    string claseBadge = estadoStr == "COMPLETADO" ? "completado" :
                        estadoStr == "PENDIENTE" ? "pendiente" :
                        estadoStr == "CANCELADO" ? "cancelado" : "desconocido";

    string iconBadge = estadoStr == "COMPLETADO" ? "bi-check-circle-fill" :
                       estadoStr == "PENDIENTE" ? "bi-hourglass-split" :
                       estadoStr == "CANCELADO" ? "bi-x-circle-fill" : "bi-info-circle-fill";
}

<style>
    /* ==========================================
                   VARIABLES NEÓN
                   ========================================== */
    :root {
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
        --neon-green: #00FF7F;
        --neon-red: #ff3366;
        --neon-yellow: #ffcc00;
        --bg-card: #0F172A;
        --border-color: rgba(255, 255, 255, 0.1);
        --text-main: #F8FAFC;
        --text-muted: #94A3B8;
    }

    /* ==========================================
                   ESTILOS DE TARJETAS NEÓN
                   ========================================== */
    .info-card {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color);
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        overflow: hidden;
    }

        .info-card:hover {
            box-shadow: 0 10px 30px var(--neon-blue-glow);
            border-color: rgba(0, 212, 255, 0.3);
        }

    .info-card-accent {
        border-top: 4px solid var(--neon-blue-base) !important;
    }

    /* Botones */
    .btn-neon-outline {
        background: transparent;
        color: var(--text-main) !important;
        border: 1px solid var(--border-color);
        font-weight: 600;
        transition: all 0.3s ease;
        border-radius: 8px;
    }

        .btn-neon-outline:hover {
            border-color: var(--neon-blue-base);
            color: var(--neon-blue-base) !important;
            background-color: var(--neon-blue-tint);
            box-shadow: 0 0 15px var(--neon-blue-glow);
        }

    .btn-report {
        background-color: transparent;
        color: var(--text-muted) !important;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-weight: 600;
        padding: 0.4rem 0.8rem;
        transition: all 0.3s ease;
        font-size: 0.85rem;
    }

        .btn-report:hover {
            background-color: rgba(255, 51, 102, 0.1);
            color: var(--neon-red) !important;
            border-color: var(--neon-red);
        }

    /* Badges de Estado Neón */
    .status-badge {
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.6em 1.2em;
        border-radius: 50px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .status-badge.completado {
            color: var(--neon-green);
            background-color: rgba(0, 255, 127, 0.1);
            border: 1px solid var(--neon-green);
            box-shadow: 0 0 10px rgba(0, 255, 127, 0.2);
        }

        .status-badge.pendiente {
            color: var(--neon-yellow);
            background-color: rgba(255, 204, 0, 0.1);
            border: 1px solid var(--neon-yellow);
            box-shadow: 0 0 10px rgba(255, 204, 0, 0.2);
        }

        .status-badge.cancelado {
            color: var(--neon-red);
            background-color: rgba(255, 51, 102, 0.1);
            border: 1px solid var(--neon-red);
            box-shadow: 0 0 10px rgba(255, 51, 102, 0.2);
        }

        .status-badge.desconocido {
            color: var(--neon-blue-base);
            background-color: var(--neon-blue-tint);
            border: 1px solid var(--neon-blue-base);
            box-shadow: 0 0 10px var(--neon-blue-glow);
        }

    /* Total Price Glow */
    .total-price {
        color: var(--neon-blue-base);
        text-shadow: 0 0 15px var(--neon-blue-glow);
        font-size: 2.5rem;
        letter-spacing: -1px;
    }
</style>

<div class="container-fluid container-xl py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <div class="premium-label mb-1" style="color: var(--neon-blue-base); font-size: 0.75rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;">Visor de Orden</div>
            <h2 class="h3 mb-1" style="color: var(--text-main); font-weight: 700;">
                <i class="bi bi-receipt me-2" style="color: var(--neon-blue-base);"></i>Pedido <span style="color: var(--neon-blue-base);">#@Model.ID_PEDIDO</span>
            </h2>
            <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">
                Fecha de registro: @Model.FECHA_PEDIDO.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>
        <a href="javascript:history.back()" class="btn btn-neon-outline px-4 py-2">
            <i class="bi bi-arrow-left me-2"></i> Volver al listado
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card info-card info-card-accent h-100">
                <div class="card-body p-4 p-md-5">
                    <h5 class="fw-bold mb-4" style="color: var(--text-main);">Información General</h5>

                    <div class="mb-4">
                        <small style="color: var(--text-muted); display: block; text-transform: uppercase; letter-spacing: 1px; font-size: 0.75rem;">Cliente</small>
                        <div class="d-flex align-items-center mt-2">
                            <div class="icon-circle me-3" style="width: 40px; height: 40px; background-color: var(--neon-blue-tint); color: var(--neon-blue-base); border-radius: 10px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(0,212,255,0.2);">
                                <i class="bi bi-person"></i>
                            </div>
                            <span style="color: var(--text-main); font-weight: 600; font-size: 1.1rem;">
                                @Model.CLIENTE
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <small style="color: var(--text-muted); display: block; text-transform: uppercase; letter-spacing: 1px; font-size: 0.75rem;">Método de Pago</small>
                        <div class="d-flex align-items-center mt-2">
                            <i class="bi bi-credit-card me-2 fs-5" style="color: var(--neon-blue-base);"></i>
                            <span style="color: var(--text-main); font-weight: 500;">
                                @Model.METODO_PAGO_NOMBRE
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <small style="color: var(--text-muted); display: block; text-transform: uppercase; letter-spacing: 1px; font-size: 0.75rem; margin-bottom: 0.5rem;">Estado del Pedido</small>
                        <span class="status-badge @claseBadge">
                            <i class="bi @iconBadge"></i> @Model.ESTADO
                        </span>
                    </div>

                    <hr style="border-color: rgba(255,255,255,0.1); margin: 2rem 0;" />

                    <div>
                        <small style="color: var(--text-muted); display: block; text-transform: uppercase; letter-spacing: 1px; font-size: 0.75rem;">Total Pagado</small>
                        <h3 class="fw-bold mb-0 total-price mt-1">
                            C$ @Model.TOTAL.ToString("N2")
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card info-card h-100">
                <div class="card-header py-4 px-4" style="background-color: transparent; border-bottom: 1px solid var(--border-color);">
                    <h5 class="m-0 fw-bold d-flex align-items-center" style="color: var(--text-main);">
                        <i class="bi bi-box-seam me-3" style="color: var(--neon-blue-base);"></i> Productos en el Pedido
                    </h5>
                </div>

                <div class="card-body p-4" style="min-height: 300px;">

                    @if (ViewBag.Detalles != null && ((IEnumerable<dynamic>)ViewBag.Detalles).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-borderless align-middle mb-0" style="--bs-table-bg: transparent;">
                                <thead>
                                    <tr style="border-bottom: 1px solid rgba(0, 212, 255, 0.2);">
                                        <th style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; background-color: transparent;">Producto</th>
                                        <th class="text-center" style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; background-color: transparent;">Cantidad</th>
                                        <th class="text-end" style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; background-color: transparent;">Precio Unit.</th>
                                        <th class="text-end" style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; background-color: transparent;">Subtotal</th>
                                        <th class="text-center" style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; background-color: transparent;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in ViewBag.Detalles)
                                    {
                                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                                            <td class="py-3" style="background-color: transparent;">
                                                <div class="d-flex align-items-center">
                                                    <div class="icon-circle me-3" style="width: 40px; height: 40px; background-color: rgba(255, 255, 255, 0.05); color: var(--text-main); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                                        <i class="bi bi-box"></i>
                                                    </div>
                                                    <span style="color: var(--text-main); font-weight: 500;">@item.PRODUCTO</span>
                                                </div>
                                            </td>
                                            <td class="text-center py-3" style="color: var(--text-muted); background-color: transparent;">
                                                @item.CANTIDAD
                                            </td>
                                            <td class="text-end py-3" style="color: var(--text-muted); background-color: transparent;">
                                                C$ @item.PRECIO_UNITARIO.ToString("N2")
                                            </td>
                                            <td class="text-end py-3 fw-bold" style="color: var(--neon-blue-base); background-color: transparent;">
                                                C$ @((item.CANTIDAD * item.PRECIO_UNITARIO).ToString("N2"))
                                            </td>
                                            <td class="text-center py-3" style="background-color: transparent;">
                                                <button type="button" class="btn btn-report" onclick="abrirModalReporte(@item.ID_DETALLE_PEDIDO)">
                                                    <i class="bi bi-exclamation-triangle"></i> Reportar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column justify-content-center align-items-center h-100">
                            <div class="text-center p-5">
                                <div class="mb-4 position-relative d-inline-block">
                                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100px; height: 100px; background-color: var(--neon-blue-tint); filter: blur(20px); border-radius: 50%;"></div>
                                    <i class="bi bi-box-seam position-relative" style="font-size: 4rem; color: var(--neon-blue-base); filter: drop-shadow(0 0 10px var(--neon-blue-glow));"></i>
                                </div>
                                <h5 class="fw-bold" style="color: var(--text-main);">Sin productos asignados</h5>
                                <p class="mt-2" style="color: var(--text-muted); max-width: 350px;">
                                    Los detalles de los productos para este pedido aún no están disponibles en el sistema.
                                </p>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalReporte" tabindex="-1" aria-labelledby="modalReporteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-color); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title" id="modalReporteLabel" style="color: var(--text-main); font-weight: 700;">
                    <i class="bi bi-exclamation-triangle-fill me-2" style="color: var(--neon-red);"></i> Reportar un problema
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <form id="formReporte">
                    <input type="hidden" id="txtIdDetallePedidoReporte" />

                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
                        Estás reportando un problema con el producto seleccionado en este pedido.
                    </p>

                    <div class="mb-3">
                        <label class="form-label" style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px;">¿Qué problema tuviste?</label>
                        <select class="form-select" id="cboMotivoReporte"
                                style="background-color: rgba(255,255,255,0.05); color: var(--text-main); border: 1px solid var(--border-color);">
                            <option value="Producto dañado" style="color: black;">El producto llegó dañado o defectuoso</option>
                            <option value="Producto incorrecto" style="color: black;">Me enviaron un producto incorrecto</option>
                            <option value="Faltan artículos" style="color: black;">Faltan artículos en mi paquete</option>
                            <option value="No llegó" style="color: black;">Mi pedido nunca llegó</option>
                            <option value="Otro" style="color: black;">Otro problema</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px;">Detalles adicionales</label>
                        <textarea class="form-control" id="txtDetalleReporte" rows="3" placeholder="Por favor, explica detalladamente qué sucedió..."
                                  style="background-color: rgba(255,255,255,0.05); color: var(--text-main); border: 1px solid var(--border-color);"></textarea>
                    </div>
                </form>
            </div>

            <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-neon-outline" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn" id="btnEnviarReporte" style="background-color: var(--neon-red); color: white; border: none; font-weight: 600; padding: 0.5rem 1.5rem; border-radius: 8px; box-shadow: 0 0 15px rgba(255, 51, 102, 0.4);">
                    <i class="bi bi-send-fill me-1"></i> Enviar Reporte
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalReporteBootstrap;

        // Función global para que el botón "onclick" la encuentre
        function abrirModalReporte(idDetallePedido) {
            document.getElementById('txtIdDetallePedidoReporte').value = idDetallePedido;
            document.getElementById('cboMotivoReporte').selectedIndex = 0;
            document.getElementById('txtDetalleReporte').value = '';

            if (!modalReporteBootstrap) {
                const modalEl = document.getElementById('modalReporte');
                modalReporteBootstrap = new bootstrap.Modal(modalEl);
            }

            modalReporteBootstrap.show();
        }

        document.addEventListener("DOMContentLoaded", function () {

            // --- LÓGICA DE ENVIAR REPORTE ---
            document.getElementById('btnEnviarReporte').addEventListener('click', function () {
                const idDetallePedido = document.getElementById('txtIdDetallePedidoReporte').value;
                const motivo = document.getElementById('cboMotivoReporte').value;
                const detalle = document.getElementById('txtDetalleReporte').value;

                if (detalle.trim() === '') {
                    alert('Por favor, escribe un poco de detalle sobre el problema.');
                    return;
                }

                const motivoCompleto = motivo + " - " + detalle;

                // Ahora sí, enviamos el ID_DETALLE_PEDIDO correcto que tu base de datos espera
              const dataEnvio = {
            ID_DETALLE_PEDIDO: parseInt(idDetallePedido),
            MOTIVO_CLIENTE: motivoCompleto
          };

                const btnEnviar = document.getElementById('btnEnviarReporte');
                const textoOriginal = btnEnviar.innerHTML;

                btnEnviar.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Enviando...';
                btnEnviar.disabled = true;

                // Hacemos la petición al backend
                     fetch('/Devolucion/Create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json' // Le decimos al servidor que es JSON
            },
            body: JSON.stringify(dataEnvio)
        })
                .then(response => response.json())
                .then(data => {
                    if (data.exito) {
                        alert('✅ ¡Reporte enviado! Nos pondremos en contacto contigo pronto.');
                        if (modalReporteBootstrap) {
                            modalReporteBootstrap.hide();
                        }
                    } else {
                        alert('❌ Hubo un problema: ' + data.mensaje);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Ocurrió un error al intentar enviar el reporte.');
                })
                .finally(() => {
                    btnEnviar.innerHTML = textoOriginal;
                    btnEnviar.disabled = false;
                });
            });

        });
    </script>
}