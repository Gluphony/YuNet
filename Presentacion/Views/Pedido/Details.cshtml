@model Entidades.Pedido

@{
    ViewData["Title"] = "Detalle del Pedido";

    // Configuración de colores para el estado
    string estadoStr = Model.ESTADO?.ToUpper() ?? "DESCONOCIDO";
    string bgBadge = estadoStr == "COMPLETADO" ? "rgba(25, 135, 84, 0.15)" :
                     estadoStr == "PENDIENTE" ? "rgba(255, 193, 7, 0.15)" :
                     estadoStr == "CANCELADO" ? "rgba(220, 53, 69, 0.15)" : "rgba(13, 202, 240, 0.15)";
    string colorBadge = estadoStr == "COMPLETADO" ? "#20c997" :
                        estadoStr == "PENDIENTE" ? "#ffc107" :
                        estadoStr == "CANCELADO" ? "#ff6b6b" : "#0dcaf0";
    string iconBadge = estadoStr == "COMPLETADO" ? "bi-check-circle" :
                       estadoStr == "PENDIENTE" ? "bi-hourglass-split" :
                       estadoStr == "CANCELADO" ? "bi-x-circle" : "bi-info-circle";

    // Recuperamos los detalles del ViewBag que mandó el Controlador
    var detallesTicket = ViewBag.Detalles as IEnumerable<dynamic> ?? new List<dynamic>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0" style="color: var(--text-main); font-weight: 700;">
            <i class="bi bi-receipt me-2" style="color: #C6C3F2;"></i>Pedido #@Model.ID_PEDIDO
        </h2>
        <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">
            Fecha de registro: @Model.FECHA_PEDIDO.ToString("dd/MM/yyyy HH:mm")
        </p>
    </div>
    <a href="javascript:history.back()" class="btn border-0 shadow-sm px-4" style="background-color: var(--bg-card); color: var(--text-main); font-weight: 600; border-radius: 8px; border: 1px solid var(--border-color) !important; transition: 0.3s;" onmouseover="this.style.backgroundColor='var(--bg-main)'" onmouseout="this.style.backgroundColor='var(--bg-card)'">
        <i class="bi bi-arrow-left me-2"></i> Volver
    </a>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card border-0 shadow-sm h-100" style="background-color: var(--bg-card); border-radius: 12px; border-top: 0.25rem solid #C6C3F2 !important;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3" style="color: var(--text-main);">Información General</h6>

                <div class="mb-3">
                    <small style="color: var(--text-muted); display: block;">Cliente</small>
                    <span style="color: var(--text-main); font-weight: 500;">
                        <i class="bi bi-person-badge me-1"></i> @Model.CLIENTE
                    </span>

                    <div class="mt-3">
                        <small style="color: var(--text-muted); display: block;">Método de Pago</small>
                        <span style="color: var(--text-main); font-weight: 500;">
                            <i class="bi bi-credit-card me-1"></i> @Model.METODO_PAGO_NOMBRE
                        </span>
                    </div>
                </div>

                <div class="mb-3">
                    <small style="color: var(--text-muted); display: block;">Estado del Pedido</small>
                    <span class="badge rounded-pill mt-1" style="background-color: @bgBadge; color: @colorBadge; border: 1px solid @(colorBadge)50; padding: 0.5em 1em; font-weight: 500; font-size: 0.85rem;">
                        <i class="bi @iconBadge me-1"></i> @Model.ESTADO
                    </span>
                </div>

                <hr style="border-color: var(--border-color);" />

                <div class="mt-3">
                    <small style="color: var(--text-muted); display: block;">Total Pagado</small>
                    <h3 class="fw-bold mb-0" style="color: #C6C3F2;">
                        $@Model.TOTAL.ToString("N2")
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8 mb-4">
        <div class="card border-0 shadow-sm h-100" style="background-color: var(--bg-card); border-radius: 12px;">
            <div class="card-header py-3" style="background-color: transparent; border-bottom: 1px solid var(--border-color);">
                <h6 class="m-0 fw-bold" style="color: var(--text-main);">Productos en el Pedido</h6>
            </div>
            <div class="card-body p-4">

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0" style="color: var(--text-main);">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--border-color);">
                                <th class="text-muted fw-normal pb-2" style="font-size: 0.85rem; text-transform: uppercase;">Producto</th>
                                <th class="text-muted fw-normal pb-2 text-center" style="font-size: 0.85rem; text-transform: uppercase;">Cant.</th>
                                <th class="text-muted fw-normal pb-2 text-end" style="font-size: 0.85rem; text-transform: uppercase;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (detallesTicket.Any())
                            {
                                foreach (var item in detallesTicket)
                                {
                                    <tr style="border-bottom: 1px solid var(--border-color);">
                                        <td class="py-3">
                                            <strong style="color: var(--text-main);">@item.Producto</strong><br>
                                            <small style="color: #C6C3F2;">IMEI/Serie: @item.Numero_Serie_IMEI</small>
                                        </td>
                                        <td class="py-3 text-center fw-bold" style="color: var(--text-main);">
                                            @item.Cantidad
                                        </td>
                                        <td class="py-3 text-end">

                                            @if (estadoStr == "COMPLETADO")
                                            {
                                                <a href="@Url.Action("Create", "Devolucion", new { idDetalle = item.Id_Detalle_Pedido })"
                                                   class="btn btn-sm shadow-sm"
                                                   style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.2); transition: 0.2s;"
                                                   onmouseover="this.style.backgroundColor='#dc3545'; this.style.color='white';"
                                                   onmouseout="this.style.backgroundColor='rgba(220, 53, 69, 0.1)'; this.style.color='#dc3545';">
                                                    <i class="bi bi-arrow-return-left me-1"></i> Devolver
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background-color: var(--bg-main); color: var(--text-muted); border: 1px solid var(--border-color);">
                                                    No elegible
                                                </span>
                                            }

                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-5">
                                        <i class="bi bi-box-seam display-6 mb-3 d-block" style="color: var(--text-muted); opacity: 0.3;"></i>
                                        <span class="text-muted">Los detalles de los productos para este pedido aún no están disponibles o la lista está vacía.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>