@model Entidades.Pedido

@{
    ViewData["Title"] = "Detalle del Pedido";

    // Configuración limpia: C# solo decide la clase y el ícono
    string estadoStr = Model.ESTADO?.ToUpper() ?? "DESCONOCIDO";
    string claseBadge = estadoStr == "COMPLETADO" ? "completado" :
                        estadoStr == "PENDIENTE" ? "pendiente" :
                        estadoStr == "CANCELADO" ? "cancelado" : "desconocido";

    string iconBadge = estadoStr == "COMPLETADO" ? "bi-check-circle-fill" :
                       estadoStr == "PENDIENTE" ? "bi-hourglass-split" :
                       estadoStr == "CANCELADO" ? "bi-x-circle-fill" : "bi-info-circle-fill";
}

<style>
    /* ==========================================
               1. VARIABLES TEMA CLARO (Por defecto)
            ========================================== */
    :root {
        --neon-blue-base: #0096c7;
        --neon-blue-glow: rgba(0, 150, 199, 0.2);
        --neon-blue-tint: rgba(0, 150, 199, 0.05);
        --neon-green: #00b359;
        --neon-red: #e6004c;
        --neon-yellow: #e6a800;
        --bg-card: #ffffff;
        --bg-accordion: #f8f9fa;
        --border-color: rgba(0, 0, 0, 0.08);
        --text-main: #1e293b;
        --text-muted: #64748b;
        --row-hover: rgba(0, 0, 0, 0.02);
        --icon-bg: rgba(0, 0, 0, 0.04);
    }

    /* ==========================================
               2. VARIABLES TEMA OSCURO (Automático)
               Detecta cualquier clase común de modo oscuro de tu layout
            ========================================== */
    [data-bs-theme="dark"],
    body.dark-mode,
    body.dark-theme,
    .dark-layout,
    [data-theme="dark"] {
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
        --neon-green: #00FF7F;
        --neon-red: #ff3366;
        --neon-yellow: #ffcc00;
        --bg-card: #0F172A;
        --bg-accordion: rgba(255, 255, 255, 0.02);
        --border-color: rgba(255, 255, 255, 0.1);
        --text-main: #F8FAFC;
        --text-muted: #94A3B8;
        --row-hover: rgba(255, 255, 255, 0.03);
        --icon-bg: rgba(255, 255, 255, 0.05);
    }

    /* ==========================================
               ESTILOS DE TARJETAS
            ========================================== */
    .info-card {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color);
        border-radius: 16px;
        transition: all 0.4s ease;
        overflow: hidden;
    }

        .info-card:hover {
            box-shadow: 0 10px 30px var(--neon-blue-glow);
            border-color: rgba(0, 212, 255, 0.3);
        }

    .info-card-accent {
        border-top: 4px solid var(--neon-blue-base) !important;
    }

    .total-price {
        color: var(--neon-blue-base);
        text-shadow: 0 0 15px var(--neon-blue-glow);
        font-size: 2.5rem;
        letter-spacing: -1px;
    }

    /* ==========================================
               BOTONES Y BADGES
            ========================================== */
    .btn-neon-outline {
        background: transparent;
        color: var(--text-main) !important;
        border: 1px solid var(--border-color);
        font-weight: 600;
        transition: all 0.3s ease;
        border-radius: 8px;
    }

        .btn-neon-outline:hover {
            border-color: var(--neon-blue-base);
            color: var(--neon-blue-base) !important;
            background-color: var(--neon-blue-tint);
            box-shadow: 0 0 15px var(--neon-blue-glow);
        }

    .btn-report {
        background-color: transparent;
        color: var(--text-muted) !important;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-weight: 600;
        padding: 0.4rem 0.8rem;
        transition: all 0.3s ease;
        font-size: 0.85rem;
    }

        .btn-report:hover {
            background-color: rgba(230, 0, 76, 0.1);
            color: var(--neon-red) !important;
            border-color: var(--neon-red);
        }

    .status-badge {
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.6em 1.2em;
        border-radius: 50px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .status-badge.completado {
            color: var(--neon-green);
            background-color: rgba(0, 179, 89, 0.1);
            border: 1px solid var(--neon-green);
            box-shadow: 0 0 10px rgba(0, 179, 89, 0.2);
        }

        .status-badge.pendiente {
            color: var(--neon-yellow);
            background-color: rgba(230, 168, 0, 0.1);
            border: 1px solid var(--neon-yellow);
            box-shadow: 0 0 10px rgba(230, 168, 0, 0.2);
        }

        .status-badge.cancelado {
            color: var(--neon-red);
            background-color: rgba(230, 0, 76, 0.1);
            border: 1px solid var(--neon-red);
            box-shadow: 0 0 10px rgba(230, 0, 76, 0.2);
        }

        .status-badge.desconocido {
            color: var(--neon-blue-base);
            background-color: var(--neon-blue-tint);
            border: 1px solid var(--neon-blue-base);
            box-shadow: 0 0 10px var(--neon-blue-glow);
        }

    /* ==========================================
               ✨ MAGIA: ANIMACIÓN DE LA FLECHITA (ACORDEÓN) ✨
            ========================================== */
    .btn-toggle-accordion {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        border-radius: 50%; /* Círculo perfecto */
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        /* Transición de rebote para todos los cambios */
        transition: all 0.5s cubic-bezier(0.68, -0.55, 0.26, 1.55);
        padding: 0;
        cursor: pointer;
        z-index: 2;
    }

        /* Estado Normal (Hover) */
        .btn-toggle-accordion:hover {
            background-color: var(--row-hover);
            color: var(--text-main);
            border-color: var(--text-muted);
            transform: scale(1.05);
        }

        /* Flecha interna */
        .btn-toggle-accordion i {
            transition: transform 0.5s cubic-bezier(0.68, -0.55, 0.26, 1.55);
            font-size: 1.2rem;
        }

        /* ESTADO ABIERTO: Activa el resplandor y gira la flecha */
        .btn-toggle-accordion:not(.collapsed) {
            background-color: var(--neon-blue-tint);
            color: var(--neon-blue-base);
            border-color: var(--neon-blue-base);
            box-shadow: 0 0 15px var(--neon-blue-glow);
            transform: scale(1.1); /* Crece un poquito */
        }

            .btn-toggle-accordion:not(.collapsed) i {
                transform: rotate(180deg); /* Gira con rebote */
            }

    .accordion-row-open {
        background-color: var(--bg-accordion);
        border-bottom: 1px solid var(--border-color);
        transition: background-color 0.3s ease;
    }
</style>

<div class="container-fluid container-xl py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <div class="premium-label mb-1" style="color: var(--neon-blue-base); font-size: 0.75rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;">Visor de Orden</div>
            <h2 class="h3 mb-1" style="color: var(--text-main); font-weight: 700;">
                <i class="bi bi-receipt me-2" style="color: var(--neon-blue-base);"></i>Pedido <span style="color: var(--neon-blue-base);">#@Model.ID_PEDIDO</span>
            </h2>
            <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">
                Fecha de registro: @Model.FECHA_PEDIDO.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>
        <a href="javascript:history.back()" class="btn btn-neon-outline px-4 py-2">
            <i class="bi bi-arrow-left me-2"></i> Volver al listado
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card info-card info-card-accent h-100">
                <div class="card-body p-4 p-md-5">
                    <h5 class="fw-bold mb-4" style="color: var(--text-main);">Información General</h5>

                    <div class="mb-4">
                        <small style="color: var(--text-muted); display: block; text-transform: uppercase; letter-spacing: 1px; font-size: 0.75rem;">Cliente</small>
                        <div class="d-flex align-items-center mt-2">
                            <div class="icon-circle me-3" style="width: 40px; height: 40px; background-color: var(--neon-blue-tint); color: var(--neon-blue-base); border-radius: 10px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-color);">
                                <i class="bi bi-person"></i>
                            </div>
                            <span style="color: var(--text-main); font-weight: 600; font-size: 1.1rem;">
                                @Model.CLIENTE
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <small style="color: var(--text-muted); display: block; text-transform: uppercase; letter-spacing: 1px; font-size: 0.75rem;">Método de Pago</small>
                        <div class="d-flex align-items-center mt-2">
                            <i class="bi bi-credit-card me-2 fs-5" style="color: var(--neon-blue-base);"></i>
                            <span style="color: var(--text-main); font-weight: 500;">
                                @Model.METODO_PAGO_NOMBRE
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <small style="color: var(--text-muted); display: block; text-transform: uppercase; letter-spacing: 1px; font-size: 0.75rem; margin-bottom: 0.5rem;">Estado del Pedido</small>
                        <span class="status-badge @claseBadge">
                            <i class="bi @iconBadge"></i> @Model.ESTADO
                        </span>
                    </div>

                    <hr style="border-color: var(--border-color); margin: 2rem 0;" />

                    <div>
                        <small style="color: var(--text-muted); display: block; text-transform: uppercase; letter-spacing: 1px; font-size: 0.75rem;">Total Pagado</small>
                        <h3 class="fw-bold mb-0 total-price mt-1">
                            C$ @Model.TOTAL.ToString("N2")
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card info-card h-100">
                <div class="card-header py-4 px-4" style="background-color: transparent; border-bottom: 1px solid var(--border-color);">
                    <h5 class="m-0 fw-bold d-flex align-items-center" style="color: var(--text-main);">
                        <i class="bi bi-box-seam me-3" style="color: var(--neon-blue-base);"></i> Productos en el Pedido
                    </h5>
                </div>

                <div class="card-body p-4" style="min-height: 300px;">

                    @if (ViewBag.Detalles != null && ((IEnumerable<dynamic>)ViewBag.Detalles).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-borderless align-middle mb-0" style="--bs-table-bg: transparent;">
                                <thead>
                                    <tr style="border-bottom: 1px solid var(--border-color);">
                                        <th style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; background-color: transparent;">Producto</th>
                                        <th class="text-center" style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; background-color: transparent;">Cantidad</th>
                                        <th class="text-end" style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; background-color: transparent;">Precio Unit.</th>
                                        <th class="text-end" style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; background-color: transparent;">Subtotal</th>
                                        <th class="text-center" style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; background-color: transparent;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in ViewBag.Detalles)
                                    {
                                        int cantidad = item.CANTIDAD;
                                        string imeisGuardados = (item.IMEI_VENDIDO != null && item.IMEI_VENDIDO != "N/A") ? item.IMEI_VENDIDO : "";
                                        string[] listaImeisAsignados = string.IsNullOrWhiteSpace(imeisGuardados) ? new string[0] : imeisGuardados.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);

                                        <tr style="border-bottom: 1px solid var(--border-color);">
                                            <td class="py-3" style="background-color: transparent;">
                                                <div class="d-flex align-items-center">

                                                    @if (cantidad > 1)
                                                    {
                                                        <button class="btn-toggle-accordion collapsed me-3 shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@item.ID_DETALLE_PEDIDO" aria-expanded="false">
                                                            <i class="bi bi-chevron-down"></i>
                                                        </button>
                                                    }

                                                    <div class="icon-circle me-3" style="width: 40px; height: 40px; background-color: var(--icon-bg); color: var(--text-main); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                                        <i class="bi bi-box"></i>
                                                    </div>
                                                    <div>
                                                        <span style="color: var(--text-main); font-weight: 500; display: block;">@item.PRODUCTO</span>

                                                        @if (cantidad == 1 && listaImeisAsignados.Length == 1)
                                                        {
                                                            <small style="color: var(--text-muted); font-size: 0.8rem;">IMEI/Serie: <span style="color: var(--neon-blue-base);">@listaImeisAsignados[0]</span></small>
                                                        }
                                                        else if (cantidad > 1)
                                                        {
                                                            <small style="color: var(--text-muted); font-size: 0.8rem; letter-spacing: 0.5px;">
                                                                <span style="color: var(--neon-blue-base); font-weight: 600;">@listaImeisAsignados.Length</span> de @cantidad asignados
                                                            </small>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center py-3" style="color: var(--text-muted); background-color: transparent;">
                                                @item.CANTIDAD
                                            </td>
                                            <td class="text-end py-3" style="color: var(--text-muted); background-color: transparent;">
                                                C$ @item.PRECIO_UNITARIO.ToString("N2")
                                            </td>
                                            <td class="text-end py-3 fw-bold" style="color: var(--neon-blue-base); background-color: transparent;">
                                                C$ @((item.CANTIDAD * item.PRECIO_UNITARIO).ToString("N2"))
                                            </td>
                                            <td class="text-center py-3" style="background-color: transparent;">
                                                @if (cantidad == 1)
                                                {
                                                    if (listaImeisAsignados.Length == 0 && User.IsInRole("Administrador"))
                                                    {
                                                        <button type="button" class="btn btn-sm text-dark fw-bold btn-asignar-imei mb-2"
                                                                style="background-color: var(--neon-yellow); box-shadow: 0 0 10px rgba(230, 168, 0, 0.3);"
                                                                data-iddetalle="@item.ID_DETALLE_PEDIDO">
                                                            <i class="bi bi-upc-scan me-1"></i> Asignar
                                                        </button>
                                                        <br />
                                                    }
                                                    else if (listaImeisAsignados.Length == 1)
                                                    {
                                                        <button type="button" class="btn btn-report" onclick="abrirModalReporte(@item.ID_DETALLE_PEDIDO, '@listaImeisAsignados[0]')">
                                                            <i class="bi bi-exclamation-triangle"></i> Reportar
                                                        </button>
                                                    }
                                                }
                                                else
                                                {
                                                    <span style="color: var(--text-muted); font-size: 0.85rem; cursor: pointer; user-select: none;" data-bs-toggle="collapse" data-bs-target="#collapse_@item.ID_DETALLE_PEDIDO">
                                                        Ver Desglose
                                                    </span>
                                                }
                                            </td>
                                        </tr>

                                        @if (cantidad > 1)
                                        {
                                            <tr id="collapse_@item.ID_DETALLE_PEDIDO" class="collapse">
                                                <td colspan="5" class="p-0 border-0">
                                                    <div class="accordion-row-open p-3 p-md-4 m-2 rounded" style="border: 1px dashed var(--border-color);">
                                                        <h6 style="color: var(--text-main); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem; font-weight: 700;">
                                                            <i class="bi bi-list-nested me-2" style="color: var(--neon-blue-base);"></i> Desglose de Unidades
                                                        </h6>

                                                        <div style="max-height: 250px; overflow-y: auto; padding-right: 10px;">
                                                            @for (int i = 0; i < cantidad; i++)
                                                            {
                                                                bool tieneImei = i < listaImeisAsignados.Length;
                                                                string imeiActual = tieneImei ? listaImeisAsignados[i] : "";

                                                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: var(--border-color) !important;">
                                                                    <div>
                                                                        <span style="color: var(--text-main); font-weight: 500; font-size: 0.95rem;">Unidad #@(i + 1)</span>
                                                                        @if (tieneImei)
                                                                        {
                                                                            <span class="badge ms-2" style="background-color: transparent; color: var(--neon-green); border: 1px solid var(--neon-green); font-size: 0.75rem;">
                                                                                <i class="bi bi-check-circle me-1"></i> IMEI: @imeiActual
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge ms-2" style="background-color: transparent; color: var(--text-muted); border: 1px dashed var(--text-muted); font-size: 0.75rem; font-weight: normal;">
                                                                                Pendiente de asignar
                                                                            </span>
                                                                        }
                                                                    </div>

                                                                    <div>
                                                                        @if (!tieneImei && User.IsInRole("Administrador"))
                                                                        {
                                                                            <button type="button" class="btn btn-sm text-dark fw-bold btn-asignar-imei"
                                                                                    style="background-color: var(--neon-yellow); font-size: 0.8rem; padding: 0.3rem 0.6rem; border-radius: 6px;"
                                                                                    data-iddetalle="@item.ID_DETALLE_PEDIDO">
                                                                                <i class="bi bi-upc-scan"></i> Asignar
                                                                            </button>
                                                                        }
                                                                        else if (tieneImei)
                                                                        {
                                                                            <button type="button" class="btn btn-sm btn-report" style="font-size: 0.8rem; padding: 0.3rem 0.6rem;" onclick="abrirModalReporte(@item.ID_DETALLE_PEDIDO, '@imeiActual')">
                                                                                <i class="bi bi-exclamation-triangle"></i> Reportar
                                                                            </button>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column justify-content-center align-items-center h-100">
                            <div class="text-center p-5">
                                <div class="mb-4 position-relative d-inline-block">
                                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100px; height: 100px; background-color: var(--neon-blue-tint); filter: blur(20px); border-radius: 50%;"></div>
                                    <i class="bi bi-box-seam position-relative" style="font-size: 4rem; color: var(--neon-blue-base); filter: drop-shadow(0 0 10px var(--neon-blue-glow));"></i>
                                </div>
                                <h5 class="fw-bold" style="color: var(--text-main);">Sin productos asignados</h5>
                                <p class="mt-2" style="color: var(--text-muted); max-width: 350px;">
                                    Los detalles de los productos para este pedido aún no están disponibles en el sistema.
                                </p>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalReporte" tabindex="-1" aria-labelledby="modalReporteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-color); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title" id="modalReporteLabel" style="color: var(--text-main); font-weight: 700;">
                    <i class="bi bi-exclamation-triangle-fill me-2" style="color: var(--neon-red);"></i> Reportar un problema
                </h5>
                <button type="button" class="btn-close" style="filter: invert(1) grayscale(100%) brightness(200%);" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <form id="formReporte">
                    <input type="hidden" id="txtIdDetallePedidoReporte" />
                    <input type="hidden" id="txtImeiReporte" />

                    <div class="alert mb-4" style="background-color: var(--icon-bg); border: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.9rem;">
                        Estás reportando un problema con la unidad <strong style="color: var(--neon-blue-base);" id="lblImeiReporte"></strong>.
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px;">¿Qué problema tuviste?</label>
                        <select class="form-select" id="cboMotivoReporte"
                                style="background-color: var(--bg-card); color: var(--text-main); border: 1px solid var(--border-color);">
                            <option value="Producto dañado">El producto llegó dañado o defectuoso</option>
                            <option value="Producto incorrecto">Me enviaron un producto incorrecto</option>
                            <option value="Faltan artículos">Faltan artículos en mi paquete</option>
                            <option value="No llegó">Mi pedido nunca llegó</option>
                            <option value="Otro">Otro problema</option>
                        </select>
                    </div>

                    <div id="apartadoOtroProblema" style="display: none; background-color: var(--icon-bg); padding: 15px; border-radius: 8px; border: 1px dashed var(--border-color);">
                        <div class="mb-3">
                            <label class="form-label text-warning fw-bold" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">
                                <i class="bi bi-info-circle me-1"></i> Describe el problema (Obligatorio)
                            </label>
                            <textarea class="form-control" id="txtDetalleReporte" rows="3" placeholder="Por favor, explica detalladamente qué sucedió..."
                                      style="background-color: var(--bg-card); color: var(--text-main); border: 1px solid var(--border-color);"></textarea>
                        </div>

                        <div class="mb-0">
                            <label class="form-label" style="color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">
                                <i class="bi bi-image me-1"></i> Subir Evidencia (Opcional)
                            </label>
                            <input class="form-control" type="file" id="fileEvidenciaImagen" accept="image/png, image/jpeg, image/jpg"
                                   style="background-color: var(--bg-card); color: var(--text-main); border: 1px solid var(--border-color);">
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-neon-outline" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn" id="btnEnviarReporte" style="background-color: var(--neon-red); color: white; border: none; font-weight: 600; padding: 0.5rem 1.5rem; border-radius: 8px; box-shadow: 0 0 15px rgba(230, 0, 76, 0.4);">
                    <i class="bi bi-send-fill me-1"></i> Enviar Reporte
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalReporteBootstrap;

        // Función para abrir modal y setear el IMEI
        function abrirModalReporte(idDetallePedido, imei) {
            document.getElementById('txtIdDetallePedidoReporte').value = idDetallePedido;
            document.getElementById('txtImeiReporte').value = imei || 'N/A';
            document.getElementById('lblImeiReporte').innerText = imei ? `(IMEI: ${imei})` : '';

            // Reiniciamos el formulario al abrir
            document.getElementById('cboMotivoReporte').selectedIndex = 0;
            document.getElementById('txtDetalleReporte').value = '';
            document.getElementById('fileEvidenciaImagen').value = '';
            document.getElementById('apartadoOtroProblema').style.display = 'none';

            if (!modalReporteBootstrap) {
                const modalEl = document.getElementById('modalReporte');
                modalReporteBootstrap = new bootstrap.Modal(modalEl);
            }

            modalReporteBootstrap.show();
        }

        document.addEventListener("DOMContentLoaded", function () {

            // --- LÓGICA PARA MOSTRAR U OCULTAR "OTRO PROBLEMA" ---
            document.getElementById('cboMotivoReporte').addEventListener('change', function () {
                const apartado = document.getElementById('apartadoOtroProblema');
                if (this.value === 'Otro') {
                    // Usamos un pequeño delay para simular el "slideDown" de jQuery pero en JS Vanilla
                    apartado.style.display = 'block';
                } else {
                    apartado.style.display = 'none';
                    document.getElementById('txtDetalleReporte').value = '';
                    document.getElementById('fileEvidenciaImagen').value = '';
                }
            });


            // LÓGICA DE REPORTE ACTUALIZADA
            document.getElementById('btnEnviarReporte').addEventListener('click', function () {
                const idDetallePedido = document.getElementById('txtIdDetallePedidoReporte').value;
                const imeiSeleccionado = document.getElementById('txtImeiReporte').value;
                const motivo = document.getElementById('cboMotivoReporte').value;
                const detalle = document.getElementById('txtDetalleReporte').value;

                // Validación inteligente: Solo exigimos detalle si elige "Otro"
                if (motivo === 'Otro' && detalle.trim() === '') {
                    alert('Has seleccionado "Otro problema". Por favor, escribe un poco de detalle sobre lo que sucedió.');
                    return;
                }

                // Construimos el mensaje para la base de datos
                let motivoCompleto = `[Unidad: ${imeiSeleccionado}] ${motivo}`;
                if (motivo === 'Otro') {
                    motivoCompleto += ` - ${detalle}`;
                }

                const formData = new FormData();
                formData.append('ID_DETALLE_PEDIDO', idDetallePedido);
                formData.append('MOTIVO_CLIENTE', motivoCompleto);

                // Si subió imagen, la agregamos al FormData (Lista para que el backend la reciba cuando lo programemos)
                const fileInput = document.getElementById('fileEvidenciaImagen');
                if (fileInput.files.length > 0) {
                    formData.append('EVIDENCIA_IMAGEN', fileInput.files[0]);
                }

                const btnEnviar = document.getElementById('btnEnviarReporte');
                const textoOriginal = btnEnviar.innerHTML;

                btnEnviar.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Enviando...';
                btnEnviar.disabled = true;

                fetch('/Devolucion/Create', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.exito) {
                        alert('✅ ¡Reporte enviado! Nos pondremos en contacto contigo pronto.');
                        if (modalReporteBootstrap) modalReporteBootstrap.hide();
                    } else {
                        alert('❌ Hubo un problema: ' + data.mensaje);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Ocurrió un error al conectar con el servidor.');
                })
                .finally(() => {
                    btnEnviar.innerHTML = textoOriginal;
                    btnEnviar.disabled = false;
                });
            });

            // LÓGICA DE ASIGNAR IMEI (Se mantiene igual)
            document.querySelectorAll('.btn-asignar-imei').forEach(boton => {
                boton.addEventListener('click', function () {
                    const idDetalle = this.getAttribute('data-iddetalle');

                    Swal.fire({
                        title: '<i class="bi bi-upc-scan" style="color: var(--neon-blue-base);"></i> Asignar IMEI',
                        html: '<p style="color: var(--text-muted); font-size: 0.9rem;">Digitá o escaneá el número de serie / IMEI para este dispositivo:</p>',
                        input: 'text',
                        inputPlaceholder: 'Ej. 359123456789012',
                        background: 'var(--bg-card)',
                        color: 'var(--text-main)',
                        showCancelButton: true,
                        confirmButtonColor: 'var(--neon-green)',
                        cancelButtonColor: 'var(--neon-red)',
                        confirmButtonText: '<i class="bi bi-check-lg"></i> Guardar',
                        cancelButtonText: 'Cancelar',
                        customClass: {
                            popup: 'border border-secondary rounded-4 shadow-lg',
                            input: 'bg-transparent text-main border-secondary'
                        },
                        inputValidator: (value) => {
                            const imeiLimpio = value ? value.trim() : '';
                            const regex = /^\d{15}$/;

                            if (!regex.test(imeiLimpio)) {
                                return '¡El IMEI debe tener exactamente 15 números y no contener letras!';
                            }
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const imeiDigitado = result.value.trim();

                            fetch('@Url.Action("AsignarImei", "Pedido")', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded'
                                },
                                body: `idDetallePedido=${idDetalle}&imei=${encodeURIComponent(imeiDigitado)}`
                            })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire({
                                        title: "¡Listo!",
                                        text: data.message,
                                        icon: "success",
                                        background: 'var(--bg-card)',
                                        color: 'var(--text-main)',
                                        confirmButtonColor: 'var(--neon-blue-base)'
                                    }).then(() => location.reload());
                                } else {
                                    Swal.fire({
                                        title: "No se pudo asignar",
                                        text: data.message,
                                        icon: "error",
                                        background: 'var(--bg-card)',
                                        color: 'var(--text-main)',
                                        confirmButtonColor: 'var(--neon-red)'
                                    });
                                }
                            })
                            .catch(error => {
                                Swal.fire("Error de Red", "No se pudo comunicar con el servidor.", "error");
                            });
                        }
                    });
                });
            });

        });
    </script>
}