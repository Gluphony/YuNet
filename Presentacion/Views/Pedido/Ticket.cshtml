@model List<Entidades.DetallePedido>

@{
    ViewData["Title"] = "Ticket de Pedido";
    // ¡Usamos tu propiedad calculada SUBTOTAL para que sea más limpio!
    decimal totalPedido = Model != null && Model.Any() ? Model.Sum(d => d.SUBTOTAL) : 0;
}

<style>
    /* ==========================================
                   VARIABLES NEÓN Y TEMAS (Basado en el Home)
                   ========================================== */
    :root {
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
        --neon-red-base: #ff4d4d;
        --neon-red-glow: rgba(255, 77, 77, 0.4);
        --neon-red-tint: rgba(255, 77, 77, 0.1);
        --neon-yellow: #ffcc00;
        --neon-green: #00FF7F;
    }

    /* Diseño de la Tarjeta Ticket */
    .ticket-card {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        position: relative;
        color: var(--text-main);
    }

        /* Borde luminoso superior */
        .ticket-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--neon-blue-base), transparent);
        }

    /* Botones Neón */
    .btn-neon {
        background: transparent;
        color: var(--neon-blue-base) !important;
        border: 1px solid var(--neon-blue-base);
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-neon:hover {
            background: var(--neon-blue-base);
            color: #fff !important;
            box-shadow: 0 0 15px var(--neon-blue-glow);
            transform: translateY(-2px);
        }

    /* Botón Neón Rojo (Para Reportar) */
    .btn-neon-danger {
        background: transparent;
        color: var(--neon-red-base) !important;
        border: 1px solid var(--neon-red-base);
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-neon-danger:hover {
            background: var(--neon-red-base);
            color: #fff !important;
            box-shadow: 0 0 15px var(--neon-red-glow);
            transform: translateY(-2px);
        }

    /* NUEVO: Botón Amarillo para IMEI */
    .btn-neon-warning {
        background: transparent;
        color: var(--neon-yellow) !important;
        border: 1px solid var(--neon-yellow);
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-neon-warning:hover {
            background: var(--neon-yellow);
            color: #000 !important;
            box-shadow: 0 0 15px rgba(255, 204, 0, 0.4);
            transform: translateY(-2px);
        }

    .btn-outline-custom {
        background: transparent;
        color: var(--text-main);
        border: 1px solid var(--border-color);
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-outline-custom:hover {
            border-color: var(--neon-blue-base);
            color: var(--neon-blue-base);
            background-color: var(--neon-blue-tint);
        }

    /* Caja del Total Neón */
    .total-box {
        background-color: var(--neon-blue-tint);
        border: 1px solid rgba(0, 212, 255, 0.3);
        border-radius: 12px;
        box-shadow: 0 0 15px var(--neon-blue-tint);
        transition: all 0.3s ease;
    }

        .total-box:hover {
            border-color: var(--neon-blue-base);
            box-shadow: 0 0 20px var(--neon-blue-glow);
        }

    /* ==========================================
                   ESTILOS PARA LA TABLA DEL TICKET
                   ========================================== */
    .table-ticket {
        background-color: transparent !important;
        color: var(--text-main) !important;
    }

        .table-ticket thead th {
            background-color: var(--neon-blue-tint) !important;
            color: var(--neon-blue-base) !important;
            border-bottom: 2px dashed var(--border-color) !important;
        }

        .table-ticket tbody tr {
            background-color: transparent !important;
        }

        .table-ticket tbody td {
            background-color: transparent !important;
            color: var(--text-main) !important;
            border-bottom: 1px dashed var(--border-color) !important;
        }

    .ticket-totales {
        background-color: rgba(0, 0, 0, 0.2);
        border-radius: 8px;
    }

    /* ==========================================
                   ESTILOS DE IMPRESIÓN (Blanco y Negro)
                   ========================================== */
    @@media print {
        body {
            background-color: white !important;
        }

        .d-print-none {
            display: none !important;
        }

        .ticket-card {
            box-shadow: none !important;
            border: 1px solid #000 !important;
            background-color: white !important;
        }

            .ticket-card::before {
                display: none !important;
            }

            .ticket-card * {
                color: black !important;
            }

        .total-box {
            background-color: transparent !important;
            border: 1px solid #000 !important;
            box-shadow: none !important;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <h2 class="h3 mb-0" style="color: var(--text-main); font-weight: 700;">
            <i class="bi bi-receipt-cutoff me-2" style="color: var(--neon-blue-base);"></i>Detalle del Pedido
        </h2>
        <p class="mb-0 mt-1" style="color: var(--text-muted); font-size: 0.9rem;">Revisión de artículos y totales</p>
    </div>

    <div>
        <a href="javascript:history.back()" class="btn btn-outline-custom px-3 py-2 me-2">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
        <button onclick="window.print()" class="btn btn-neon px-3 py-2">
            <i class="bi bi-printer me-2"></i>Imprimir Ticket
        </button>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center d-print-none" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 8px; border-left: 4px solid #dc3545 !important;">
        <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>
        <div>@ViewBag.Error</div>
    </div>
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center d-print-none" style="background-color: rgba(0, 212, 255, 0.1); color: var(--neon-blue-base); border-radius: 8px; border-left: 4px solid var(--neon-blue-base) !important;">
        <i class="bi bi-check-circle-fill fs-5 me-3"></i>
        <div>@TempData["MensajeExito"]</div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="ticket-card mb-4" id="seccionTicket">

            <div class="card-header p-4 text-center" style="background-color: transparent; border-bottom: 1px dashed rgba(255,255,255,0.2);">
                <h4 class="fw-bold mb-1" style="color: var(--text-main); text-transform: uppercase; letter-spacing: 1px;">Tu Empresa POS</h4>
                <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">Ticket de Venta / Comprobante</p>
                @if (Model != null && Model.Any())
                {
                    <div class="mt-3 d-inline-block px-4 py-2" style="background-color: var(--bg-main); border-radius: 8px; border: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted); font-size: 0.85rem;">Pedido No.</span>
                        <strong style="color: var(--neon-blue-base); font-size: 1.2rem; text-shadow: 0 0 8px var(--neon-blue-glow);" class="ms-1">#@ViewBag.NumeroPedido</strong>
                    </div>
                }
            </div>

            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0">
                        <thead style="border-bottom: 1px solid var(--border-color);">
                            <tr>
                                <th scope="col" class="pb-3 text-uppercase" style="font-size: 0.75rem; color: var(--neon-blue-base); letter-spacing: 0.5px;">Cant.</th>
                                <th scope="col" class="pb-3 text-uppercase" style="font-size: 0.75rem; color: var(--neon-blue-base); letter-spacing: 0.5px;">Descripción</th>
                                <th scope="col" class="pb-3 text-uppercase text-end" style="font-size: 0.75rem; color: var(--neon-blue-base); letter-spacing: 0.5px;">Precio Unit.</th>
                                <th scope="col" class="pb-3 text-uppercase text-end" style="font-size: 0.75rem; color: var(--neon-blue-base); letter-spacing: 0.5px;">Importe</th>
                                <th scope="col" class="pb-3 text-uppercase text-center d-print-none" style="font-size: 0.75rem; color: var(--neon-blue-base); letter-spacing: 0.5px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody style="border-bottom: 1px dashed rgba(255,255,255,0.2);">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="py-3 fw-bold" style="background-color: transparent; color: var(--text-main); width: 10%;">@item.CANTIDAD</td>

                                        <td class="py-3" style="background-color: transparent; color: var(--text-main); width: 40%;">
                                            <span class="d-block fw-bold">@item.PRODUCTO</span>

                                            @if (item.IMEI_VENDIDO != "N/A" && !string.IsNullOrWhiteSpace(item.IMEI_VENDIDO))
                                            {
                                                <small style="color: var(--neon-blue-base); font-size: 0.8rem; letter-spacing: 0.5px;">IMEI/Serie: @item.IMEI_VENDIDO</small>
                                            }
                                        </td>

                                        <td class="py-3 text-end" style="background-color: transparent; color: var(--text-muted); width: 15%;">@item.PRECIO_UNITARIO.ToString("C")</td>

                                        <td class="py-3 text-end fw-bold" style="background-color: transparent; color: var(--text-main); width: 15%;">@item.SUBTOTAL.ToString("C")</td>

                                        <td class="py-3 text-center d-print-none" style="background-color: transparent; width: 20%;">

                                            @if (User.IsInRole("Administrador") && (item.IMEI_VENDIDO == "N/A" || string.IsNullOrWhiteSpace(item.IMEI_VENDIDO)))
                                            {
                                                <button type="button" class="btn btn-sm btn-neon-warning mb-2 btn-asignar-imei w-100"
                                                        data-iddetalle="@item.ID_DETALLE_PEDIDO">
                                                    <i class="bi bi-upc-scan"></i> Asignar IMEI
                                                </button>
                                            }

                                            @if (item.Tiene_Devolucion)
                                            {
                                                <span class="badge" style="background-color: var(--neon-blue-tint); color: var(--neon-blue-base); border: 1px solid var(--neon-blue-base); font-size: 0.85rem; padding: 0.4em 0.8em; box-shadow: 0 0 5px var(--neon-blue-glow); display: block;">
                                                    @item.ESTADO_REPORTE
                                                </span>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-neon-danger w-100 mt-1"
                                                        onclick="abrirModalReporte(@item.ID_DETALLE_PEDIDO, '@item.PRODUCTO.Replace("'", "\\'")')">
                                                    <i class="bi bi-exclamation-circle me-1"></i> Reportar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else if (ViewBag.Error == null)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5" style="background-color: transparent;">
                                        <i class="bi bi-cart-x fs-2 mb-2 d-block" style="color: var(--neon-blue-base); opacity: 0.5;"></i>
                                        <span style="color: var(--text-muted);">No hay detalles para este pedido.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-end mt-4">
                    <div class="col-md-6 col-lg-5">
                        <div class="d-flex justify-content-between mb-2 px-2">
                            <span style="color: var(--text-muted);">Subtotal:</span>
                            <span style="color: var(--text-main); font-weight: 500;">@totalPedido.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 px-2">
                            <span style="color: var(--text-muted);">Impuestos (0%):</span>
                            <span style="color: var(--text-main); font-weight: 500;">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between p-3 total-box mt-2">
                            <span class="fw-bold text-uppercase" style="color: var(--text-main); letter-spacing: 1px;">Total:</span>
                            <span class="fw-bold fs-4" style="color: var(--neon-blue-base); text-shadow: 0 0 10px var(--neon-blue-glow);">@totalPedido.ToString("C")</span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="card-footer text-center py-4" style="background-color: transparent; border-top: none;">
                <p class="mb-1 fw-bold fs-5" style="color: var(--text-main);">¡Gracias por tu compra!</p>
                <small style="color: var(--text-muted); opacity: 0.8;">Por favor conserva este ticket para cualquier aclaración o devolución.</small>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalReporte" tabindex="-1" aria-labelledby="modalReporteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; box-shadow: 0 0 20px rgba(0,0,0,0.5);">
            <div class="modal-header" style="border-bottom: 1px dashed rgba(255,255,255,0.1);">
                <h5 class="modal-title fw-bold" id="modalReporteLabel" style="color: var(--neon-red-base); text-shadow: 0 0 8px var(--neon-red-glow);">
                    <i class="bi bi-shield-exclamation me-2"></i>Reportar Problema
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Devolucion" asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <p style="color: var(--text-muted); font-size: 0.95rem;">
                        Estás a punto de reportar el producto:<br />
                        <strong id="lblProductoReporte" style="color: var(--text-main); display: block; margin-top: 5px;"></strong>
                    </p>

                    <input type="hidden" id="inputDetalleDevolucion" name="ID_DETALLE_DEVOLUCION" value="" />
                    <input type="hidden" id="idDetalleReporte" /> <div class="mb-3 mt-4">
                        <label for="motivoReporte" class="form-label" style="color: var(--neon-blue-base);">Motivo de la devolución</label>
                        <textarea class="form-control" id="motivoReporte" name="MOTIVO_CLIENTE" rows="4" required
                                  style="background-color: rgba(0,0,0,0.2); color: var(--text-main); border: 1px solid var(--border-color); resize: none;"
                                  placeholder="Ej: La pantalla vino rota, no enciende..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px dashed rgba(255,255,255,0.1);">
                    <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-neon-danger px-4" onclick="enviarReporteAjax(event)">
                        Enviar Reporte
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ============================================
        // 1. FUNCIONES PARA EL REPORTE (DEVOLUCIÓN)
        // ============================================
        function abrirModalReporte(idDetalle, producto) {
            document.getElementById('idDetalleReporte').value = idDetalle;
            document.getElementById('lblProductoReporte').innerText = producto;
            var modal = new bootstrap.Modal(document.getElementById('modalReporte'));
            modal.show();
        }

        function enviarReporteAjax(event) {
            event.preventDefault(); // Evitamos que el formulario haga POST tradicional

            var idDetalle = document.getElementById('idDetalleReporte').value;
            var motivo = document.getElementById('motivoReporte').value;

            if (motivo.trim() === '') {
                Swal.fire("Atención", "Por favor, escribe un motivo para la devolución.", "warning");
                return;
            }

            $.post('/Devolucion/Create', {
                ID_DETALLE_PEDIDO: idDetalle,
                MOTIVO_CLIENTE: motivo
            }, function (response) {
                if (response.exito) {
                    Swal.fire("¡Éxito!", response.mensaje, "success").then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire("Error", response.mensaje, "error");
                }
            }).fail(function () {
                Swal.fire("Error de Conexión", "Ocurrió un error al enviar el reporte.", "error");
            });
        }

        // ============================================
        // 2. NUEVO: FUNCIÓN PARA ASIGNAR IMEI (ADMIN)
        // ============================================
        document.querySelectorAll('.btn-asignar-imei').forEach(boton => {
            boton.addEventListener('click', function () {
                const idDetalle = this.getAttribute('data-iddetalle');

                Swal.fire({
                    title: '<i class="bi bi-upc-scan" style="color: var(--neon-yellow);"></i> Asignar IMEI',
                    html: '<p style="color: var(--text-muted); font-size: 0.9rem;">Digitá o escaneá el número de serie / IMEI para entregar este dispositivo:</p>',
                    input: 'text',
                    inputPlaceholder: 'Ej. 359123456789012',
                    background: 'var(--bg-card)',
                    color: 'var(--text-main)',
                    showCancelButton: true,
                    confirmButtonColor: 'var(--neon-green)',
                    cancelButtonColor: 'var(--neon-red)',
                    confirmButtonText: '<i class="bi bi-check-lg"></i> Asignar y Despachar',
                    cancelButtonText: 'Cancelar',
                    customClass: {
                        popup: 'border border-secondary rounded-4 shadow-lg',
                        input: 'bg-transparent text-white border-secondary text-center fw-bold fs-5'
                    },
                    inputAttributes: {
                        maxlength: '15', // Bloquea el teclado para no escribir más de 15
                        oninput: "this.value = this.value.replace(/[^0-9]/g, '')" // Borra letras al instante
                    },
                    inputValidator: (value) => {
                        if (!value) {
                            return '¡El IMEI no puede estar vacío!';
                        }
                        // Verifica que sean exactamente 15 números
                        const regexSoloNumeros = /^[0-9]{15}$/;
                        if (!regexSoloNumeros.test(value.trim())) {
                            return '¡El IMEI debe tener exactamente 15 números (sin letras ni espacios)!';
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        const imeiDigitado = result.value;

                        // Petición AJAX al controlador
                        fetch('@Url.Action("AsignarImei", "Pedido")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: `idDetallePedido=${idDetalle}&imei=${encodeURIComponent(imeiDigitado)}`
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    title: "¡Asignado!",
                                    text: data.message,
                                    icon: "success",
                                    background: 'var(--bg-card)',
                                    color: 'var(--text-main)',
                                    confirmButtonColor: 'var(--neon-blue-base)'
                                }).then(() => location.reload()); // Recarga para ver el cambio
                            } else {
                                Swal.fire({
                                    title: "Error al asignar",
                                    text: data.message,
                                    icon: "error",
                                    background: 'var(--bg-card)',
                                    color: 'var(--text-main)',
                                    confirmButtonColor: 'var(--neon-red)'
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire("Error de Red", "No se pudo comunicar con el servidor.", "error");
                        });
                    }
                });
            });
        });
    </script>
}