@model List<Entidades.DetallePedido>

@{
    ViewData["Title"] = "Ticket de Pedido";
    // ¡Usamos tu propiedad calculada SUBTOTAL para que sea más limpio!
    decimal totalPedido = Model != null && Model.Any() ? Model.Sum(d => d.SUBTOTAL) : 0;
}

<style>
    /* ==========================================
           VARIABLES NEÓN Y TEMAS (Basado en el Home)
           ========================================== */
    :root {
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
    }

    /* Diseño de la Tarjeta Ticket */
    .ticket-card {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        position: relative;
        color: var(--text-main);
    }

        /* Borde luminoso superior */
        .ticket-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--neon-blue-base), transparent);
        }

    /* Botones Neón */
    .btn-neon {
        background: transparent;
        color: var(--neon-blue-base) !important;
        border: 1px solid var(--neon-blue-base);
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-neon:hover {
            background: var(--neon-blue-base);
            color: #fff !important;
            box-shadow: 0 0 15px var(--neon-blue-glow);
            transform: translateY(-2px);
        }

    .btn-outline-custom {
        background: transparent;
        color: var(--text-main);
        border: 1px solid var(--border-color);
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-outline-custom:hover {
            border-color: var(--neon-blue-base);
            color: var(--neon-blue-base);
            background-color: var(--neon-blue-tint);
        }

    /* Caja del Total Neón */
    .total-box {
        background-color: var(--neon-blue-tint);
        border: 1px solid rgba(0, 212, 255, 0.3);
        border-radius: 12px;
        box-shadow: 0 0 15px var(--neon-blue-tint);
        transition: all 0.3s ease;
    }

        .total-box:hover {
            border-color: var(--neon-blue-base);
            box-shadow: 0 0 20px var(--neon-blue-glow);
        }

    /* ==========================================
       ESTILOS PARA LA TABLA DEL TICKET
       ========================================== */
    .table-ticket {
        background-color: transparent !important;
        color: var(--text-main) !important;
    }

        .table-ticket thead th {
            background-color: var(--neon-blue-tint) !important; /* Le da un toque neón al encabezado */
            color: var(--neon-blue-base) !important;
            border-bottom: 2px dashed var(--border-color) !important;
        }

        .table-ticket tbody tr {
            background-color: transparent !important;
        }

        .table-ticket tbody td {
            background-color: transparent !important; /* Elimina el fondo blanco rebelde */
            color: var(--text-main) !important;
            border-bottom: 1px dashed var(--border-color) !important; /* Línea punteada estilo ticket */
        }

    /* Para la sección de los totales */
    .ticket-totales {
        background-color: rgba(0, 0, 0, 0.2); /* Un fondo sutilmente más oscuro para resaltar el total */
        border-radius: 8px;
    }
    /* ==========================================
           ESTILOS DE IMPRESIÓN (Blanco y Negro)
           ========================================== */
    @@media print {
        body

    {
        background-color: white !important;
    }

    .d-print-none {
        display: none !important;
    }

    .ticket-card {
        box-shadow: none !important;
        border: 1px solid #000 !important;
        background-color: white !important;
    }

        .ticket-card::before {
            display: none !important;
        }

        .ticket-card * {
            color: black !important;
        }

    .total-box {
        background-color: transparent !important;
        border: 1px solid #000 !important;
        box-shadow: none !important;
    }

    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <h2 class="h3 mb-0" style="color: var(--text-main); font-weight: 700;">
            <i class="bi bi-receipt-cutoff me-2" style="color: var(--neon-blue-base);"></i>Detalle del Pedido
        </h2>
        <p class="mb-0 mt-1" style="color: var(--text-muted); font-size: 0.9rem;">Revisión de artículos y totales</p>
    </div>

    <div>
        <a href="javascript:history.back()" class="btn btn-outline-custom px-3 py-2 me-2">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
        <button onclick="window.print()" class="btn btn-neon px-3 py-2">
            <i class="bi bi-printer me-2"></i>Imprimir Ticket
        </button>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center d-print-none" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 8px; border-left: 4px solid #dc3545 !important;">
        <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>
        <div>@ViewBag.Error</div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="ticket-card mb-4" id="seccionTicket">

            <div class="card-header p-4 text-center" style="background-color: transparent; border-bottom: 1px dashed rgba(255,255,255,0.2);">
                <h4 class="fw-bold mb-1" style="color: var(--text-main); text-transform: uppercase; letter-spacing: 1px;">Tu Empresa POS</h4>
                <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">Ticket de Venta / Comprobante</p>
                @if (Model != null && Model.Any())
                {
                    <div class="mt-3 d-inline-block px-4 py-2" style="background-color: var(--bg-main); border-radius: 8px; border: 1px solid var(--border-color);">
                        <span style="color: var(--text-muted); font-size: 0.85rem;">Pedido No.</span>
                        <strong style="color: var(--neon-blue-base); font-size: 1.2rem; text-shadow: 0 0 8px var(--neon-blue-glow);" class="ms-1">#@Model.First().ID_PEDIDO</strong>
                    </div>
                }
            </div>

            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0">
                        <thead style="border-bottom: 1px solid var(--border-color);">
                            <tr>
                                <th scope="col" class="pb-3 text-uppercase" style="font-size: 0.75rem; color: var(--neon-blue-base); letter-spacing: 0.5px;">Cant.</th>
                                <th scope="col" class="pb-3 text-uppercase" style="font-size: 0.75rem; color: var(--neon-blue-base); letter-spacing: 0.5px;">Descripción</th>
                                <th scope="col" class="pb-3 text-uppercase text-end" style="font-size: 0.75rem; color: var(--neon-blue-base); letter-spacing: 0.5px;">Precio Unit.</th>
                                <th scope="col" class="pb-3 text-uppercase text-end" style="font-size: 0.75rem; color: var(--neon-blue-base); letter-spacing: 0.5px;">Importe</th>
                            </tr>
                        </thead>
                        <tbody style="border-bottom: 1px dashed rgba(255,255,255,0.2);">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="py-3 fw-bold" style="background-color: transparent; color: var(--text-main); width: 10%;">@item.CANTIDAD</td>

                                        <td class="py-3" style="background-color: transparent; color: var(--text-main); width: 50%;">
                                            <span class="d-block fw-bold">@item.PRODUCTO</span>

                                            @if (item.IMEI_VENDIDO != "N/A" && !string.IsNullOrWhiteSpace(item.IMEI_VENDIDO))
                                            {
                                                <small style="color: var(--neon-blue-base); font-size: 0.8rem; letter-spacing: 0.5px;">IMEI/Serie: @item.IMEI_VENDIDO</small>
                                            }
                                        </td>

                                        <td class="py-3 text-end" style="background-color: transparent; color: var(--text-muted); width: 20%;">@item.PRECIO_UNITARIO.ToString("C")</td>

                                        <td class="py-3 text-end fw-bold" style="background-color: transparent; color: var(--text-main); width: 20%;">@item.SUBTOTAL.ToString("C")</td>
                                    </tr>
                                }

                                }
                            else if (ViewBag.Error == null)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5" style="background-color: transparent;">
                                        <i class="bi bi-cart-x fs-2 mb-2 d-block" style="color: var(--neon-blue-base); opacity: 0.5;"></i>
                                        <span style="color: var(--text-muted);">No hay detalles para este pedido.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-end mt-4">
                    <div class="col-md-6 col-lg-5">
                        <div class="d-flex justify-content-between mb-2 px-2">
                            <span style="color: var(--text-muted);">Subtotal:</span>
                            <span style="color: var(--text-main); font-weight: 500;">@totalPedido.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 px-2">
                            <span style="color: var(--text-muted);">Impuestos (0%):</span>
                            <span style="color: var(--text-main); font-weight: 500;">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between p-3 total-box mt-2">
                            <span class="fw-bold text-uppercase" style="color: var(--text-main); letter-spacing: 1px;">Total:</span>
                            <span class="fw-bold fs-4" style="color: var(--neon-blue-base); text-shadow: 0 0 10px var(--neon-blue-glow);">@totalPedido.ToString("C")</span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="card-footer text-center py-4" style="background-color: transparent; border-top: none;">
                <p class="mb-1 fw-bold fs-5" style="color: var(--text-main);">¡Gracias por tu compra!</p>
                <small style="color: var(--text-muted); opacity: 0.8;">Por favor conserva este ticket para cualquier aclaración o devolución.</small>
            </div>
        </div>
    </div>
</div>