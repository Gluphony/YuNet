@model IEnumerable<Entidades.Pedido>

@{
    ViewData["Title"] = "Mis Pedidos";
}

<style>
    /* ==========================================
           VARIABLES Y ESTILOS BASE
           ========================================== */
    :root {
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
        --neon-green: #00FF7F;
        --neon-red: #ff3366;
        --neon-yellow: #ffcc00;
        --bg-card: #0F172A;
        --border-color: rgba(255, 255, 255, 0.1);
        --text-main: #F8FAFC;
        --text-muted: #94A3B8;
    }

    /* Tarjetas de Pedido E-commerce */
    .customer-order-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        margin-bottom: 1.5rem;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .customer-order-card:hover {
            border-color: rgba(0, 212, 255, 0.3);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

    .order-header {
        background-color: rgba(255, 255, 255, 0.02);
        border-bottom: 1px solid var(--border-color);
        padding: 1rem 1.5rem;
    }

    .order-body {
        padding: 1.5rem;
    }

    /* Textos */
    .text-label {
        color: var(--text-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.2rem;
        display: block;
    }

    .text-value {
        color: var(--text-main);
        font-weight: 600;
        font-size: 1rem;
        margin: 0;
    }

    /* Badges de Estado Neón */
    .status-badge {
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.5em 1em;
        border-radius: 8px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .status-badge.completado {
            color: var(--neon-green);
            background-color: rgba(0, 255, 127, 0.1);
            border: 1px solid var(--neon-green);
        }

        .status-badge.pendiente {
            color: var(--neon-yellow);
            background-color: rgba(255, 204, 0, 0.1);
            border: 1px solid var(--neon-yellow);
        }

        .status-badge.cancelado {
            color: var(--neon-red);
            background-color: rgba(255, 51, 102, 0.1);
            border: 1px solid var(--neon-red);
        }

    /* Botones de Acción Cliente */
    .btn-customer {
        border-radius: 8px;
        font-weight: 600;
        padding: 0.6rem 1.2rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .btn-details {
        background-color: var(--neon-blue-tint);
        color: var(--neon-blue-base) !important;
        border: 1px solid rgba(0, 212, 255, 0.2);
    }

        .btn-details:hover {
            background-color: var(--neon-blue-base);
            color: #000 !important;
            box-shadow: 0 0 15px var(--neon-blue-glow);
        }

    .btn-report {
        background-color: transparent;
        color: var(--text-muted) !important;
        border: 1px solid var(--border-color);
    }

        .btn-report:hover {
            background-color: rgba(255, 51, 102, 0.1);
            color: var(--neon-red) !important;
            border-color: var(--neon-red);
        }
</style>

<div class="container-fluid container-xl py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 m-0" style="color: var(--text-main); font-weight: 700;">
            <i class="bi bi-bag-check me-2" style="color: var(--neon-blue-base);"></i> Mis Pedidos
        </h2>

        <div class="dropdown">
            <button class="btn btn-customer dropdown-toggle" type="button" id="btnFiltrarPedidos" data-bs-toggle="dropdown" aria-expanded="false" style="border: 1px solid var(--border-color); color: var(--text-main);">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="btnFiltrarPedidos" style="background-color: var(--bg-card); border: 1px solid var(--border-color);">
                <li><a class="dropdown-item btn-filtro" href="#" data-filtro="TODOS">Todos los pedidos</a></li>
                <li><hr class="dropdown-divider" style="border-color: var(--border-color);"></li>
                <li><a class="dropdown-item btn-filtro" href="#" data-filtro="COMPLETADO" style="color: var(--neon-green);">Completados</a></li>
                <li><a class="dropdown-item btn-filtro" href="#" data-filtro="PENDIENTE" style="color: var(--neon-yellow);">Pendientes</a></li>
                <li><a class="dropdown-item btn-filtro" href="#" data-filtro="CANCELADO" style="color: var(--neon-red);">Cancelados</a></li>
            </ul>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                // Configuración de estado visual
                string estadoStr = item.ESTADO?.ToUpper() ?? "DESCONOCIDO";
                string claseBadge = estadoStr == "COMPLETADO" ? "completado" : estadoStr == "PENDIENTE" ? "pendiente" : "cancelado";
                string iconBadge = estadoStr == "COMPLETADO" ? "bi-check-circle" : estadoStr == "PENDIENTE" ? "bi-clock-history" : "bi-x-circle";

                <div class="col-12 tarjeta-pedido-wrapper" data-estado="@estadoStr">
                    <div class="customer-order-card">
                        <div class="order-header d-flex flex-column flex-md-row justify-content-between gap-3">
                            <div class="d-flex gap-4 flex-wrap">
                                <div>
                                    <span class="text-label">Fecha del Pedido</span>
                                    <p class="text-value">@item.FECHA_PEDIDO.ToString("dd 'de' MMM, yyyy")</p>
                                </div>
                                <div>
                                    <span class="text-label">Total Pagado</span>
                                    <p class="text-value" style="color: var(--neon-blue-base);">C$ @item.TOTAL.ToString("N2")</p>
                                </div>
                            </div>
                            <div class="text-md-end">
                                <span class="text-label">N° de Pedido</span>
                                <p class="text-value">#@item.ID_PEDIDO</p>
                            </div>
                        </div>

                        <div class="order-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
                            <div>
                                <span class="text-label mb-2">Estado Actual</span>
                                <div class="status-badge @claseBadge">
                                    <i class="bi @iconBadge"></i> @item.ESTADO
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 justify-content-end">
                                <a href="@Url.Action("Details", "Pedido", new { id = item.ID_PEDIDO })" class="btn btn-customer btn-details text-decoration-none">
                                    <i class="bi bi-box-seam"></i> Ver Productos
                                </a>

                                <button type="button" class="btn btn-customer btn-report" onclick="abrirModalReporte('@item.ID_PEDIDO')">
                                    <i class="bi bi-exclamation-triangle"></i> Reportar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column justify-content-center align-items-center p-5 mt-4" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px;">
            <div class="mb-3">
                <i class="bi bi-bag-x" style="font-size: 3rem; color: var(--text-muted);"></i>
            </div>
            <h5 class="text-white">Aún no tienes compras</h5>
            <p style="color: var(--text-muted);">Tus pedidos aparecerán aquí una vez que finalices una compra.</p>
            <a href="@Url.Action("Index", "Tienda")" class="btn btn-customer btn-details mt-2">Ir a la tienda</a>
        </div>
    }
</div>

<div class="modal fade" id="modalReporte" tabindex="-1" aria-labelledby="modalReporteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px;">

            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title" id="modalReporteLabel" style="color: var(--text-main); font-weight: bold;">
                    <i class="bi bi-exclamation-triangle" style="color: var(--neon-red);"></i> Reportar Problema
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <form id="formReporte">
                    <div class="mb-3">
                        <label class="form-label text-label">Número de Pedido</label>
                        <input type="text" class="form-control" id="txtIdPedidoReporte" readonly
                               style="background-color: rgba(255,255,255,0.02); color: var(--neon-blue-base); border: 1px solid var(--border-color); font-weight: bold;">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-label">¿Qué problema tuviste?</label>
                        <select class="form-select" id="cboMotivoReporte"
                                style="background-color: rgba(255,255,255,0.05); color: var(--text-main); border: 1px solid var(--border-color);">
                            <option value="Producto dañado" style="color: black;">El producto llegó dañado o defectuoso</option>
                            <option value="Producto incorrecto" style="color: black;">Me enviaron un producto incorrecto</option>
                            <option value="Faltan artículos" style="color: black;">Faltan artículos en mi paquete</option>
                            <option value="No llegó" style="color: black;">Mi pedido nunca llegó</option>
                            <option value="Otro" style="color: black;">Otro problema</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-label">Detalles adicionales</label>
                        <textarea class="form-control" id="txtDetalleReporte" rows="3" placeholder="Por favor, explica detalladamente qué sucedió..."
                                  style="background-color: rgba(255,255,255,0.05); color: var(--text-main); border: 1px solid var(--border-color);"></textarea>
                    </div>
                </form>
            </div>

            <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-customer" data-bs-dismiss="modal" style="color: var(--text-muted); border: 1px solid var(--border-color); background: transparent;">Cancelar</button>
                <button type="button" class="btn btn-customer" id="btnEnviarReporte" style="background-color: var(--neon-red); color: white; border: none; box-shadow: 0 0 15px rgba(255, 51, 102, 0.4);">
                    <i class="bi bi-send-fill me-1"></i> Enviar Reporte
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Declaramos la variable global para el modal
        let modalReporteBootstrap;

        // Función global para abrir el modal
        function abrirModalReporte(idPedido) {
            // Llenamos los campos del modal
            document.getElementById('txtIdPedidoReporte').value = idPedido;
            document.getElementById('cboMotivoReporte').selectedIndex = 0;
            document.getElementById('txtDetalleReporte').value = '';

            // Instanciamos el modal si no existe
            if (!modalReporteBootstrap) {
                const modalEl = document.getElementById('modalReporte');
                modalReporteBootstrap = new bootstrap.Modal(modalEl);
            }

            // Lo mostramos
            modalReporteBootstrap.show();
        }

        document.addEventListener("DOMContentLoaded", function () {

            // --- LÓGICA DEL FILTRO ---
            const botonesFiltro = document.querySelectorAll('.btn-filtro');
            const tarjetas = document.querySelectorAll('.tarjeta-pedido-wrapper');

            botonesFiltro.forEach(boton => {
                boton.addEventListener('click', function (e) {
                    e.preventDefault();
                    const filtroSeleccionado = this.getAttribute('data-filtro');

                    tarjetas.forEach(tarjeta => {
                        if (filtroSeleccionado === "TODOS" || tarjeta.getAttribute('data-estado') === filtroSeleccionado) {
                            tarjeta.style.display = 'block';
                        } else {
                            tarjeta.style.display = 'none';
                        }
                    });
                });
            });

            // --- LÓGICA DE ENVIAR REPORTE ---
            document.getElementById('btnEnviarReporte').addEventListener('click', function () {
                const idPedido = document.getElementById('txtIdPedidoReporte').value;
                const motivo = document.getElementById('cboMotivoReporte').value;
                const detalle = document.getElementById('txtDetalleReporte').value;

                if (detalle.trim() === '') {
                    alert('Por favor, escribe un poco de detalle sobre el problema.');
                    return;
                }

                // Juntamos el motivo principal y el detalle
                const motivoCompleto = motivo + " - " + detalle;

                const formData = new FormData();
                formData.append("ID_DETALLE_PEDIDO", idPedido);
                formData.append("MOTIVO_CLIENTE", motivoCompleto);

                const btnEnviar = document.getElementById('btnEnviarReporte');
                const textoOriginal = btnEnviar.innerHTML;

                // Mostramos estado de carga
                btnEnviar.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Enviando...';
                btnEnviar.disabled = true;

                // Petición al backend
                fetch('/Devolucion/Create', {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    // Verificamos que la respuesta sea un JSON válido
                    if (!response.ok) {
                        throw new Error('Error en la red o en el servidor');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.exito) {
                        alert('✅ ¡Reporte enviado! Nos pondremos en contacto contigo pronto.');
                        if (modalReporteBootstrap) {
                            modalReporteBootstrap.hide();
                        }
                    } else {
                        alert('❌ Hubo un problema: ' + (data.mensaje || 'Error desconocido.'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Ocurrió un error al intentar enviar el reporte. Verifica la consola para más detalles.');
                })
                .finally(() => {
                    // Restauramos el botón
                    btnEnviar.innerHTML = textoOriginal;
                    btnEnviar.disabled = false;
                });
            });

        });
    </script>
}