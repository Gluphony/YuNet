@model IEnumerable<Entidades.Pedido>

@{
    ViewData["Title"] = "Mis Pedidos";
}

<style>
    /* ==========================================
               1. VARIABLES GLOBALES (MODO CLARO POR DEFECTO)
               Basadas exactamente en el diseño de tu Catálogo
            ========================================== */
    :root {
        --bg-main: #F4F7FE;
        --bg-card: #FFFFFF;
        --text-main: #2B3674;
        --text-muted: #707EAE;
        --border-color: #E2E8F0;
        /* Variables Neón */
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.05);
        --neon-green: #05CD99;
        --neon-red: #EE5D50;
        --neon-yellow: #ffcc00;
    }

    /* ==========================================
               1.5 VARIABLES MODO OSCURO (Adaptativo)
            ========================================== */
    [data-bs-theme="dark"], body.dark-theme, body.dark-mode, [data-theme="dark"], .dark-layout {
        --bg-main: #13131A;
        --bg-card: #1C1C24;
        --text-main: #FFFFFF;
        --text-muted: #8A8A98;
        --border-color: #2D2D3A;
        /* Variables Neón Brillantes */
        --neon-blue-glow: rgba(0, 212, 255, 0.5);
        --neon-blue-tint: rgba(0, 212, 255, 0.15);
        --neon-green: #20C997;
        --neon-red: #E83E8C;
    }

    /* ==========================================
               TARJETAS Y ESTRUCTURAS BASE
            ========================================== */
    .customer-order-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        margin-bottom: 1.5rem;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
    }

        .customer-order-card:hover {
            border-color: rgba(0, 212, 255, 0.3);
            box-shadow: 0 8px 25px var(--neon-blue-glow);
        }

    .order-header {
        background-color: var(--bg-main);
        border-bottom: 1px solid var(--border-color);
        padding: 1rem 1.5rem;
        transition: background-color 0.3s ease;
    }

    .order-body {
        padding: 1.5rem;
    }

    /* Textos Adaptativos */
    .text-label {
        color: var(--text-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.2rem;
        display: block;
        transition: color 0.3s ease;
    }

    .text-value {
        color: var(--text-main);
        font-weight: 600;
        font-size: 1rem;
        margin: 0;
        transition: color 0.3s ease;
    }

    /* Badges de Estado Neón */
    .status-badge {
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.5em 1em;
        border-radius: 8px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .status-badge.completado {
            color: var(--neon-green);
            background-color: rgba(32, 201, 151, 0.1);
            border: 1px solid var(--neon-green);
        }

        .status-badge.pendiente {
            color: var(--neon-yellow);
            background-color: rgba(255, 204, 0, 0.1);
            border: 1px solid var(--neon-yellow);
        }

        .status-badge.cancelado {
            color: var(--neon-red);
            background-color: rgba(232, 62, 140, 0.1);
            border: 1px solid var(--neon-red);
        }

    /* Botones de Acción Cliente */
    .btn-customer {
        border-radius: 8px;
        font-weight: 600;
        padding: 0.6rem 1.2rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .btn-details {
        background-color: var(--neon-blue-tint);
        color: var(--neon-blue-base) !important;
        border: 1px solid rgba(0, 212, 255, 0.2);
    }

        .btn-details:hover {
            background-color: var(--neon-blue-base);
            color: #FFF !important;
            box-shadow: 0 0 15px var(--neon-blue-glow);
        }

    [data-bs-theme="dark"] .btn-details:hover, body.dark-theme .btn-details:hover {
        color: #000 !important;
    }

    /* Modal Inputs y Dropdowns adaptables */
    .dropdown-menu-custom {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

        .dropdown-menu-custom .dropdown-item {
            color: var(--text-main);
        }

            .dropdown-menu-custom .dropdown-item:hover {
                background-color: var(--bg-main);
                color: var(--neon-blue-base);
            }

        .dropdown-menu-custom .dropdown-divider {
            border-color: var(--border-color);
        }
</style>

<div class="container-fluid container-xl py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 m-0 fw-bold" style="color: var(--text-main);">
            <i class="bi bi-bag-check me-2" style="color: var(--neon-blue-base);"></i> Mis Pedidos
        </h2>

        <div class="dropdown">
            <button class="btn btn-customer dropdown-toggle" type="button" id="btnFiltrarPedidos" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main);">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
            <ul class="dropdown-menu dropdown-menu-custom dropdown-menu-end" aria-labelledby="btnFiltrarPedidos">
                <li><a class="dropdown-item btn-filtro" href="#" data-filtro="TODOS">Todos los pedidos</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item btn-filtro fw-bold" href="#" data-filtro="COMPLETADO" style="color: var(--neon-green);">Completados</a></li>
                <li><a class="dropdown-item btn-filtro fw-bold" href="#" data-filtro="PENDIENTE" style="color: var(--neon-yellow);">Pendientes</a></li>
                <li><a class="dropdown-item btn-filtro fw-bold" href="#" data-filtro="CANCELADO" style="color: var(--neon-red);">Cancelados</a></li>
            </ul>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                // Configuración de estado visual
                string estadoStr = item.ESTADO?.ToUpper() ?? "DESCONOCIDO";
                string claseBadge = estadoStr == "COMPLETADO" ? "completado" : estadoStr == "PENDIENTE" ? "pendiente" : "cancelado";
                string iconBadge = estadoStr == "COMPLETADO" ? "bi-check-circle" : estadoStr == "PENDIENTE" ? "bi-clock-history" : "bi-x-circle";

                <div class="col-12 tarjeta-pedido-wrapper" data-estado="@estadoStr">
                    <div class="customer-order-card">
                        <div class="order-header d-flex flex-column flex-md-row justify-content-between gap-3">
                            <div class="d-flex gap-4 flex-wrap">
                                <div>
                                    <span class="text-label">Fecha del Pedido</span>
                                    <p class="text-value">@item.FECHA_PEDIDO.ToString("dd 'de' MMM, yyyy")</p>
                                </div>
                                <div>
                                    <span class="text-label">Total Pagado</span>
                                    <p class="text-value" style="color: var(--neon-blue-base);">C$ @item.TOTAL.ToString("N2")</p>
                                </div>
                            </div>
                            <div class="text-md-end">
                                <span class="text-label">N° de Pedido</span>
                                <p class="text-value">#@item.ID_PEDIDO</p>
                            </div>
                        </div>

                        <div class="order-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
                            <div>
                                <span class="text-label mb-2">Estado Actual</span>
                                <div class="status-badge @claseBadge">
                                    <i class="bi @iconBadge"></i> @item.ESTADO
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 justify-content-end">
                                <a href="@Url.Action("Details", "Pedido", new { id = item.ID_PEDIDO })" class="btn btn-customer btn-details text-decoration-none">
                                    <i class="bi bi-box-seam"></i> Ver Detalles
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column justify-content-center align-items-center p-5 mt-4" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px;">
            <div class="mb-3">
                <i class="bi bi-bag-x" style="font-size: 3rem; color: var(--text-muted);"></i>
            </div>
            <h5 class="fw-bold" style="color: var(--text-main);">Aún no tienes compras</h5>
            <p style="color: var(--text-muted);">Tus pedidos aparecerán aquí una vez que finalices una compra.</p>
            <a href="@Url.Action("Index", "Tienda")" class="btn btn-customer btn-details mt-2 text-decoration-none">Ir a la tienda</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // --- LÓGICA DEL FILTRO ---
            const botonesFiltro = document.querySelectorAll('.btn-filtro');
            const tarjetas = document.querySelectorAll('.tarjeta-pedido-wrapper');

            botonesFiltro.forEach(boton => {
                boton.addEventListener('click', function (e) {
                    e.preventDefault();
                    const filtroSeleccionado = this.getAttribute('data-filtro');

                    tarjetas.forEach(tarjeta => {
                        if (filtroSeleccionado === "TODOS" || tarjeta.getAttribute('data-estado') === filtroSeleccionado) {
                            tarjeta.style.display = 'block';
                        } else {
                            tarjeta.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>
}