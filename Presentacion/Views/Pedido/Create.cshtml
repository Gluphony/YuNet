@model Entidades.Pedido

@{
    ViewData["Title"] = "Nuevo Pedido";
}

<style>
    /* ==========================================
           VARIABLES NEÓN
           ========================================== */
    :root {
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
        --neon-red: #ff3366;
    }

    /* ==========================================
           ESTILOS DEL FORMULARIO NEÓN
           ========================================== */
    .form-card {
        background-color: var(--bg-card) !important;
        border: 1px solid var(--border-color);
        border-top: 4px solid var(--neon-blue-base) !important;
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

        .form-card:hover {
            box-shadow: 0 10px 30px var(--neon-blue-glow);
            border-color: rgba(0, 212, 255, 0.3);
        }

    /* Botones Neón */
    .btn-neon {
        background: transparent;
        color: var(--neon-blue-base) !important;
        border: 1px solid var(--neon-blue-base);
        font-weight: 600;
        transition: all 0.3s ease;
        border-radius: 50px;
    }

        .btn-neon:hover {
            background: var(--neon-blue-base);
            color: #000 !important;
            box-shadow: 0 0 20px var(--neon-blue-glow);
            transform: translateY(-2px);
        }

    .btn-neon-outline {
        background: transparent;
        color: var(--text-main) !important;
        border: 1px solid var(--border-color);
        font-weight: 600;
        transition: all 0.3s ease;
        border-radius: 8px;
    }

        .btn-neon-outline:hover {
            border-color: var(--neon-blue-base);
            color: var(--neon-blue-base) !important;
            background-color: var(--neon-blue-tint);
            box-shadow: 0 0 15px var(--neon-blue-glow);
        }

    /* Inputs Iluminados */
    .custom-input-group {
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--border-color);
        transition: all 0.3s ease;
    }

        .custom-input-group:focus-within {
            border-color: var(--neon-blue-base);
            box-shadow: 0 0 15px var(--neon-blue-glow);
        }

        .custom-input-group .input-group-text {
            background-color: var(--bg-main);
            color: var(--neon-blue-base);
            border: none;
        }

        .custom-input-group .form-control,
        .custom-input-group .form-select {
            background-color: var(--bg-main);
            color: var(--text-main);
            border: none;
        }

            .custom-input-group .form-control:focus,
            .custom-input-group .form-select:focus {
                box-shadow: none;
                outline: none;
            }

    /* Opciones del Select */
    select option {
        background-color: var(--bg-card);
        color: var(--text-main);
    }
</style>

<div class="container-fluid container-xl py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <div class="premium-label mb-1" style="color: var(--neon-blue-base); font-size: 0.75rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;">Módulo de Ventas</div>
            <h2 class="h3 mb-0" style="color: var(--text-main); font-weight: 700;">Registrar Nuevo Pedido</h2>
            <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">Crea una orden asignándola a un cliente</p>
        </div>
        <a href="@Url.Action("Index", "Pedido")" class="btn btn-neon-outline px-4 py-2">
            <i class="bi bi-arrow-left me-2"></i> Volver al listado
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card form-card">
                <div class="card-header py-4 px-4" style="background-color: transparent; border-bottom: 1px solid var(--border-color);">
                    <h5 class="m-0 fw-bold d-flex align-items-center" style="color: var(--neon-blue-base);">
                        <i class="bi bi-bag-plus-fill me-3 fs-4"></i> Datos Básicos de la Orden
                    </h5>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert shadow-lg mb-4 d-flex align-items-center" style="background-color: var(--bg-card); color: var(--text-main); border: 1px solid var(--neon-red); border-left: 4px solid var(--neon-red); box-shadow: 0 0 15px rgba(255, 51, 102, 0.2); border-radius: 8px;">
                            <i class="bi bi-exclamation-triangle-fill fs-5 me-3" style="color: var(--neon-red);"></i>
                            <div>@ViewBag.Error</div>
                        </div>
                    }

                    <div asp-validation-summary="All" class="text-danger mb-4 fw-bold" style="font-size: 0.85rem; text-shadow: 0 0 5px rgba(220,53,69,0.5);"></div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-4 mb-5">
                            <div class="col-md-12">
                                <label class="form-label fw-bold mb-1" style="color: var(--text-main);">Cliente Asociado</label>
                                <p class="mb-2" style="font-size: 0.75rem; color: var(--text-muted);">Selecciona el cliente de la lista.</p>

                                <div class="input-group custom-input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person-badge"></i>
                                    </span>
                                    <select asp-for="ID_USUARIO" asp-items="ViewBag.ListaUsuarios" class="form-select" required>
                                        <option value="">-- Seleccione un Cliente --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold mb-1" style="color: var(--text-main);">Estado Inicial</label>
                                <div class="input-group custom-input-group mt-2">
                                    <span class="input-group-text">
                                        <i class="bi bi-flag"></i>
                                    </span>
                                    <select asp-for="ESTADO" class="form-select">
                                        <option value="Pendiente" selected>Pendiente (Por Cobrar/Entregar)</option>
                                        <option value="Completado">Completado (Pagado)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold mb-1" style="color: var(--text-main);">Total a Cobrar ($)</label>
                                <div class="input-group custom-input-group mt-2">
                                    <span class="input-group-text">
                                        <i class="bi bi-currency-dollar"></i>
                                    </span>
                                    <input type="number" step="0.01" min="0" asp-for="TOTAL" class="form-control" required placeholder="Ej. 150.50" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end border-top pt-4 mt-2" style="border-color: rgba(0, 212, 255, 0.2) !important;">
                            <button type="submit" class="btn btn-neon px-5 py-2 fs-5">
                                <i class="bi bi-check2-circle me-2"></i> Crear Pedido
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>