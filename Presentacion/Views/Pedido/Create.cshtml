@model Entidades.Pedido

@{
    ViewData["Title"] = "Nuevo Pedido";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0" style="color: var(--text-main); font-weight: 700;">Registrar Nuevo Pedido</h2>
        <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">Crea una orden asignándola a un cliente</p>
    </div>
    <a href="@Url.Action("Index", "Pedido")" class="btn border-0 shadow-sm" style="background-color: var(--bg-main); color: var(--text-main); border: 1px solid var(--border-color) !important; font-weight: 600; border-radius: 8px;">
        <i class="bi bi-arrow-left me-2"></i> Volver al listado
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm form-card" style="background-color: var(--bg-card); border-radius: 12px; border-top: 0.25rem solid #C6C3F2 !important; transition: 0.3s;">
            <div class="card-header py-3" style="background-color: transparent; border-bottom: 1px solid var(--border-color);">
                <h6 class="m-0 fw-bold" style="color: #C6C3F2;"><i class="bi bi-bag-plus me-2"></i>Datos Básicos de la Orden</h6>
            </div>

            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 8px;">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>
                        <div>@ViewBag.Error</div>
                    </div>
                }

                <div asp-validation-summary="All" class="text-danger mb-3" style="font-size: 0.85rem;"></div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-4 mb-4">

                        <div class="col-md-12">
                            <label class="form-label fw-bold mb-1" style="color: var(--text-main);">Cliente Asociado</label>
                            <p class="mb-2" style="font-size: 0.75rem; color: var(--text-muted);">Selecciona el cliente de la lista.</p>

                            <div class="input-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                <span class="input-group-text border-0" style="background-color: var(--bg-main); color: var(--text-muted);">
                                    <i class="bi bi-person-badge"></i>
                                </span>
                                <select asp-for="ID_USUARIO" asp-items="ViewBag.ListaUsuarios" class="form-select border-0" required style="background-color: var(--bg-main); color: var(--text-main);">
                                    <option value="">-- Seleccione un Cliente --</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold mb-1" style="color: var(--text-main);">Estado Inicial</label>
                            <div class="input-group">
                                <span class="input-group-text border-0" style="background-color: var(--bg-main); color: var(--text-muted);">
                                    <i class="bi bi-flag"></i>
                                </span>
                                <select asp-for="ESTADO" class="form-select border-0" style="background-color: var(--bg-main); color: var(--text-main);">
                                    <option value="Pendiente" selected>Pendiente (Por Cobrar/Entregar)</option>
                                    <option value="Completado">Completado (Pagado)</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold mb-1" style="color: var(--text-main);">Total a Cobrar ($)</label>
                            <div class="input-group">
                                <span class="input-group-text border-0" style="background-color: var(--bg-main); color: var(--text-muted);">
                                    <i class="bi bi-currency-dollar"></i>
                                </span>
                                <input type="number" step="0.01" min="0" asp-for="TOTAL" class="form-control border-0" required style="background-color: var(--bg-main); color: var(--text-main);" placeholder="Ej. 150.50" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end border-top pt-4" style="border-color: var(--border-color) !important;">
                        <button type="submit" class="btn border-0 shadow-sm px-5 py-2" style="background-color: #C6C3F2; color: #262628; font-weight: 600; border-radius: 8px; transition: 0.3s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
                            <i class="bi bi-check2-circle me-2"></i> Crear Pedido
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    select option {
        background-color: var(--bg-card);
        color: var(--text-main);
    }
</style>