@model List<Entidades.Devolucion>

@{
    ViewData["Title"] = "Gestión de Devoluciones";
}

<style>
    /* ==========================================
                   VARIABLES NEÓN (Heredadas del Home/Layout)
                   Dejamos que el Layout controle los fondos y textos (--bg-card, --text-main, etc.)
                ========================================== */
    :root {
        --neon-blue-base: #00D4FF;
        --neon-blue-glow: rgba(0, 212, 255, 0.4);
        --neon-blue-tint: rgba(0, 212, 255, 0.1);
        --neon-green: #00FF7F;
        --neon-red: #FF3366;
        --neon-yellow: #FFCC00;
        --neon-yellow-glow: rgba(255, 204, 0, 0.2);
    }

    /* ==========================================
                   ESTILOS DE COMPONENTES ADAPTATIVOS
                ========================================== */
    .dev-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }

    .dev-card-header {
        border-bottom: 2px solid var(--neon-blue-base);
        padding: 1rem 1.5rem;
        background-color: transparent;
    }

    /* Tabla Personalizada */
    .table-custom {
        margin-bottom: 0;
        --bs-table-bg: transparent;
    }

        .table-custom th {
            color: var(--text-muted);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--border-color);
            padding: 1rem 0.5rem;
            background-color: transparent;
        }

        .table-custom td {
            color: var(--text-main);
            vertical-align: middle;
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 0.5rem;
            background-color: transparent;
        }

        .table-custom tbody tr {
            transition: all 0.3s ease;
        }

            .table-custom tbody tr:hover td {
                background-color: var(--neon-blue-tint);
                box-shadow: inset 4px 0 0 var(--neon-blue-base);
            }

    /* IMEI Tag Especial */
    .imei-tag-danger {
        color: var(--neon-red);
        background-color: rgba(255, 51, 102, 0.1);
        border: 1px solid var(--neon-red);
        font-family: 'Courier New', Courier, monospace;
        font-weight: bold;
        font-size: 0.8rem;
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    /* Botones de acción */
    .btn-action {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: var(--bg-main);
        color: var(--neon-blue-base);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        transition: all 0.2s ease;
        text-decoration: none;
    }

        .btn-action:hover {
            background-color: var(--neon-blue-base);
            color: var(--bg-card);
            transform: translateY(-2px);
            box-shadow: 0 0 10px var(--neon-blue-glow);
        }

        /* Hover específicos para documentos */
        .btn-action.btn-doc-green:hover {
            background-color: var(--neon-green);
            color: #000;
            box-shadow: 0 0 10px rgba(0, 255, 127, 0.4);
            border-color: var(--neon-green);
        }

        .btn-action.btn-doc-yellow:hover {
            background-color: var(--neon-yellow);
            color: #000;
            box-shadow: 0 0 10px rgba(255, 204, 0, 0.4);
            border-color: var(--neon-yellow);
        }

        .btn-action.btn-doc-red:hover {
            background-color: var(--neon-red);
            color: #fff;
            box-shadow: 0 0 10px rgba(255, 51, 102, 0.4);
            border-color: var(--neon-red);
        }

    /* Badges de estado */
    .badge-pending {
        background-color: rgba(255, 204, 0, 0.1);
        color: var(--neon-yellow);
        border: 1px solid var(--neon-yellow);
        border-radius: 20px;
        padding: 6px 15px;
        font-weight: 600;
        font-size: 0.85rem;
        display: inline-block;
    }

    .badge-approved {
        background-color: rgba(0, 255, 127, 0.1);
        color: var(--neon-green);
        border: 1px solid var(--neon-green);
        border-radius: 20px;
        padding: 6px 15px;
        font-weight: 600;
        font-size: 0.85rem;
        display: inline-block;
    }

    .badge-rejected {
        background-color: rgba(255, 51, 102, 0.1);
        color: var(--neon-red);
        border: 1px solid var(--neon-red);
        border-radius: 20px;
        padding: 6px 15px;
        font-weight: 600;
        font-size: 0.85rem;
        display: inline-block;
    }

    /* Modal Inputs */
    .input-custom {
        background-color: var(--bg-main);
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: 8px;
    }

        .input-custom:focus {
            background-color: var(--bg-main);
            color: var(--text-main);
            border-color: var(--neon-blue-base);
            box-shadow: 0 0 0 4px var(--neon-blue-glow);
        }

        .input-custom option {
            background-color: var(--bg-card);
            color: var(--text-main);
        }

    .btn-save-modal {
        background-color: var(--neon-blue-base);
        color: #000;
        font-weight: bold;
        border: none;
        border-radius: 8px;
        padding: 8px 20px;
        transition: all 0.3s ease;
    }

        .btn-save-modal:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 15px var(--neon-blue-glow);
            color: #000;
        }

    .form-check-input:checked {
        background-color: var(--neon-blue-base);
        border-color: var(--neon-blue-base);
        box-shadow: 0 0 10px var(--neon-blue-glow);
    }

    .stock-panel {
        background-color: rgba(255, 204, 0, 0.05);
        border: 1px dashed rgba(255, 204, 0, 0.3);
        transition: all 0.3s ease;
        border-radius: 8px;
    }

        .stock-panel.active {
            border-style: solid;
            border-color: var(--neon-yellow);
            box-shadow: 0 0 15px var(--neon-yellow-glow);
        }
</style>

<div class="container-fluid px-lg-5 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
        <div>
            <h6 class="text-uppercase fw-bold mb-1" style="color: var(--neon-blue-base); letter-spacing: 1px; font-size: 0.85rem;">Módulo de Post-Venta</h6>
            <h2 class="fw-bold mb-1" style="color: var(--text-main);">Listado de Devoluciones</h2>
            <p class="mb-0" style="color: var(--text-muted);">Historial de dispositivos devueltos en el sistema</p>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center" style="background-color: rgba(0, 255, 127, 0.1); color: var(--neon-green); border: 1px solid var(--neon-green); border-radius: 12px;">
            <i class="bi bi-check-circle-fill fs-5 me-3"></i>
            <div>@TempData["MensajeExito"]</div>
        </div>
    }

    @if (ViewBag.Error != null || TempData["MensajeError"] != null)
    {
        <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center" style="background-color: rgba(255, 51, 102, 0.1); color: var(--neon-red); border: 1px solid var(--neon-red); border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>
            <div>@(ViewBag.Error ?? TempData["MensajeError"])</div>
        </div>
    }

    <div class="dev-card overflow-hidden">
        <div class="dev-card-header d-flex align-items-center">
            <i class="bi bi-arrow-repeat me-2 fs-5" style="color: var(--neon-blue-base);"></i>
            <span class="fw-bold" style="color: var(--neon-blue-base);">Registros de Devolución</span>
        </div>

        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Info. Devolución</th>
                        <th>Producto / IMEI Afectado</th>
                        <th>Motivo del Cliente</th>
                        <th class="text-center">Estado Reporte</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var dev in Model)
                        {
                            // ========================================================
                            // EXTRAER EL IMEI Y LIMPIAR EL TEXTO
                            // ========================================================
                            string imeiReportado = dev.IMEI ?? "";
                            string motivoLimpio = dev.MOTIVO_CLIENTE ?? "";
                            bool esImeiEspecifico = false;

                            if (motivoLimpio.StartsWith("[Unidad: "))
                            {
                                int finCorchete = motivoLimpio.IndexOf(']');
                                if (finCorchete > 0)
                                {
                                    imeiReportado = motivoLimpio.Substring(9, finCorchete - 9).Trim();
                                    motivoLimpio = motivoLimpio.Substring(finCorchete + 1).Trim();

                                    if (motivoLimpio.StartsWith("- "))
                                    {
                                        motivoLimpio = motivoLimpio.Substring(2).Trim();
                                    }
                                    esImeiEspecifico = true;
                                }
                            }

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold fs-6" style="color: var(--neon-blue-base);">#@dev.ID_DEVOLUCION</div>
                                    <div style="color: var(--text-muted); font-size: 0.85rem;">Doc: @dev.FACTURA_ORIGINAL</div>
                                    <div style="color: var(--text-muted); font-size: 0.85rem;">@dev.FECHA_DEVOLUCION.ToString("dd MMM, yyyy")</div>
                                </td>
                                <td>
                                    <div class="fw-bold mb-1" style="color: var(--text-main);">@dev.PRODUCTO_NOMBRE</div>

                                    @if (esImeiEspecifico || !imeiReportado.Contains(","))
                                    {
                                        <div class="imei-tag-danger">
                                            <i class="bi bi-upc-scan"></i> @imeiReportado
                                        </div>
                                    }
                                    else
                                    {
                                        var listaImeis = imeiReportado.Split(',');
                                        foreach (var imeiSuelto in listaImeis)
                                        {
                                            <span class="d-inline-block px-2 py-1 rounded me-1 mb-1" style="background-color: var(--bg-main); color: var(--text-main); border: 1px solid var(--border-color); font-size: 0.75rem;">@imeiSuelto</span>
                                        }
                                    }
                                </td>
                                <td>
                                    <div style="max-width: 300px; color: var(--text-main); font-size: 0.9rem; white-space: normal; word-break: break-word;">
                                        @motivoLimpio
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (dev.ESTADO_REPORTE == "Pendiente")
                                    {
                                        <span class="badge-pending"><i class="bi bi-hourglass-split me-1"></i> Pendiente</span>
                                    }
                                    else if (dev.ESTADO_REPORTE == "Aprobado")
                                    {
                                        <span class="badge-approved d-block mb-1"><i class="bi bi-check-lg me-1"></i> Aprobado</span>

                                        @if (!string.IsNullOrEmpty(dev.ACCION_TOMADA))
                                        {
                                            string badgeColor = dev.ACCION_TOMADA == "Garantia" ? "var(--neon-yellow)" :
                                            dev.ACCION_TOMADA == "Cambio Fisico" ? "var(--neon-green)" :
                                            "var(--neon-blue-base)";

                                            <span class="badge" style="background-color: var(--bg-main); color: @badgeColor; border: 1px dashed @badgeColor; font-size: 0.75rem; padding: 0.3em 0.6em;">
                                                @(dev.ACCION_TOMADA == "Garantia" ? "Servicio Técnico" : dev.ACCION_TOMADA)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge-rejected"><i class="bi bi-x-lg me-1"></i> Rechazado</span>
                                    }
                                </td>
                                <td class="text-end pe-4">

                                    @* 🔥 MAGIA DE LOS BOTONES DINÁMICOS 🔥 *@

                                    @if (dev.ESTADO_REPORTE == "Pendiente")
                                    {
                                        <button type="button" class="btn-action" onclick="abrirModalAdmin(@dev.ID_DEVOLUCION)" title="Procesar Reporte">
                                            <i class="bi bi-gear-fill"></i>
                                        </button>
                                    }
                                    else if (dev.ESTADO_REPORTE == "Aprobado")
                                    {
                                        string accion = dev.ACCION_TOMADA ?? "";

                                        if (accion == "Nota de Credito" || accion == "Reembolso")
                                        {
                                            <a href="@Url.Action("NotaCredito", "Devolucion", new { id = dev.ID_DEVOLUCION })" class="btn-action" title="Imprimir Nota de Crédito" style="color: var(--neon-blue-base);">
                                                <i class="bi bi-receipt"></i>
                                            </a>
                                        }
                                        else if (accion == "Cambio Fisico")
                                        {
                                            <a href="@Url.Action("CambioEquipo", "Devolucion", new { id = dev.ID_DEVOLUCION })" class="btn-action btn-doc-green" title="Gestionar Cambio de Equipo" style="color: var(--neon-green);">
                                                <i class="bi bi-phone-flip"></i>
                                            </a>
                                        }
                                        else if (accion == "Garantia")
                                        {
                                            <a href="@Url.Action("OrdenServicio", "Devolucion", new { id = dev.ID_DEVOLUCION })" class="btn-action btn-doc-yellow" title="Imprimir Orden de Servicio" style="color: var(--neon-yellow);">
                                                <i class="bi bi-tools"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Details", "Devolucion", new { id = dev.ID_DEVOLUCION })" class="btn-action" title="Ver Detalles">
                                                <i class="bi bi-search"></i>
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Details", "Devolucion", new { id = dev.ID_DEVOLUCION })" class="btn-action btn-doc-red" title="Ver Motivo de Rechazo" style="color: var(--neon-red);">
                                            <i class="bi bi-eye-slash"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="mb-3">
                                    <div class="icon-circle mx-auto" style="width: 80px; height: 80px; font-size: 2.5rem; color: var(--neon-blue-base); background-color: var(--neon-blue-tint); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-shield-check"></i>
                                    </div>
                                </div>
                                <h5 class="fw-bold" style="color: var(--text-main);">No hay devoluciones</h5>
                                <p style="color: var(--text-muted);">No se han registrado reportes de devolución todavía.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalProcesarAdmin" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">

            <div class="modal-header" style="border-bottom: 1px solid var(--border-color); padding: 1.25rem 1.5rem;">
                <h5 class="modal-title fw-bold d-flex align-items-center" style="color: var(--text-main);">
                    <i class="bi bi-gear-fill me-2" style="color: var(--neon-blue-base);"></i> Procesamiento de Retorno
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form action="@Url.Action("Procesar", "Devolucion")" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" id="adminIdDevolucion" name="ID_DEVOLUCION" />

                    <div class="row g-4">
                        <div class="col-12">
                            <label class="form-label fw-bold" style="color: var(--neon-blue-base); font-size: 0.9rem;">1. Decisión del Reporte</label>
                            <select class="form-select input-custom py-2" name="ESTADO_REPORTE" required>
                                <option value="">-- Selecciona una acción --</option>
                                <option value="Aprobado">Aprobar Devolución</option>
                                <option value="Rechazado">Rechazar Devolución</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="color: var(--neon-blue-base); font-size: 0.9rem;">2. Estado del Equipo Recibido</label>
                            <select class="form-select input-custom py-2" name="ESTADO_DISPOSITIVO_RECIBIDO" required>
                                <option value="">-- Seleccionar --</option>
                                <option value="Sellado de Fábrica">Sellado de Fábrica</option>
                                <option value="Abierto / Como Nuevo">Abierto / Como Nuevo</option>
                                <option value="Uso Leve / Sin Marcas">Uso Leve / Sin Marcas</option>
                                <option value="Dañado (No enciende)">Dañado (No enciende)</option>
                                <option value="Golpeado / Pantalla Rota">Golpeado / Pantalla Rota</option>
                                <option value="Piezas Faltantes / Incompleto">Piezas Faltantes / Incompleto</option>
                                <option value="Error de Inventario / Caja Vacía">Error de Inventario / Caja Vacía</option>
                                <option value="Falla Técnica Confirmada">Falla Técnica Confirmada</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="color: var(--neon-blue-base); font-size: 0.9rem;">3. Acción Tomada</label>
                            <select class="form-select input-custom py-2" name="ACCION_TOMADA" required>
                                <option value="">-- Seleccionar --</option>
                                <option value="Cambio Fisico">Cambio Físico</option>
                                <option value="Nota de Credito">Nota de Crédito</option>
                                <option value="Reembolso">Reembolso</option>
                                <option value="Garantia">Envío a Servicio Técnico</option>
                            </select>
                        </div>

                        <div class="col-12 mt-4">
                            <div id="panelStock" class="stock-panel p-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                                <div class="d-flex align-items-center">
                                    <div class="me-3 fs-3" id="stockIcon" style="color: var(--text-muted);">
                                        <i class="bi bi-box-arrow-in-down"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 fw-bold" style="color: var(--text-main);">Regresar a Inventario</h6>
                                        <p class="mb-0 small" style="color: var(--text-muted);">¿El equipo está apto para volver a venderse?</p>
                                    </div>
                                </div>
                                <div class="form-check form-switch fs-4 m-0">
                                    <input class="form-check-input" type="checkbox" role="switch" id="checkInventario" name="REGRESAR_INVENTARIO" value="true">
                                    <input type="hidden" name="REGRESAR_INVENTARIO" value="false">
                                </div>
                            </div>

                            <div id="stockWarning" class="alert mt-3 d-none mb-0" style="background: rgba(255, 204, 0, 0.1); border: 1px solid var(--neon-yellow); color: var(--neon-yellow); border-radius: 8px; font-size: 0.85rem;">
                                <i class="bi bi-cpu-fill me-2"></i> <strong>SISTEMA:</strong> Al aprobar, se ejecutará el Trigger para sumar existencias y liberar el IMEI.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer" style="border-top: 1px solid var(--border-color); padding: 1.25rem 1.5rem;">
                    <button type="button" class="btn" data-bs-dismiss="modal" style="color: var(--text-main); border: 1px solid var(--border-color); background-color: transparent;">Cancelar</button>
                    <button type="submit" class="btn btn-save-modal"><i class="bi bi-save me-2"></i>Guardar Decisión</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalAdmin(idDevolucion) {
            document.getElementById('adminIdDevolucion').value = idDevolucion;
            document.getElementById('checkInventario').checked = false;
            document.getElementById('stockWarning').classList.add('d-none');
            document.getElementById('panelStock').classList.remove('active');
            document.getElementById('stockIcon').style.color = "var(--text-muted)";

            var modal = new bootstrap.Modal(document.getElementById('modalProcesarAdmin'));
            modal.show();
        }

        document.getElementById('checkInventario').addEventListener('change', function () {
            const warning = document.getElementById('stockWarning');
            const panel = document.getElementById('panelStock');
            const icon = document.getElementById('stockIcon');

            if (this.checked) {
                warning.classList.remove('d-none');
                panel.classList.add('active');
                icon.style.color = "var(--neon-yellow)";
            } else {
                warning.classList.add('d-none');
                panel.classList.remove('active');
                icon.style.color = "var(--text-muted)";
            }
        });
    </script>
}