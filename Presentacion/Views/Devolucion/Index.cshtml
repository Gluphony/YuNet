@model List<Entidades.Devolucion>

@{
    ViewData["Title"] = "Gestión de Devoluciones";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0" style="color: var(--text-main); font-weight: 700;">Listado de Devoluciones</h2>
        <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">Historial de dispositivos devueltos en el sistema</p>
    </div>

    @if (User.IsInRole("Administrador") || User.IsInRole("Jefe de Almacen"))
    {
        <a href="@Url.Action("Create", "Devolucion")" class="btn border-0 shadow-sm d-flex align-items-center px-3 py-2" style="background-color: #C6C3F2; color: #262628; font-weight: 600; border-radius: 8px; transition: 0.3s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
            <i class="bi bi-arrow-return-left me-2"></i> Nueva Devolución
        </a>
    }
</div>

@if (ViewBag.Error != null)
{
    <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 8px;">
        <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>
        <div>@ViewBag.Error</div>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm mb-4" style="background-color: var(--bg-card); border-radius: 12px; transition: 0.3s; border-left: 0.25rem solid #C6C3F2 !important;">
            <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background-color: transparent; border-bottom: 1px solid var(--border-color);">
                <h6 class="m-0 fw-bold" style="color: #C6C3F2;"><i class="bi bi-arrow-repeat me-2"></i>Registros de Devolución</h6>
            </div>
            <div class="card-body p-4">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mt-2 mb-0" style="color: var(--text-main);">
                        <thead style="border-bottom: 2px solid var(--border-color);">
                            <tr>
                                <th scope="col" class="pb-3 text-uppercase border-0 rounded-start" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Info. Devolución</th>
                                <th scope="col" class="pb-3 text-uppercase border-0" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Producto / IMEI</th>
                                <th scope="col" class="pb-3 text-uppercase border-0" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Detalles</th>
                                <th scope="col" class="pb-3 text-uppercase border-0 text-center" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Estado Dispositivo</th>
                                <th scope="col" class="pb-3 text-uppercase border-0 text-center" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Reingreso Stock</th>
                                <th scope="col" class="pb-3 text-uppercase border-0 rounded-end text-end" style="font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.5px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody style="border-top: none;">
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var dev in Model)
                                {
                                    <tr style="border-bottom: 1px solid var(--border-color);">
                                        <td class="py-3">
                                            <div class="fw-bold" style="color: var(--text-main);">#@dev.ID_DEVOLUCION</div>
                                            <small class="text-muted">Factura: @dev.FACTURA_ORIGINAL</small><br />
                                            <small class="text-muted" style="font-size: 0.7rem;">@dev.FECHA_DEVOLUCION.ToString("dd/MM/yyyy")</small>
                                        </td>
                                        <td class="py-3">
                                            <div style="color: var(--text-main); font-weight: 500;">@dev.PRODUCTO_NOMBRE</div>
                                            <small style="color: #C6C3F2; font-size: 0.75rem;">IMEI: @dev.IMEI</small>
                                        </td>
                                        <td class="py-3">
                                            <div style="font-size: 0.85rem; max-width: 180px;" class="text-truncate" title="@dev.MOTIVO_CLIENTE">
                                                @dev.MOTIVO_CLIENTE
                                            </div>
                                            <small class="text-info" style="font-size: 0.75rem; font-weight: 500;">Acción: @dev.ACCION_TOMADA</small>
                                        </td>
                                        <td class="py-3 text-center">
                                            <span class="badge rounded-pill" style="background-color: var(--bg-main); color: var(--text-main); border: 1px solid var(--border-color); padding: 0.4em 0.8em; font-weight: 500;">
                                                @(string.IsNullOrEmpty(dev.ESTADO_DISPOSITIVO_RECIBIDO) ? "N/A" : dev.ESTADO_DISPOSITIVO_RECIBIDO)
                                            </span>
                                        </td>
                                        <td class="py-3 text-center">
                                            @if (dev.REGRESAR_INVENTARIO)
                                            {
                                                <span class="badge rounded-pill" style="background-color: rgba(25, 135, 84, 0.15); color: #20c997; border: 1px solid rgba(32, 201, 151, 0.5); padding: 0.4em 0.8em;">
                                                    <i class="bi bi-check-circle me-1"></i> Sí
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill" style="background-color: rgba(220, 53, 69, 0.15); color: #ff6b6b; border: 1px solid rgba(255, 107, 107, 0.5); padding: 0.4em 0.8em;">
                                                    <i class="bi bi-x-circle me-1"></i> No
                                                </span>
                                            }
                                        </td>
                                        <td class="py-3 text-end">
                                            <a href="@Url.Action("Details", "Devolucion", new { id = dev.ID_DEVOLUCION })" class="btn btn-sm btn-light rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center" title="Ver Detalles" style="width: 32px; height: 32px; background-color: var(--bg-main); color: var(--text-main); border-color: var(--border-color);">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <div class="d-flex flex-column align-items-center">
                                            <i class="bi bi-inbox fs-1 mb-3" style="color: var(--text-muted);"></i>
                                            <h5 style="color: var(--text-main);">No hay devoluciones registradas</h5>
                                            <p style="color: var(--text-muted);">El historial se encuentra vacío actualmente.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(198, 195, 242, 0.05) !important;
    }

    .table > :not(caption) > * > * {
        background-color: transparent !important;
        border-bottom-color: var(--border-color);
    }

    .text-truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>