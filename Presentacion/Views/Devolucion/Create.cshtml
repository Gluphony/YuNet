@model Entidades.Devolucion

@{
    ViewData["Title"] = "Registrar Devolución";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0" style="color: var(--text-main); font-weight: 700;">
            <i class="bi bi-arrow-return-left me-2" style="color: #dc3545;"></i>Registrar Devolución
        </h2>
        <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">
            Ingresa el motivo y estado del dispositivo recibido.
        </p>
    </div>
    <a href="@Url.Action("Index", "Pedido")" class="btn border-0 shadow-sm px-4" style="background-color: var(--bg-card); color: var(--text-main); font-weight: 600; border-radius: 8px; border: 1px solid var(--border-color) !important; transition: 0.3s;" onmouseover="this.style.backgroundColor='var(--bg-main)'" onmouseout="this.style.backgroundColor='var(--bg-card)'">
        <i class="bi bi-arrow-left me-2"></i> Cancelar
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm form-card" style="background-color: var(--bg-card); border-radius: 12px; border-top: 0.25rem solid #dc3545 !important; transition: 0.3s;">
            <div class="card-header py-3" style="background-color: transparent; border-bottom: 1px solid var(--border-color);">
                <h6 class="m-0 fw-bold" style="color: #dc3545;">
                    <i class="bi bi-file-earmark-text me-2"></i>Detalles de la Recepción
                </h6>
            </div>

            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 8px;">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>
                        <div>@ViewBag.Error</div>
                    </div>
                }

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="ID_DETALLE_DEVOLUCION" />

                    <div class="row g-4 mb-4">

                        <div class="col-md-12">
                            <label class="form-label fw-bold mb-1" style="color: var(--text-main);">ID Ref. Producto</label>
                            <div class="input-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                <span class="input-group-text border-0" style="background-color: var(--bg-main); color: var(--text-muted);">
                                    <i class="bi bi-hash"></i>
                                </span>
                                <input type="text" class="form-control border-0" value="@Model.ID_DETALLE_DEVOLUCION" disabled style="background-color: var(--bg-main); color: var(--text-muted);" />
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold mb-1" style="color: var(--text-main);">Motivo del Cliente <span class="text-danger">*</span></label>
                            <div class="input-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                <span class="input-group-text border-0" style="background-color: var(--bg-main); color: var(--text-muted);">
                                    <i class="bi bi-chat-left-text"></i>
                                </span>
                                <textarea asp-for="MOTIVO_CLIENTE" class="form-control border-0" rows="2" required style="background-color: var(--bg-main); color: var(--text-main);" placeholder="¿Por qué se devuelve el equipo?"></textarea>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold mb-1" style="color: var(--text-main);">Estado del Dispositivo <span class="text-danger">*</span></label>
                            <div class="input-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                <span class="input-group-text border-0" style="background-color: var(--bg-main); color: var(--text-muted);">
                                    <i class="bi bi-phone"></i>
                                </span>
                                <select asp-for="ESTADO_DISPOSITIVO_RECIBIDO" class="form-select border-0" required style="background-color: var(--bg-main); color: var(--text-main);">
                                    <option value="">-- Seleccione estado --</option>
                                    <option value="Nuevo/Sellado">Nuevo/Sellado</option>
                                    <option value="Abierto/Buen Estado">Abierto/Buen Estado</option>
                                    <option value="Dañado/Defectuoso">Dañado/Defectuoso</option>
                                    <option value="Incompleto">Incompleto</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold mb-1" style="color: var(--text-main);">Acción a Tomar <span class="text-danger">*</span></label>
                            <div class="input-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                <span class="input-group-text border-0" style="background-color: var(--bg-main); color: var(--text-muted);">
                                    <i class="bi bi-tools"></i>
                                </span>
                                <select asp-for="ACCION_TOMADA" class="form-select border-0" required style="background-color: var(--bg-main); color: var(--text-main);">
                                    <option value="">-- Seleccione acción --</option>
                                    <option value="Reembolso de Dinero">Reembolso de Dinero</option>
                                    <option value="Cambio de Equipo">Cambio de Equipo</option>
                                    <option value="Enviado a Garantía">Enviado a Garantía</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-12 mt-4">
                            <div class="form-check form-switch p-3 shadow-sm" style="background-color: var(--bg-main); border-radius: 8px; border: 1px solid var(--border-color);">
                                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" asp-for="REGRESAR_INVENTARIO" id="switchInventario" style="width: 2.5em; height: 1.25em; cursor: pointer;">
                                <label class="form-check-label fw-bold mb-0" for="switchInventario" style="color: var(--text-main); cursor: pointer; display: inline-block; transform: translateY(2px);">
                                    ¿Devolver este equipo al inventario disponible?
                                </label>
                                <p class="mb-0 ms-5 mt-1" style="font-size: 0.8rem; color: var(--text-muted);">Márcalo solo si el equipo está en condiciones para volver a venderse.</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end border-top pt-4" style="border-color: var(--border-color) !important;">
                        <button type="submit" class="btn border-0 shadow-sm px-5 py-2" style="background-color: #dc3545; color: white; font-weight: 600; border-radius: 8px; transition: 0.3s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
                            <i class="bi bi-check2-circle me-2"></i> Procesar Devolución
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    select option {
        background-color: var(--bg-card);
        color: var(--text-main);
    }
    /* Estilos para que el switch se vea rojo al activarse */
    .form-check-input:checked {
        background-color: #dc3545;
        border-color: #dc3545;
    }
</style>