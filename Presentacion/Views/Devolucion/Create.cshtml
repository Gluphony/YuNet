@model Entidades.Producto

@{
    ViewData["Title"] = "Registrar Producto";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="h3 mb-0" style="color: var(--text-main); font-weight: 700;">Nuevo Producto</h2>
                    <p class="mb-0" style="color: var(--text-muted); font-size: 0.9rem;">Ingrese las especificaciones técnicas y comerciales del equipo.</p>
                </div>
                <a href="@Url.Action("Index", "Producto")" class="btn btn-outline-secondary border-0 shadow-sm px-3">
                    <i class="bi bi-arrow-left me-2"></i> Volver al Catálogo
                </a>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert shadow-sm border-0 mb-4" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 8px;">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i> @ViewBag.Error
                </div>
            }

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="card border-0 shadow-sm mb-4" style="background-color: var(--bg-card); border-radius: 12px; border-left: 0.25rem solid #C6C3F2 !important;">
                    <div class="card-body p-4">

                        <h6 class="text-uppercase fw-bold mb-4" style="color: #C6C3F2; font-size: 0.8rem; letter-spacing: 1px;">
                            <i class="bi bi-tag me-2"></i> Clasificación y Modelo
                        </h6>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold" style="color: var(--text-muted);">Marca</label>
                                <select asp-for="ID_MARCA" class="form-select border-0 shadow-sm" style="background-color: var(--bg-main); color: var(--text-main);" asp-items="@ViewBag.Marcas" required>
                                    <option value="">-- Seleccione Marca --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold" style="color: var(--text-muted);">Categoría</label>
                                <select name="ID_CATEGORIA" class="form-select border-0 shadow-sm" style="background-color: var(--bg-main); color: var(--text-main);" asp-items="@ViewBag.Categorias">
                                    <option value="">-- Seleccione Categoría --</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label asp-for="MODELO" class="form-label small fw-bold" style="color: var(--text-muted);">Modelo del Dispositivo</label>
                                <input asp-for="MODELO" class="form-control border-0 shadow-sm py-2" style="background-color: var(--bg-main); color: var(--text-main);" placeholder="Ej: iPhone 15 Pro Max" required />
                            </div>
                        </div>

                        <h6 class="text-uppercase fw-bold mb-4" style="color: #C6C3F2; font-size: 0.8rem; letter-spacing: 1px;">
                            <i class="bi bi-cpu me-2"></i> Especificaciones Técnicas
                        </h6>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="DESCRIPCION" class="form-label small fw-bold" style="color: var(--text-muted);">Descripción General</label>
                                <textarea asp-for="DESCRIPCION" class="form-control border-0 shadow-sm" rows="2" style="background-color: var(--bg-main); color: var(--text-main);" placeholder="Breve resumen comercial..." required></textarea>
                            </div>
                            <div class="col-12">
                                <label asp-for="CARACTERISTICAS" class="form-label small fw-bold" style="color: var(--text-muted);">Ficha Técnica / Características</label>
                                <textarea asp-for="CARACTERISTICAS" class="form-control border-0 shadow-sm" rows="4" style="background-color: var(--bg-main); color: var(--text-main);" placeholder="Procesador, RAM, Almacenamiento, Cámara..." required></textarea>
                            </div>
                        </div>

                        <h6 class="text-uppercase fw-bold mb-4" style="color: #C6C3F2; font-size: 0.8rem; letter-spacing: 1px;">
                            <i class="bi bi-currency-dollar me-2"></i> Valores e Imagen
                        </h6>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="PRECIO" class="form-label small fw-bold" style="color: var(--text-muted);">Precio de Venta ($)</label>
                                <input asp-for="PRECIO" type="number" step="0.01" min="0" class="form-control border-0 shadow-sm" style="background-color: var(--bg-main); color: var(--text-main);" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="EXISTENCIAS" class="form-label small fw-bold" style="color: var(--text-muted);">Stock Inicial</label>
                                <input asp-for="EXISTENCIAS" type="number" min="0" class="form-control border-0 shadow-sm" style="background-color: var(--bg-main); color: var(--text-main);" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold" style="color: var(--text-muted);">Imagen del Equipo</label>
                                <input type="file" name="archivoImagen" id="inputImagen" class="form-control border-0 shadow-sm" style="background-color: var(--bg-main); color: var(--text-main);" accept="image/*" />
                            </div>

                            <div class="col-12 mt-3 d-none" id="previewContainer">
                                <div class="p-3 rounded-3 text-center" style="background-color: var(--bg-main); border: 1px dashed #C6C3F2;">
                                    <p class="small text-muted mb-2">Vista previa de la imagen:</p>
                                    <img id="imgPreview" src="#" alt="Preview" style="max-height: 150px; border-radius: 8px;" />
                                </div>
                            </div>
                        </div>

                        <div class="mt-5">
                            <button type="submit" class="btn w-100 py-2 shadow-sm border-0" style="background-color: #C6C3F2; color: #262628; font-weight: 700; border-radius: 8px;">
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i> GUARDAR PRODUCTO EN CATÁLOGO
                            </button>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Lógica para mostrar la preview de la imagen antes de subirla
        document.getElementById('inputImagen').addEventListener('change', function(e) {
            const reader = new FileReader();
            const preview = document.getElementById('imgPreview');
            const container = document.getElementById('previewContainer');

            reader.onload = function(e) {
                preview.src = e.target.result;
                container.classList.remove('d-none');
            }

            if(this.files[0]) {
                reader.readAsDataURL(this.files[0]);
            }
        });
    </script>
}