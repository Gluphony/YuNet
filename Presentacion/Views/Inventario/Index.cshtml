@model List<Entidades.Inventario>
@{
    ViewData["Title"] = "Movimientos de Inventario";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0"><i class="bi bi-journal-text me-2"></i>Kárdex de Inventario</h5>
        </div>
        <div class="card-body">

            <form method="get" action="@Url.Action("Index", "Inventario")" class="row g-3 mb-4">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Desde</label>
                    <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Hasta</label>
                    <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search"></i> Consultar
                    </button>
                    <a href="@Url.Action("Index", "Inventario")" class="btn btn-outline-secondary">
                        <i class="bi bi-eraser"></i> Limpiar
                    </a>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Fecha Movimiento</th>
                            <th>Tipo</th>
                            <th class="text-center">Cantidad</th>
                            <th>Motivo / Observación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ID_INVENTARIO</td>
                                    <td>@item.FECHA_MOVIMIENTO.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (item.TIPO_MOVIMIENTO == "ENTRADA")
                                        {
                                            <span class="badge bg-success">@item.TIPO_MOVIMIENTO</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@item.TIPO_MOVIMIENTO</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold">@item.CANTIDAD</td>
                                    <td class="text-muted">@(item.MOTIVO ?? "N/A")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No hay registros para mostrar en este criterio.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>