@model List<Entidades.Marca>
@{
    ViewData["Title"] = "Gestión de Marcas";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-tag-fill me-2"></i>Listado de Marcas</h5>
            <button class="btn btn-light btn-sm fw-bold" onclick="abrirModal(0, '')">
                <i class="bi bi-plus-circle me-1"></i> Nueva Marca
            </button>
        </div>
        <div class="card-body">

            <form method="get" class="row g-2 mb-4">
                <div class="col-auto">
                    <input type="text" name="nombre" class="form-control" placeholder="Buscar por nombre...">
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-secondary"><i class="bi bi-search"></i></button>
                </div>
            </form>

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nombre de Marca</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ID_MARCA</td>
                            <td class="fw-bold">@item.NOMBRE</td>
                            <td>
                                <span class="badge @(item.ESTADO ? "bg-success" : "bg-danger")">
                                    @(item.ESTADO ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-outline-primary btn-sm me-1"
                                        onclick="abrirModal(@item.ID_MARCA, '@item.NOMBRE')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm"
                                        onclick="desactivarMarca(@item.ID_MARCA)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalMarca" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("Guardar", "Marca")">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModal">Nueva Marca</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="ID_MARCA" id="txtIdMarca" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre</label>
                        <input type="text" name="NOMBRE" id="txtNombre" class="form-control" required maxlength="50" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModal(id, nombre) {
            document.getElementById("txtIdMarca").value = id;
            document.getElementById("txtNombre").value = nombre;
            document.getElementById("tituloModal").innerText = id === 0 ? "Nueva Marca" : "Editar Marca";
            new bootstrap.Modal(document.getElementById('modalMarca')).show();
        }

        function desactivarMarca(id) {
            if(confirm("¿Seguro que desea desactivar esta marca?")) {
                fetch('@Url.Action("Desactivar", "Marca")/' + id, { method: 'POST' })
                .then(() => location.reload());
            }
        }
    </script>
}